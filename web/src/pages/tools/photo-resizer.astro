      var blob = await compress(c, maxKb * 1024), kb = blob.size / 1024, warn = "";
      if (kb > maxKb) warn = "फोटो " + maxKb + " KB से छोटी नहीं हो पाई। चौड़ाई/ऊंचाई थोड़ी कम करके दोबारा कोशिश करें।";
      else if (kb < minKb) warn = "सबसे अच्छी क्वालिटी पर भी फोटो " + kb.toFixed(1) + " KB है, जो " + minKb + " KB से कम है। चौड़ाई/ऊंचाई (px) थोड़ी बढ़ाकर दोबारा बनाएं, या देखें कि अधिसूचना में कम से कम KB की शर्त है या नहीं।";
      var url = URL.createObjectURL(blob);
      $("prs-out").src = url; $("prs-dl").href = url;
      $("prs-kb").textContent = kb.toFixed(1) + " KB"; $("prs-dim").textContent = tw + " × " + th + " px";
      $("prs-warn").textContent = warn; $("prs-warn").hidden = !warn;
      res.hidden = false; res.scrollIntoView({ behavior: "smooth", block: "nearest" });
      try { if (window.gtag) gtag("event", "tool_usage", { tool: "photo_resizer", kb: Math.round(kb) }); } catch (e) {}
    } catch (e) { alert("फोटो बनाने में दिक्कत आई। दोबारा कोशिश करें।"); }
    btn.disabled = false; $("prs-wait").hidden = true;
  });
})();

---
// Exam photo resizer: crop (Cropper.js 1.6.1 from cdnjs, as on the old page),
// optional name + date-of-photo strip, then JPEG compression by binary search
// on quality to land inside the chosen KB range. Everything runs in the
// browser; the photo is never uploaded. Same URL, title and description.
//
// Changes from the old page: each preset now outputs its exact pixel size
// (old page only capped at 600 px), has a minimum KB as well as a maximum,
// and the page tells the user when the file cannot reach the minimum.
// Preset values are the commonly published ones; they vary by notification:
// - SSC: 3.5 x 4.5 cm, 20-50 KB; SSC forms now also take a live photo
//   (pw.live/ssc/exams/ssc-cgl-photo-and-signature-size-2026).
// - UPSC: 350x350 to 1000x1000 px, 20-300 KB, name + date of photo, not
//   older than 10 days (visionias.in UPSC photo rules 2026, pwonlyias.com).
// - IBPS: 200x230 px, 20-50 KB, plus live photo at application
//   (practicemock.com IBPS RRB photo size 2026).
// - RRB: live photo capture in recent CENs (oliveboard RRB NTPC guide).
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Faq from "../../components/Faq.astro";
import Explore from "../../components/Explore.astro";

const crumbs = [{ label: "होम", href: "/" }, { label: "टूल्स", href: "/tools/" }, { label: "फोटो रिसाइज़र" }];
const faq = [
  { q: "SSC और UPSC फॉर्म के लिए फोटो का साइज क्या है?", a: "आम तौर पर SSC में 3.5 x 4.5 cm की फोटो 20 से 50 KB में मांगी जाती है। UPSC में 350 x 350 से 1000 x 1000 पिक्सल की फोटो 20 से 300 KB में, नाम और फोटो खींचने की तारीख के साथ मांगी जाती है। हर भर्ती की अधिसूचना में दिया साइज ही अंतिम मानें।" },
  { q: "क्या मेरी फोटो किसी सर्वर पर जाती है?", a: "नहीं। फोटो काटना, नाम-तारीख लगाना और छोटा करना सब आपके फोन या कंप्यूटर के ब्राउज़र में होता है। फोटो कहीं अपलोड नहीं होती।" },
  { q: "फोटो पर नाम और तारीख (DOP) कैसे लगाएं?", a: "'नाम और फोटो की तारीख जोड़ें' पर टिक करें, नाम और फोटो खींचने की तारीख भरें। टूल फोटो के नीचे सफेद पट्टी पर काले अक्षरों में नाम और DOP लिख देगा।" },
  { q: "लाइव फोटो (Live Photo) क्या है?", a: "SSC, IBPS और रेलवे जैसी कई भर्तियों में अब फॉर्म भरते समय वेबकैम या मोबाइल कैमरे से उसी समय फोटो खींची जाती है। वह फोटो पोर्टल पर ही खिंचती है, उसे यह टूल नहीं बनाता। स्कैन फोटो अलग से मांगी जाए तो इस टूल से तैयार करें।" },
  { q: "क्या चश्मा या टोपी पहनकर फोटो दे सकते हैं?", a: "ज़्यादातर भर्तियां टोपी, काला चश्मा और चेहरा ढकने वाली चीज़ों वाली फोटो नहीं मानतीं। कुछ अधिसूचनाएं सामान्य चश्मा भी मना करती हैं। बेहतर है बिना चश्मे के सफेद या हल्के बैकग्राउंड पर फोटो खिंचवाएं।" },
];
---
<Base title="Govt Exam Photo Resizer 2026 | SarkariSewa India" description="SSC, UPSC, रेलवे, पुलिस व बैंकिंग फॉर्म हेतु पासपोर्ट फोटो को 20KB से 50KB में रिसाइज, क्रॉप व नेम-डेट स्टैम्प जोड़ें। 100% फ्री और सुरक्षित।" breadcrumbs={crumbs} faq={faq}>
  <link slot="head" rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css" />
  <Breadcrumbs items={crumbs} />
  <article class="page">
    <div>
      <h1>सरकारी परीक्षा फोटो रिसाइज़र (20KB - 50KB) + नाम और तारीख</h1>
      <section class="answer" aria-labelledby="answer-title">
        <p class="answer-title" id="answer-title">सीधा जवाब</p>
        <p class="answer-lead">फोटो चुनें, परीक्षा का प्रीसेट चुनें, फोटो काटें और "फोटो तैयार करें" दबाएं। टूल फोटो को सही नाप और KB सीमा (जैसे 20-50 KB) में बदल देगा, चाहें तो नीचे नाम और फोटो की तारीख भी लिख देगा। फोटो आपके ब्राउज़र में ही बनती है, कहीं अपलोड नहीं होती।</p>
      </section>

      <section class="section prs" aria-labelledby="prs-title">
        <h2 id="prs-title">📸 फोटो तैयार करें</h2>
        <p class="prs-safe">🔒 फोटो आपके फोन/कंप्यूटर में ही प्रोसेस होती है, किसी सर्वर पर नहीं जाती।</p>

        <label class="prs-drop" id="prs-drop" for="prs-file">
          <span class="prs-drop-ico" aria-hidden="true">🖼️</span>
          <strong>फोटो चुनें या यहां खींचकर छोड़ें</strong>
          <span class="muted">JPG, PNG, WebP</span>
        </label>
        <input type="file" id="prs-file" accept="image/jpeg,image/png,image/webp" class="sr-only" />

        <div class="prs-work" id="prs-work" hidden>
          <div class="prs-crop"><img id="prs-img" alt="काटने के लिए चुनी गई फोटो" /></div>
          <div class="prs-tools">
            <button type="button" class="chip-btn" id="prs-rl">⟲ बाएं घुमाएं</button>
            <button type="button" class="chip-btn" id="prs-rr">⟳ दाएं घुमाएं</button>
            <button type="button" class="chip-btn" id="prs-flip">↔ पलटें</button>
            <button type="button" class="chip-btn" id="prs-change">✕ फोटो बदलें</button>
          </div>

          <fieldset class="prs-set">
            <legend>परीक्षा प्रीसेट</legend>
            <div class="prs-chips" id="prs-presets">
              <button type="button" class="chip-btn on" data-w="350" data-h="450" data-min="20" data-max="50">SSC / रेलवे (3.5×4.5 cm)</button>
              <button type="button" class="chip-btn" data-w="400" data-h="400" data-min="20" data-max="300">UPSC (1:1)</button>
              <button type="button" class="chip-btn" data-w="200" data-h="230" data-min="20" data-max="50">IBPS / बैंक (200×230)</button>
              <button type="button" class="chip-btn" data-w="300" data-h="400" data-min="20" data-max="50">राज्य PSC / पुलिस (3:4)</button>
              <button type="button" class="chip-btn" data-w="0" data-h="0" data-min="10" data-max="100">अपना नाप</button>
            </div>
            <div class="prs-grid">
              <div><label for="prs-w">चौड़ाई (px)</label><input type="number" id="prs-w" min="50" max="2000" inputmode="numeric" value="350" /></div>
              <div><label for="prs-h">ऊंचाई (px)</label><input type="number" id="prs-h" min="50" max="2000" inputmode="numeric" value="450" /></div>
              <div><label for="prs-min">कम से कम KB</label><input type="number" id="prs-min" min="1" max="500" inputmode="numeric" value="20" /></div>
              <div><label for="prs-max">ज़्यादा से ज़्यादा KB</label><input type="number" id="prs-max" min="5" max="1000" inputmode="numeric" value="50" /></div>
            </div>
            <p class="muted">"अपना नाप" में चौड़ाई/ऊंचाई खाली (0) रखें तो फोटो जितनी काटी है उसी अनुपात में बनेगी (लंबी तरफ अधिकतम 600 px)।</p>
          </fieldset>

          <fieldset class="prs-set">
            <legend><label class="prs-check"><input type="checkbox" id="prs-stamp" /> नाम और फोटो की तारीख (DOP) जोड़ें</label></legend>
            <div class="prs-grid" id="prs-stamp-box" hidden>
              <div><label for="prs-name">उम्मीदवार का नाम</label><input type="text" id="prs-name" placeholder="जैसे RAHUL KUMAR" autocomplete="name" /></div>
              <div><label for="prs-date">फोटो खींचने की तारीख</label><input type="date" id="prs-date" /></div>
            </div>
          </fieldset>

          <button type="button" class="cta prs-go" id="prs-go">✂️ फोटो तैयार करें</button>
          <p class="muted" id="prs-wait" hidden>⏳ फोटो बन रही है...</p>
        </div>

        <div class="prs-result" id="prs-result" hidden aria-live="polite">
          <h3>✅ आपकी फोटो तैयार है</h3>
          <img id="prs-out" alt="तैयार फोटो" />
          <p class="prs-stats"><span id="prs-kb">-- KB</span> <span id="prs-dim">-- px</span></p>
          <p class="notice" id="prs-warn" hidden></p>
          <a class="cta" id="prs-dl" download="sarkarisewa_photo.jpg" href="#">⬇️ फोटो डाउनलोड करें</a>
        </div>
      </section>

      <section class="section" id="kaise">
        <h2>कैसे इस्तेमाल करें</h2>
        <ol class="steps">
          <li><strong>फोटो चुनें:</strong> साफ, सीधे सामने से खिंची फोटो, सफेद या हल्का बैकग्राउंड।</li>
          <li><strong>प्रीसेट चुनें:</strong> अपनी परीक्षा का बटन दबाएं, या अधिसूचना के हिसाब से नाप और KB खुद भरें।</li>
          <li><strong>फोटो काटें:</strong> डिब्बे को खिसकाकर चेहरा बीच में रखें। फोटो उल्टी हो तो घुमाएं।</li>
          <li><strong>नाम-तारीख (ज़रूरत हो तो):</strong> UPSC, NTA जैसी परीक्षाओं में फोटो के नीचे नाम और तारीख मांगी जाती है।</li>
          <li><strong>डाउनलोड करें</strong> और फॉर्म में अपलोड करें।</li>
        </ol>
      </section>

      <section class="section" id="niyam">
        <h2>आम तौर पर मांगा जाने वाला नाप</h2>
        <div class="table-wrap">
          <table>
            <thead><tr><th>भर्ती</th><th>नाप</th><th>साइज</th><th>खास बात</th></tr></thead>
            <tbody>
              <tr><td>SSC</td><td>3.5 × 4.5 cm</td><td>20-50 KB</td><td>फॉर्म में लाइव फोटो भी खींची जाती है</td></tr>
              <tr><td>UPSC</td><td>350×350 से 1000×1000 px</td><td>20-300 KB</td><td>नाम और फोटो की तारीख; फोटो 10 दिन से पुरानी नहीं; चेहरा लगभग 3/4 भाग में</td></tr>
              <tr><td>IBPS / बैंक</td><td>200 × 230 px</td><td>20-50 KB</td><td>लाइव फोटो भी ज़रूरी</td></tr>
              <tr><td>रेलवे (RRB)</td><td>अधिसूचना देखें</td><td>अधिसूचना देखें</td><td>हाल की भर्तियों में लाइव फोटो</td></tr>
            </tbody>
          </table>
        </div>
        <p class="muted">ये आम तौर पर दिए जाने वाले नाप हैं। हर भर्ती की अधिसूचना अलग हो सकती है, वही अंतिम मानें।</p>
      </section>

      <section class="section" id="dhyan">
        <h2>ध्यान दें</h2>
        <ul class="checklist">
          <li>चेहरा सीधा, दोनों कान और आंखें साफ दिखें; टोपी, काला चश्मा, मास्क न हो।</li>
          <li>सेल्फी की जगह किसी और से 1-2 मीटर दूर से फोटो खिंचवाएं, ताकि चेहरा बिगड़ा न दिखे।</li>
          <li>बहुत कम KB (जैसे 10 KB से कम) करने पर फोटो धुंधली हो सकती है।</li>
          <li>हस्ताक्षर के लिए <a href="/tools/signature-resizer.html">सिग्नेचर रिसाइज़र</a> और दस्तावेज़ के लिए <a href="/tools/document-compressor.html">डॉक्यूमेंट कंप्रेसर</a> इस्तेमाल करें।</li>
        </ul>
      </section>

      <Faq items={faq} />
      <Explore />
    </div>
  </article>
</Base>

<style is:global>
.prs .prs-safe { font-weight: 700; color: var(--c-green); background: var(--c-green-50); border-radius: 10px; padding: 8px 12px; font-size: .92rem; }
.prs .prs-drop { display: flex; flex-direction: column; align-items: center; gap: 4px; text-align: center; padding: 28px 14px; border: 2px dashed var(--c-brand-100); border-radius: 14px; background: var(--c-brand-50); cursor: pointer; }
.prs .prs-drop.over { border-color: var(--c-brand); }
.prs .prs-drop-ico { font-size: 2.4rem; }
.prs .prs-crop { max-height: 420px; background: var(--c-surface-2); border-radius: 10px; overflow: hidden; }
.prs .prs-crop img { display: block; max-width: 100%; }
.prs .prs-tools, .prs .prs-chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 12px 0; }
.prs .chip-btn.on { background: var(--c-brand); color: #fff; border-color: var(--c-brand); }
.prs .prs-set { border: 1px solid var(--c-line); border-radius: 12px; padding: 10px 14px; margin: 0 0 12px; min-width: 0; }
.prs .prs-set legend { font-weight: 800; padding: 0 6px; }
.prs .prs-check { display: flex; gap: 8px; align-items: center; cursor: pointer; }
.prs .prs-check input { width: 18px; height: 18px; }
.prs .prs-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px 12px; }
.prs .prs-grid label { display: block; font-weight: 700; font-size: .85rem; margin-bottom: 3px; }
.prs .prs-grid input { width: 100%; min-height: 44px; padding: 8px 10px; border: 1px solid var(--c-line); border-radius: 8px; font: inherit; background: var(--c-surface); color: var(--c-text); box-sizing: border-box; }
.prs .muted { color: var(--c-muted); font-size: .88rem; }
.prs .cta { border: 0; cursor: pointer; font: inherit; font-weight: 800; }
.prs .prs-go { width: 100%; justify-content: center; }
.prs .prs-result { margin-top: 16px; text-align: center; border: 1px solid var(--c-line); border-radius: 12px; padding: 14px; }
.prs .prs-result h3 { margin-top: 0; }
.prs .prs-result img { max-width: 100%; max-height: 300px; border: 1px solid var(--c-line); }
.prs .prs-stats span { display: inline-block; font-weight: 800; padding: 4px 10px; border-radius: 999px; background: var(--c-green-50); color: var(--c-green); margin: 4px; }
.prs .prs-result .notice { text-align: left; }
</style>

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js"></script>
<script is:inline>
(function () {
  var $ = function (id) { return document.getElementById(id); };
  var drop = $("prs-drop"), file = $("prs-file"), work = $("prs-work"), img = $("prs-img"), res = $("prs-result");
  var cropper = null, flipped = false, preset = { w: 350, h: 450 };
  function ratio() { var w = +$("prs-w").value, h = +$("prs-h").value; return w > 0 && h > 0 ? w / h : NaN; }
  function load(f) {
    if (!f || !/^image\//.test(f.type)) { alert("कृपया JPG, PNG या WebP फोटो चुनें।"); return; }
    var url = URL.createObjectURL(f);
    if (cropper) { cropper.destroy(); cropper = null; }
    img.onload = function () {
      if (typeof Cropper === "undefined") { alert("क्रॉप टूल लोड नहीं हुआ। इंटरनेट जांचकर पेज दोबारा खोलें।"); return; }
      cropper = new Cropper(img, { viewMode: 1, aspectRatio: ratio(), autoCropArea: 0.85, background: false, toggleDragModeOnDblclick: false });
    };
    img.src = url; drop.hidden = true; work.hidden = false; res.hidden = true; flipped = false;
  }
  file.addEventListener("change", function () { if (file.files[0]) load(file.files[0]); });
  ["dragover", "dragenter"].forEach(function (e) { drop.addEventListener(e, function (ev) { ev.preventDefault(); drop.classList.add("over"); }); });
  drop.addEventListener("dragleave", function () { drop.classList.remove("over"); });
  drop.addEventListener("drop", function (ev) { ev.preventDefault(); drop.classList.remove("over"); if (ev.dataTransfer.files[0]) load(ev.dataTransfer.files[0]); });
  $("prs-rl").onclick = function () { cropper && cropper.rotate(-90); };
  $("prs-rr").onclick = function () { cropper && cropper.rotate(90); };
  $("prs-flip").onclick = function () { if (cropper) { flipped = !flipped; cropper.scaleX(flipped ? -1 : 1); } };
  $("prs-change").onclick = function () { if (cropper) { cropper.destroy(); cropper = null; } file.value = ""; drop.hidden = false; work.hidden = true; res.hidden = true; };
  document.querySelectorAll("#prs-presets .chip-btn").forEach(function (b) {
    b.onclick = function () {
      document.querySelectorAll("#prs-presets .chip-btn").forEach(function (x) { x.classList.remove("on"); });
      b.classList.add("on");
      $("prs-w").value = b.dataset.w; $("prs-h").value = b.dataset.h; $("prs-min").value = b.dataset.min; $("prs-max").value = b.dataset.max;
      if (cropper) cropper.setAspectRatio(ratio());
    };
  });
  ["prs-w", "prs-h"].forEach(function (id) { $(id).addEventListener("change", function () { if (cropper) cropper.setAspectRatio(ratio()); }); });
  $("prs-stamp").addEventListener("change", function () {
    $("prs-stamp-box").hidden = !this.checked;
    if (this.checked && !$("prs-date").value) $("prs-date").valueAsDate = new Date();
  });
  function toBlob(c, q) { return new Promise(function (r) { c.toBlob(r, "image/jpeg", q); }); }
  // Highest JPEG quality whose size is <= maxBytes (binary search, 9 steps).
  async function compress(c, maxBytes) {
    var lo = 0.05, hi = 0.95, best = null, top = await toBlob(c, hi);
    if (top.size <= maxBytes) return top;
    for (var i = 0; i < 9; i++) {
      var q = (lo + hi) / 2, b = await toBlob(c, q);
      if (b.size <= maxBytes) { best = b; lo = q; } else hi = q;
    }
    return best || toBlob(c, 0.05);
  }
  function stamp(c) {
    var name = $("prs-name").value.trim().toUpperCase(), d = $("prs-date").value;
    var ds = d ? "DOP: " + d.split("-").reverse().join("/") : "";
    if (!name && !ds) return;
    var x = c.getContext("2d"), w = c.width, h = c.height, sh = Math.round(h * 0.18);
    x.fillStyle = "#fff"; x.fillRect(0, h - sh, w, sh);
    x.fillStyle = "#000"; x.fillRect(0, h - sh, w, Math.max(1, Math.round(sh * 0.03)));
    x.textAlign = "center"; x.textBaseline = "middle";
    var lines = [name, ds].filter(Boolean), fs = Math.floor(sh / (lines.length === 2 ? 2.7 : 2));
    x.font = "bold " + fs + "px Arial, sans-serif";
    while (fs > 8 && lines.some(function (l) { return x.measureText(l).width > w * 0.94; })) { fs--; x.font = "bold " + fs + "px Arial, sans-serif"; }
    lines.forEach(function (l, i) { x.fillText(l, w / 2, h - sh + sh * (lines.length === 2 ? (i ? 0.72 : 0.32) : 0.52)); });
  }
  $("prs-go").addEventListener("click", async function () {
    if (!cropper) return;
    var btn = this; btn.disabled = true; $("prs-wait").hidden = false;
    try {
      var tw = +$("prs-w").value, th = +$("prs-h").value, src = cropper.getCroppedCanvas({ fillColor: "#fff", imageSmoothingQuality: "high" });
      if (!(tw > 0 && th > 0)) { var s = Math.min(1, 600 / Math.max(src.width, src.height)); tw = Math.round(src.width * s); th = Math.round(src.height * s); }
      var c = document.createElement("canvas"); c.width = tw; c.height = th;
      var cx = c.getContext("2d"); cx.fillStyle = "#fff"; cx.fillRect(0, 0, tw, th); cx.imageSmoothingQuality = "high"; cx.drawImage(src, 0, 0, tw, th);
      if ($("prs-stamp").checked) stamp(c);

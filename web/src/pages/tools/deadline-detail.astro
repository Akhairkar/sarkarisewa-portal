---
// Detail page for one deadline: /tools/deadline-detail.html?slug=...
// Same URL, title and description as the old page. Content comes live from
// the Supabase "deadlines" table (published rows only; RLS) through
// /assets/js/deadline-detail.js, loaded unchanged. That script fills the
// elements with ids breadcrumb, dl-post-loading, dl-post-draft-slot,
// dl-post-hero, dl-post-body and dl-post-related, and sets the per-deadline
// title, description, canonical (?slug=...) and schema. It needs
// getLang()/t()/onLangChange()/renderShareRow() from /assets/js/i18n-helper.js
// and getSupabaseClient() from /assets/js/supabase-client.js; both are
// self-contained and loaded here. The old FAQ ("enter details and press
// Calculate", "follows 2026 government slabs") described a calculator this
// page is not, so it was replaced.
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Faq from "../../components/Faq.astro";
import Explore from "../../components/Explore.astro";

const crumbs = [{ label: "होम", href: "/" }, { label: "टूल्स", href: "/tools/" }, { label: "डेडलाइन कैलेंडर", href: "/tools/deadline-calendar.html" }, { label: "डेडलाइन विवरण" }];
const faq = [
  { q: "इस पेज पर दी तारीख कितनी भरोसेमंद है?", a: "हर डेडलाइन official अधिसूचना या पोर्टल देखकर जोड़ी जाती है और ऊपर 'अंतिम सत्यापन' की तारीख व स्रोत लिखा होता है। सरकार तारीख बदल सकती है, इसलिए फॉर्म भरने से पहले official पोर्टल पर तारीख ज़रूर देख लें।" },
  { q: "आवेदन कहां करें?", a: "ऊपर दिए 'आधिकारिक पोर्टल' बटन से सरकारी वेबसाइट पर जाएं। SarkariSewa India कोई आवेदन नहीं लेती और न ही फीस लेती है।" },
  { q: "'दिन बचे' कैसे गिना जाता है?", a: "आपके फोन या कंप्यूटर की आज की तारीख और आखिरी तारीख के बीच के दिन अपने-आप गिने जाते हैं।" },
];
---
<Base title="Application Deadline & Key Dates Tracker 2026 | SarkariSewa" description="Check complete application schedule, important registration dates, fee deadlines, and direct official apply links." breadcrumbs={crumbs} faq={faq}>
  <Breadcrumbs items={crumbs} />
  <article class="page">
    <div>
      <nav id="breadcrumb" hidden aria-hidden="true"></nav>
      <section class="section dd-tool" id="dl-post-article">
        <p class="dd-loading" id="dl-post-loading">डेडलाइन की जानकारी लोड हो रही है…</p>
        <div id="dl-post-draft-slot"></div>
        <header class="job-post-hero" id="dl-post-hero" hidden><h1>डेडलाइन विवरण</h1></header>
        <div class="job-post-body" id="dl-post-body" hidden></div>
        <section class="job-post-related" id="dl-post-related" hidden></section>
        <p class="notice">SarkariSewa India एक निजी जानकारी वेबसाइट है, किसी सरकारी विभाग से जुड़ी नहीं। ज़रूरी तारीखें हमेशा official अधिसूचना या पोर्टल से पक्की करें।</p>
        <a class="cta secondary" href="/tools/deadline-calendar.html">← सभी डेडलाइन (कैलेंडर)</a>
      </section>

      <Faq items={faq} />
      <Explore />
    </div>
  </article>
</Base>

<style is:global>
.dd-tool .dd-loading { color: var(--c-muted); font-weight: 600; }
.dd-tool .job-post-hero__badges { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 6px; }
.dd-tool .job-badge, .dd-tool .dl-badge { font-size: .75rem; font-weight: 800; padding: 2px 9px; border-radius: 999px; background: var(--c-brand-50); color: var(--c-brand); }
.dd-tool .dl-badge--closing-today, .dd-tool .dl-badge--closing-tomorrow, .dd-tool .dl-badge--urgent { background: var(--c-red-50); color: var(--c-red); }
.dd-tool .dl-badge--week { background: var(--c-saffron-50); color: var(--c-saffron-700); }
.dd-tool .dl-badge--expired { background: var(--c-surface-2); color: var(--c-muted); }
.dd-tool .job-post-hero__title { margin: 4px 0 8px; overflow-wrap: anywhere; }
.dd-tool .job-post-hero__meta { display: grid; gap: 2px; font-size: .95rem; }
.dd-tool .job-post-hero__actions { margin: 12px 0 6px; }
.dd-tool .job-post-hero__actions .btn { display: block; text-align: center; padding: 12px 16px; border-radius: 12px; background: var(--c-saffron); color: #1f1300; font-weight: 800; text-decoration: none; }
.dd-tool .job-post-share-row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 8px 0 4px; }
.dd-tool .job-post-share-icon { display: inline-grid; place-items: center; width: 40px; height: 40px; border-radius: 10px; border: 1px solid var(--c-line); background: var(--c-surface); color: var(--c-text); cursor: pointer; }
.dd-tool .job-post-share-copied { color: var(--c-green); font-weight: 700; font-size: .85rem; }
.dd-tool .job-post-section { border-top: 1px solid var(--c-line); padding-top: 12px; margin-top: 12px; }
.dd-tool .job-post-section h2 { font-size: 1.1rem; margin: 0 0 6px; }
.dd-tool .job-post-section__body { overflow-wrap: anywhere; }
.dd-tool .job-empty { color: var(--c-muted); }
.dd-tool .job-post-draft-banner { background: var(--c-saffron-50); color: var(--c-saffron-700); font-weight: 700; padding: 8px 12px; border-radius: 10px; margin-bottom: 10px; }
.dd-tool .dl-related-block { margin-top: 16px; }
.dd-tool .dl-related-block h3 { font-size: 1rem; margin: 0 0 8px; }
.dd-tool .dl-related-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 8px; }
@media (min-width: 640px) { .dd-tool .dl-related-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
.dd-tool .dl-related-card { display: flex; gap: 10px; align-items: center; padding: 10px 12px; border: 1px solid var(--c-line); border-radius: 10px; text-decoration: none; color: var(--c-ink); min-width: 0; overflow-wrap: anywhere; }
.dd-tool .dl-related-card:hover { border-color: var(--c-brand); }
.dd-tool .dl-related-card span:not(.dl-related-card__icon) { display: block; font-size: .82rem; color: var(--c-muted); }
.dd-tool .dl-related-card__icon { font-size: 1.3rem; flex-shrink: 0; }
</style>

<script is:inline>window.SS_ROOT = "/"; window.SITE = window.SITE || { lang: "hi" };</script>
<script is:inline src="/assets/js/supabase-client.js"></script>
<script is:inline src="/assets/js/i18n-helper.js"></script>
<script is:inline src="/assets/js/deadline-detail.js"></script>

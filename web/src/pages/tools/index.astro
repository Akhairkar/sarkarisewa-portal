---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import CardGrid from "../../components/CardGrid.astro";
import Faq from "../../components/Faq.astro";
import Explore from "../../components/Explore.astro";
import { exists } from "../../lib/repo";

const T = (href: string, emoji: string, title: string, text: string) => ({ href, emoji, title, text });
const groups = [
  { id: "forms", title: "फॉर्म भरने के टूल्स", cards: [
    T("/tools/photo-resizer.html", "🖼️", "Photo Resizer", "फोटो को फॉर्म के KB/size में"),
    T("/tools/signature-resizer.html", "✍️", "Signature Resizer", "सिग्नेचर सही साइज़ में"),
    T("/tools/document-compressor.html", "🗜️", "Document Compressor", "PDF/फोटो छोटा करें"),
    T("/tools/self-declaration-builder.html", "📝", "Self Declaration Builder", "स्व-घोषणा पत्र तैयार करें"),
    T("/tools/document-checklist.html", "📋", "Document Checklist", "किस काम में कौन सा कागज़"),
    T("/tools/typing-speed-test.html", "⌨️", "Typing Speed Test", "हिंदी/English टाइपिंग टेस्ट"),
  ]},
  { id: "eligibility", title: "पात्रता और उम्र", cards: [
    T("/tools/age-calculator.html", "⏳", "Age Calculator", "किसी भी तारीख पर सही उम्र"),
    T("/tools/eligibility-checker.html", "✅", "Scheme Eligibility Checker", "आप किन योजनाओं के पात्र हैं"),
    T("/tools/govt-card-clarifier.html", "💳", "कौन सा सरकारी कार्ड?", "ABHA, आयुष्मान, e-Shram में फर्क"),
    T("/tools/status-troubleshooter.html", "🔍", "Status Troubleshooter", "आवेदन अटका है? कारण और हल"),
    T("/tools/pan-aadhaar-conflict-resolver.html", "🔗", "PAN-Aadhaar Resolver", "नाम/जन्मतिथि mismatch का हल"),
    T("/deadline-calendar.html", "📅", "Deadline Calendar", "फॉर्म और टैक्स की आखिरी तारीखें"),
  ]},
  { id: "money", title: "पैसे और टैक्स के कैलकुलेटर", cards: [
    T("/tools/income-tax-calculator.html", "🧮", "Income Tax Calculator", "नई vs पुरानी व्यवस्था"),
    T("/tools/hra-calculator.html", "🏠", "HRA Calculator", "HRA टैक्स छूट"),
    T("/tools/itr-penalty-calculator.html", "⚠️", "ITR Late Penalty", "देर से ITR पर जुर्माना"),
    T("/tools/epf-calculator.html", "🏦", "EPF Calculator", "रिटायरमेंट पर PF"),
    T("/tools/gratuity-calculator.html", "🎁", "Gratuity Calculator", "ग्रेच्युटी कितनी मिलेगी"),
    T("/tools/savings-comparator.html", "📊", "Savings Scheme Comparator", "PPF, SSY, SCSS, FD की तुलना"),
    T("/7th-pay-commission-calculator.html", "💵", "7th Pay Calculator", "सरकारी वेतन"),
    T("/8th-pay-calculator.html", "🚀", "8th Pay Projection", "8वें वेतन आयोग का अनुमान"),
    T("/nps-pension-calculator.html", "👴", "NPS Pension Calculator", "NPS से पेंशन कितनी"),
    T("/tools/hidden-tax-calculator.html", "🧾", "Hidden Tax Calculator", "आप कितना अप्रत्यक्ष टैक्स देते हैं"),
  ]},
  { id: "health", title: "स्वास्थ्य और आस-पास", cards: [
    T("/tools/medicine-price-checker.html", "💊", "Medicine Price Checker", "ब्रांडेड vs जन औषधि दाम"),
    T("/tools/csc-locator.html", "📍", "CSC Locator", "नज़दीकी जन सेवा केंद्र"),
  ]},
].map((g) => ({ ...g, cards: g.cards.filter((c) => exists(c.href)) }));

const crumbs = [{ label: "होम", href: "/" }, { label: "Tools" }];
const faq = [
  { q: "क्या ये टूल्स फ्री हैं?", a: "हां, सभी टूल्स पूरी तरह फ्री हैं और इनके लिए लॉगिन की ज़रूरत नहीं है।" },
  { q: "फोटो या दस्तावेज़ अपलोड करना सुरक्षित है?", a: "Photo Resizer, Signature Resizer और Document Compressor आपकी फाइल को आपके फोन/कंप्यूटर के ब्राउज़र में ही बदलते हैं। फाइल हमारे सर्वर पर अपलोड नहीं होती।" },
  { q: "कैलकुलेटर का जवाब कितना सही है?", a: "कैलकुलेटर मौजूदा नियमों पर आधारित अनुमान देते हैं। टैक्स या पेंशन जैसे बड़े फैसलों से पहले official पोर्टल या विशेषज्ञ से पुष्टि करें।" },
];
---
<Base
  title="फ्री सरकारी काम के Tools: Photo Resizer, Age, Tax Calculator | SarkariSewa India"
  description="फॉर्म के लिए Photo/Signature Resizer, PDF Compressor, Age Calculator, Income Tax, EPF, Gratuity, 7th Pay Calculator और Scheme Eligibility Checker, सब फ्री।"
  breadcrumbs={crumbs}
  faq={faq}
  schemaType="WebPage"
>
  <Breadcrumbs items={crumbs} />
  <section class="hero">
    <h1>फ्री Tools 🛠️</h1>
    <p class="page-intro">सरकारी फॉर्म भरने, उम्र और पात्रता जांचने, और टैक्स-पेंशन का हिसाब लगाने के फ्री टूल्स। कोई लॉगिन नहीं।</p>
  </section>
  {groups.map((g) => <CardGrid title={g.title} cards={g.cards} id={g.id} />)}
  <Faq items={faq} />
  <Explore />
</Base>

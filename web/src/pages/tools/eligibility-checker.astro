---
// Scheme eligibility checker. Same URL, title and description as the old page.
// Runs in the browser; nothing the visitor enters is sent anywhere.
// Old page: 7 schemes with some wrong rules (Ayushman shown to anyone with
// income under Rs 5 lakh; MPBCDC "50% subsidy / 4%" and NSP "Rs 10k-50k"
// without source). Rebuilt with ~28 central and state schemes. Every amount
// and condition below is taken from our scheme guides in src/guides/doc/*.ts
// (verified 15 Oct 2026 from official portals / PIB), e.g.:
//   PM-KISAN Rs 6,000/yr; PM-JAY Rs 5 lakh, all 70+ eligible; APY 18-40, no
//   income-tax payers since 1 Oct 2022; PM-SYM 18-40, income <= Rs 15,000/mo;
//   PM-KMY 18-40, land <= 2 ha; e-Shram 16+, not EPFO/ESIC, not tax payer;
//   PMJJBY 18-50 Rs 436; PMSBY 18-70 Rs 20; PMAY-U 2.0 income <= Rs 9 lakh;
//   SSY girl < 10, 8.2% (Oct-Dec 2026); PMMVY Rs 5,000 / Rs 6,000;
//   Post-matric OBC/SC income <= Rs 2.5 lakh; Ladki Bahin 21-65, <= 2.5 lakh;
//   Maiya Samman 18-50 Rs 2,500; Subhadra 21-60 Rs 10,000/yr; Gruha Lakshmi
//   Rs 2,000; Magalir Urimai Rs 1,000; Orunodoi Rs 1,250; Kanya Sumangala
//   Rs 25,000, income <= 3 lakh; Mahtari Vandan Rs 1,000 (new registration
//   closed as of Oct 2026); Stand-Up India ended 31 Mar 2025 (not listed).
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Faq from "../../components/Faq.astro";
import Explore from "../../components/Explore.astro";

const crumbs = [{ label: "होम", href: "/" }, { label: "टूल्स", href: "/tools/" }, { label: "योजना पात्रता चेकर" }];
const faq = [
  { q: "यह पात्रता चेकर कैसे काम करता है?", a: "आप अपनी उम्र, आय, काम, राज्य और कुछ हालात (जैसे पक्का घर नहीं, गर्भवती, बेटी 10 साल से छोटी) चुनते हैं। टूल लगभग 28 केंद्र और राज्य योजनाओं की मुख्य शर्तों से मिलान करके बताता है कि आप किनके लिए पात्र हो सकते हैं। अंतिम फैसला योजना का विभाग जांच के बाद करता है।" },
  { q: "क्या इसके लिए आधार नंबर या मोबाइल नंबर देना होता है?", a: "नहीं। कोई निजी पहचान नहीं मांगी जाती और जो आप भरते हैं वह कहीं नहीं भेजा जाता; मिलान आपके फोन के ब्राउज़र में ही होता है।" },
  { q: "टूल ने 'पात्र हो सकते हैं' बताया, तो क्या पैसा पक्का मिलेगा?", a: "नहीं। हर योजना में कुछ और शर्तें, दस्तावेज़ और सत्यापन होता है, और कई योजनाओं में लाभार्थी सरकारी सूची (जैसे SECC या राशन कार्ड) से तय होते हैं। हर योजना के साथ दिए 'पूरी जानकारी' लिंक में शर्तें और आवेदन का तरीका देखें।" },
  { q: "पात्र योजना मिलने के बाद आवेदन कैसे करें?", a: "हर योजना के कार्ड पर हमारी गाइड का लिंक है, जिसमें official पोर्टल, ज़रूरी कागज़ और आवेदन का तरीका दिया है। ज़्यादातर योजनाओं में नज़दीकी CSC केंद्र, बैंक, डाकघर या आंगनवाड़ी से भी आवेदन होता है।" },
  { q: "मेरे राज्य की योजनाएं क्यों नहीं दिख रहीं?", a: "अभी इसमें केंद्र की योजनाएं और कुछ राज्यों (महाराष्ट्र, झारखंड, ओडिशा, कर्नाटक, तमिलनाडु, असम, उत्तर प्रदेश, छत्तीसगढ़) की महिलाओं और बेटियों वाली मुख्य योजनाएं हैं। बाकी राज्यों की योजनाएं हमारे योजना पेज पर देखें।" },
  { q: "SarkariSewa India क्या सरकारी वेबसाइट है?", a: "नहीं। यह एक निजी जानकारी वेबसाइट है। हम कोई योजना नहीं चलाते और न ही आवेदन लेते हैं। आवेदन हमेशा official पोर्टल या सरकारी दफ्तर/CSC से करें।" },
];
---
<Base title="Govt Scheme Eligibility Checker 2026 | SarkariSewa India" description="सरकारी योजना व नौकरी पात्रता चेकर 2026: अपनी उम्र, आय, श्रेणी व राज्य दर्ज करके जानें आप किन-किन सरकारी योजनाओं, सब्सिडी व स्कॉलरशिप के लिए 100% पात्र हैं।" breadcrumbs={crumbs} faq={faq}>
  <Breadcrumbs items={crumbs} />
  <article class="page">
    <div>
      <h1>सरकारी योजना पात्रता चेकर 2026: आप किन योजनाओं के लिए पात्र हो सकते हैं</h1>
      <section class="answer" aria-labelledby="answer-title">
        <p class="answer-title" id="answer-title">सीधा जवाब</p>
        <p class="answer-lead">नीचे अपनी उम्र, परिवार की सालाना आय, काम और राज्य भरें और जो बातें आप पर लागू हों उन पर टिक करें। टूल तुरंत बताएगा कि केंद्र और कुछ राज्यों की करीब 28 योजनाओं में से आप किनके लिए पात्र हो सकते हैं। यह सिर्फ शुरुआती अंदाज़ा है; अंतिम पात्रता विभाग की जांच से तय होती है।</p>
      </section>

      <section class="section el-tool" aria-labelledby="el-title">
        <h2 id="el-title">🎯 अपनी जानकारी भरें</h2>
        <div class="el-grid">
          <div><label for="el-age">उम्र (साल)</label><input type="number" id="el-age" min="0" max="110" inputmode="numeric" placeholder="जैसे 35" /></div>
          <div><label for="el-gender">लिंग</label><select id="el-gender"><option value="f">महिला</option><option value="m">पुरुष</option><option value="t">ट्रांसजेंडर</option></select></div>
          <div><label for="el-inc">परिवार की सालाना आय (₹)</label><input type="number" id="el-inc" min="0" inputmode="numeric" placeholder="जैसे 150000" /></div>
          <div><label for="el-cat">श्रेणी</label><select id="el-cat"><option value="gen">सामान्य</option><option value="ews">EWS</option><option value="obc">OBC</option><option value="sc">SC</option><option value="st">ST</option></select></div>
          <div><label for="el-occ">काम / स्थिति</label><select id="el-occ">
            <option value="farmer">किसान (अपनी खेती की ज़मीन)</option>
            <option value="worker">मज़दूर / असंगठित कामगार (खेतिहर, घरेलू, दिहाड़ी)</option>
            <option value="construction">निर्माण मज़दूर (राजमिस्त्री, बेलदार आदि)</option>
            <option value="vendor">रेहड़ी-पटरी / ठेला (शहर में)</option>
            <option value="artisan">कारीगर (बढ़ई, लोहार, दर्जी, नाई, कुम्हार आदि)</option>
            <option value="business">छोटा कारोबार / दुकान / स्वरोज़गार</option>
            <option value="shg">स्वयं सहायता समूह (SHG) की सदस्य</option>
            <option value="student">छात्र / बेरोज़गार युवा</option>
            <option value="home">गृहिणी</option>
            <option value="job">नौकरी (प्राइवेट / सरकारी)</option>
          </select></div>
          <div><label for="el-state">राज्य</label><select id="el-state">
            <option value="other">दूसरा राज्य / केंद्र शासित प्रदेश</option>
            <option value="as">असम</option><option value="up">उत्तर प्रदेश</option><option value="ka">कर्नाटक</option>
            <option value="cg">छत्तीसगढ़</option><option value="jh">झारखंड</option><option value="tn">तमिलनाडु</option>
            <option value="od">ओडिशा</option><option value="mh">महाराष्ट्र</option>
          </select></div>
        </div>
        <fieldset class="el-flags">
          <legend>जो बातें आप पर लागू हों, उन पर टिक करें</legend>
          <label><input type="checkbox" value="tax" /> परिवार में कोई आयकर (income tax) भरता है</label>
          <label><input type="checkbox" value="epf" /> मेरा PF (EPFO) या ESIC कटता है</label>
          <label><input type="checkbox" value="govt" /> मैं सरकारी नौकरी में हूं / सरकारी पेंशन मिलती है</label>
          <label><input type="checkbox" value="bpl" /> BPL / अंत्योदय / प्राथमिकता वाला राशन कार्ड है</label>
          <label><input type="checkbox" value="small" /> खेती की ज़मीन 2 हेक्टेयर (करीब 5 एकड़) तक है</label>
          <label><input type="checkbox" value="nohouse" /> परिवार के पास कहीं पक्का घर नहीं है</label>
          <label><input type="checkbox" value="nolpg" /> घर में LPG गैस कनेक्शन नहीं है</label>
          <label><input type="checkbox" value="preg" /> गर्भवती हूं / हाल में बच्चा हुआ है</label>
          <label><input type="checkbox" value="girl" /> घर में 10 साल से छोटी बेटी है</label>
          <label><input type="checkbox" value="widow" /> विधवा हूं</label>
          <label><input type="checkbox" value="married" /> विवाहित हूं</label>
        </fieldset>
        <div class="el-out" aria-live="polite">
          <p class="el-count" id="el-count"></p>
          <div class="el-list" id="el-list"></div>
        </div>
      </section>

      <section class="section" id="kaise">
        <h2>कैसे इस्तेमाल करें</h2>
        <ol class="steps">
          <li>अपनी उम्र और पूरे परिवार की साल भर की कुल आय डालें (सभी सदस्यों की कमाई जोड़कर)।</li>
          <li>अपना मुख्य काम और राज्य चुनें, फिर नीचे जो बातें सच हों उन पर टिक करें।</li>
          <li>नतीजे में हर योजना का लाभ और ज़रूरी शर्त दिखेगी। 'पूरी जानकारी' खोलकर कागज़ और आवेदन का तरीका देखें।</li>
        </ol>
      </section>

      <section class="section" id="niyam">
        <h2>पात्रता के आम नियम</h2>
        <ul class="checklist">
          <li><strong>आयकर भरने वाले:</strong> अटल पेंशन, श्रम योगी मान-धन, ई-श्रम और PM किसान जैसी योजनाओं में आयकर भरने वालों को लाभ नहीं मिलता।</li>
          <li><strong>सूची वाली योजनाएं:</strong> आयुष्मान भारत (70 साल से कम उम्र के लिए) और PMAY-ग्रामीण में आवेदन नहीं, सरकारी सर्वे/सूची से नाम तय होता है।</li>
          <li><strong>आय प्रमाण पत्र:</strong> आय सीमा वाली योजनाओं (छात्रवृत्ति, लाडकी बहिण, कन्या सुमंगला) में तहसील/सक्षम अधिकारी का आय प्रमाण पत्र लगता है।</li>
          <li><strong>आधार और बैंक खाता:</strong> लगभग हर योजना में पैसा आधार से जुड़े (DBT चालू) बैंक खाते में आता है और e-KYC ज़रूरी होता है।</li>
        </ul>
      </section>

      <section class="section" id="dhyan">
        <h2>ध्यान दें</h2>
        <ul class="checklist">
          <li>यह टूल योजनाओं की मुख्य शर्तों से मिलान करता है, हर छोटी शर्त से नहीं। नतीजा 'पात्र हो सकते हैं' है, गारंटी नहीं।</li>
          <li>राशि और शर्तें 15 अक्टूबर 2026 तक की हमारी जांच पर आधारित हैं; सरकार इन्हें बदल सकती है।</li>
          <li>किसी योजना के नाम पर पैसे मांगने वाले एजेंट से बचें। सरकारी योजनाओं का पंजीकरण आम तौर पर मुफ्त या तय छोटी फीस पर होता है।</li>
          <li>ज़रूरी कागज़ों की सूची के लिए <a href="/tools/document-checklist.html">दस्तावेज़ चेकलिस्ट</a> और पास का CSC केंद्र खोजने के लिए <a href="/tools/csc-locator.html">CSC लोकेटर</a> देखें।</li>
        </ul>
      </section>

      <Faq items={faq} />
      <Explore />
    </div>
  </article>
</Base>

<style is:global>
.el-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 10px 14px; }
@media (min-width: 560px) { .el-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
.el-tool label { display: block; font-weight: 700; font-size: .92rem; margin-bottom: 4px; }
.el-grid input, .el-grid select { width: 100%; min-height: 44px; padding: 8px 10px; border: 1px solid var(--c-line); border-radius: 8px; font: inherit; background: var(--c-surface); color: var(--c-text); box-sizing: border-box; }
.el-flags { border: 1px solid var(--c-line); border-radius: var(--radius-sm); padding: 10px 12px; margin: 14px 0 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 2px 14px; }
@media (min-width: 640px) { .el-flags { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
.el-flags legend { font-weight: 800; padding: 0 4px; }
.el-flags label { display: flex; gap: 8px; align-items: flex-start; font-weight: 500; margin: 4px 0; }
.el-flags input { width: 20px; height: 20px; flex: 0 0 20px; margin-top: 3px; }
.el-count { font-weight: 800; font-size: 1.1rem; margin: 16px 0 8px; color: var(--c-ink); }
.el-list { display: grid; grid-template-columns: minmax(0, 1fr); gap: 10px; }
@media (min-width: 760px) { .el-list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
.el-card { border: 1px solid var(--c-line); border-left: 4px solid var(--c-green); border-radius: var(--radius-sm); background: var(--c-surface); padding: 12px 14px; overflow-wrap: anywhere; }
.el-card.warn { border-left-color: var(--c-saffron); }
.el-card h3 { margin: 0 0 4px; font-size: 1.02rem; }
.el-card p { margin: 0 0 6px; font-size: .93rem; }
.el-card .el-cond { color: var(--c-muted); font-size: .86rem; }
.el-card a { font-weight: 700; }
</style>

<script is:inline>
(function () {
  // u: { age, g, inc (null = unknown), cat, occ, st, f: {flag: true} }
  // test returns false (not eligible) or a string (extra condition to check, "" = none)
  var UNORG = { worker: 1, construction: 1, vendor: 1, artisan: 1, farmer: 1, shg: 1, business: 0 };
  function incLE(u, lim) { return u.inc === null || u.inc <= lim; }
  function incNote(u, lim, txt) { return u.inc === null ? (txt || "परिवार की आय " + lim.toLocaleString("en-IN") + " रुपये तक होनी चाहिए") : ""; }
  var S = [
    { n: "🌾 पीएम किसान सम्मान निधि", b: "₹6,000 सालाना (₹2,000 की 3 किस्त)", h: "/service/pm-kisan.html",
      t: function (u) { return u.occ === "farmer" && u.age >= 18 && !u.f.tax && !u.f.govt && "ज़मीन परिवार के नाम हो; e-KYC ज़रूरी, कई राज्यों में Farmer ID भी"; } },
    { n: "💳 किसान क्रेडिट कार्ड (KCC)", b: "₹3 लाख तक के फसल लोन पर 7% ब्याज, समय पर चुकाने पर 4%", h: "/service/kisan-credit-card.html",
      t: function (u) { return u.occ === "farmer" && u.age >= 18 && "लोन बैंक की जांच पर मिलता है"; } },
    { n: "👴 पीएम किसान मान-धन (पेंशन)", b: "60 साल के बाद ₹3,000 महीना पेंशन", h: "/service/pm-kisan-maan-dhan-yojana.html",
      t: function (u) { return u.occ === "farmer" && u.age >= 18 && u.age <= 40 && (u.f.small ? "" : "ज़मीन 2 हेक्टेयर तक होनी चाहिए"); } },
    { n: "🏥 आयुष्मान वय वंदना कार्ड (70+)", b: "₹5 लाख तक मुफ्त इलाज हर साल, आय की कोई सीमा नहीं", h: "/service/ayushman-bharat-vayo-vandana.html",
      t: function (u) { return u.age >= 70 && ""; } },
    { n: "🏥 आयुष्मान भारत (PM-JAY)", b: "परिवार को ₹5 लाख तक मुफ्त इलाज हर साल", h: "/service/ayushman-bharat.html",
      t: function (u) { return u.age < 70 && (u.f.bpl || incLE(u, 100000)) && !u.f.tax && "आवेदन नहीं होता; परिवार का नाम SECC/राज्य की सूची में होना चाहिए, beneficiary.nha.gov.in पर जांचें"; } },
    { n: "🪪 ई-श्रम कार्ड", b: "मुफ्त पंजीकरण, 12 अंकों का UAN; योजनाओं से जुड़ना आसान", h: "/service/e-shram-card.html",
      t: function (u) { return u.age >= 16 && UNORG[u.occ] !== undefined && !u.f.tax && !u.f.epf && "कार्ड पर अपने-आप कोई मासिक पैसा नहीं आता"; } },
    { n: "👷 श्रम योगी मान-धन (पेंशन)", b: "60 साल के बाद ₹3,000 महीना पेंशन; ₹55-200 महीना जमा", h: "/service/pm-shram-yogi-maandhan.html",
      t: function (u) { return u.age >= 18 && u.age <= 40 && UNORG[u.occ] !== undefined && u.occ !== "farmer" && !u.f.tax && !u.f.epf && "आपकी अपनी मासिक आय ₹15,000 या कम होनी चाहिए"; } },

  { q: "प्रमाण पत्र तय समय से ज़्यादा दिन से 'Under Process' है तो क्या करें?", a: "ज़्यादातर राज्यों में सेवा का अधिकार (लोक सेवा गारंटी) कानून में समय-सीमा तय है। समय निकल जाने पर उसी पोर्टल पर या तहसील/SDM कार्यालय में प्रथम अपील करें।" },
  { q: "PM किसान की हेल्पलाइन क्या है?", a: "PM-KISAN हेल्पलाइन 155261 और 011-24300606 है। 155261 पर फोन से भी स्टेटस पता किया जा सकता है।" },
  { q: "केंद्र सरकार के विभाग की शिकायत कहां करें?", a: "केंद्र सरकार के विभागों की शिकायत CPGRAMS पोर्टल (pgportal.gov.in) पर दर्ज कर सकते हैं। राज्य के कामों के लिए राज्य का शिकायत पोर्टल या मुख्यमंत्री हेल्पलाइन बेहतर है।" },
  { q: "RTI से अटके आवेदन की जानकारी कैसे लें?", a: "संबंधित विभाग के लोक सूचना अधिकारी को RTI आवेदन देकर पूछ सकते हैं कि आवेदन किस अधिकारी के पास कब से है और देरी का कारण क्या है। केंद्र सरकार के विभागों के लिए rtionline.gov.in पर ऑनलाइन RTI होती है।" },
];
---
<Base title="Govt Scheme Application Status | SarkariSewa India" description="सरकारी योजना, राशन कार्ड, छात्रवृत्ति या परीक्षा फॉर्म अटक गया है? स्टेटस ट्रबलशूटर से रिजेक्शन का कारण, समाधान और आधिकारिक शिकायत लिंक 2026 पाएं।" breadcrumbs={crumbs} faq={faq}>
  <Breadcrumbs items={crumbs} />
  <article class="page">
    <div>
      <h1>सरकारी आवेदन अटका या रिजेक्ट हुआ? कारण और समाधान</h1>
      <section class="answer" aria-labelledby="answer-title">
        <p class="answer-title" id="answer-title">सीधा जवाब</p>
        <p class="answer-lead">ज़्यादातर आवेदन eKYC अधूरी होने, आधार-बैंक सीडिंग न होने, नाम/जन्मतिथि में अंतर या अधूरे दस्तावेज़ के कारण अटकते हैं। नीचे अपनी योजना और समस्या चुनें; कारण, सुधार के कदम और सही पोर्टल दिखेगा। यह टूल आपके आवेदन का असली स्टेटस नहीं देखता।</p>
      </section>

      <section class="section stt" aria-labelledby="st-title">
        <h2 id="st-title">🔍 अपनी समस्या चुनें</h2>
        <div class="grid2">
          <div>
            <label for="st-cat">योजना / सेवा</label>
            <select id="st-cat">{cats.map((c) => <option value={c.id}>{c.name}</option>)}</select>
          </div>
          <div>
            <label for="st-item">समस्या</label>
            <select id="st-item">{cats[0].items.map((i) => <option value={i.id}>{i.title}</option>)}</select>
          </div>
        </div>
        <div id="st-results" aria-live="polite">
          {cats.map((c, ci) => c.items.map((it, ii) => (
            <div class="st-res" data-cat={c.id} data-id={it.id} data-title={it.title} hidden={!(ci === 0 && ii === 0)}>
              <h3>🛠️ {c.name}: {it.title}</h3>
              <p><strong>आम कारण:</strong> {it.why}</p>
              <p><strong>क्या करें:</strong></p>
              <ol>{it.steps.map((s) => <li>{s}</li>)}</ol>
              {it.links.length > 0 && (
                <div class="st-links">
                  {it.links.map(([href, label]) => ext(href)
                    ? <a class="cta secondary" href={href} target="_blank" rel="noopener nofollow">{label} ↗</a>
                    : <a class="cta secondary" href={href}>{label}</a>)}
                </div>
              )}
            </div>
          )))}
        </div>
      </section>

      <section class="section" id="aam">
        <h2>हर आवेदन से पहले ये 4 चीज़ें जांचें</h2>
        <ul class="checklist">
          <li><strong>नाम और जन्मतिथि:</strong> आधार, बैंक खाते और आवेदन में एक जैसे हों।</li>
          <li><strong>आधार-बैंक सीडिंग:</strong> DBT वाली योजनाओं में पैसा आधार से जुड़े खाते में ही आता है। स्थिति <a href="https://myaadhaar.uidai.gov.in/" target="_blank" rel="noopener nofollow">myAadhaar</a> पर देखें।</li>
          <li><strong>eKYC:</strong> PM किसान, राशन कार्ड जैसी योजनाओं में eKYC अनिवार्य है।</li>
          <li><strong>रसीद:</strong> हर आवेदन की रसीद/आवेदन नंबर संभालकर रखें; शिकायत और अपील में यही काम आता है।</li>
        </ul>
      </section>

      <section class="section" id="shikayat">
        <h2>शिकायत कहां करें</h2>
        <ul class="checklist">
          <li><strong>केंद्र सरकार के विभाग:</strong> <a href="https://pgportal.gov.in/" target="_blank" rel="noopener nofollow">CPGRAMS (pgportal.gov.in)</a></li>
          <li><strong>EPFO:</strong> <a href="https://epfigms.gov.in/" target="_blank" rel="noopener nofollow">EPFiGMS</a></li>
          <li><strong>PM किसान:</strong> हेल्पलाइन 155261 / 011-24300606</li>
          <li><strong>राज्य की योजनाएं और प्रमाण पत्र:</strong> राज्य का शिकायत पोर्टल, मुख्यमंत्री हेल्पलाइन, या सेवा का अधिकार कानून के तहत अपील।</li>
          <li><strong>जानकारी के लिए:</strong> RTI (केंद्र के लिए <a href="https://rtionline.gov.in/" target="_blank" rel="noopener nofollow">rtionline.gov.in</a>)।</li>
        </ul>
        <p class="notice">यह एक निजी वेबसाइट है, सरकारी नहीं। हम आपका आवेदन या शिकायत दर्ज नहीं करते; ऊपर दिए आधिकारिक पोर्टल पर ही आवेदन करें।</p>
      </section>

      <Faq items={faq} />
      <Explore />
    </div>
  </article>
</Base>

<style is:global>
.stt .grid2 { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px 14px; margin-bottom: 14px; }
@media (min-width: 640px) { .stt .grid2 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
.stt label { display: block; font-weight: 700; font-size: .92rem; margin-bottom: 4px; }
.stt select { width: 100%; min-height: 44px; padding: 8px 10px; border: 1px solid var(--c-line); border-radius: 8px; font: inherit; background: var(--c-surface); color: var(--c-text); box-sizing: border-box; }
.stt .st-res { border-left: 4px solid var(--c-brand); background: var(--c-brand-50); border-radius: 10px; padding: 14px 16px; overflow-wrap: anywhere; }
.stt .st-res[hidden] { display: none; }
.stt .st-res h3 { margin: 0 0 8px; font-size: 1.05rem; }
.stt .st-res ol { padding-left: 1.3em; margin: 0 0 10px; }
.stt .st-res li { margin: 4px 0; }
.stt .st-links { display: flex; flex-wrap: wrap; gap: 8px; }
.stt .st-links .cta { font-size: .92rem; }
</style>

<script is:inline>
(function () {
  var cat = document.getElementById("st-cat"), item = document.getElementById("st-item");
  var all = Array.prototype.slice.call(document.querySelectorAll("#st-results .st-res"));
  function fill() {
    item.innerHTML = "";
    all.filter(function (d) { return d.dataset.cat === cat.value; }).forEach(function (d) {
      var o = document.createElement("option"); o.value = d.dataset.id; o.textContent = d.dataset.title; item.appendChild(o);
    });
    show();
  }
  function show() {
    all.forEach(function (d) { d.hidden = !(d.dataset.cat === cat.value && d.dataset.id === item.value); });
    try { if (window.gtag) gtag("event", "tool_usage", { tool: "status_troubleshooter", issue: cat.value + ":" + item.value }); } catch (e) {}
  }
  cat.addEventListener("change", fill);
  item.addEventListener("change", show);
})();
</script>

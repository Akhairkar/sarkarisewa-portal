---
// Indexable page of one verified CSC / Jan Seva Kendra (approved claim):
// services with links to our guides, hours, address and map, Call/WhatsApp
// buttons (clicks are counted for the admin), the district's CSC page, an
// owner edit link and the site's main services to explore.
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Faq from "../../components/Faq.astro";
import CardGrid from "../../components/CardGrid.astro";
import Explore from "../../components/Explore.astro";
import PaidTools from "../../components/PaidTools.astro";
import { listings, listingSlug, listingDistrictPage, niceName, nearbyJa, digits, hoursText, guideLinks, sinceText, serviceHi, type Listing } from "../../lib/csc-listings";
import { POPULAR_TASKS } from "../../data/site";
import { nearbyPages } from "../../lib/csc";
import { typeOf } from "../../lib/centre-types";

export async function getStaticPaths() {
  return (await listings()).map((c) => ({ params: { slug: listingSlug(c) }, props: { c } }));
}
const { c } = Astro.props as { c: Listing };
const name = niceName(c.centre_name);
const T = typeOf(c.centre_type);
const isJa = T.kind === "ja";
const districtPage = isJa ? undefined : listingDistrictPage(c);
const online = (c.online_services ?? []).filter(Boolean).map(serviceHi);
const offline = (c.offline_services ?? []).filter(Boolean).map(serviceHi);
const custom = (c.custom_services ?? []).filter(Boolean).map(serviceHi);
const remote = (c.remote_services ?? []).filter(Boolean).map(serviceHi);
const all = [...new Set([...online, ...offline, ...custom, ...remote])];
const guides = guideLinks(all);
const hours = hoursText(c.working_hours);
const ph = digits(c.public_phone), wa = digits(c.public_whatsapp);
const uniq = (a: (string | null)[]) => a.filter((x, i) => x && a.findIndex((y) => (y ?? "").trim().toLowerCase() === x.trim().toLowerCase()) === i).join(", ");
const place = uniq([c.locality, c.city, c.district]);
const where = uniq([c.city, c.district, c.state]);
const map = c.latitude && c.longitude
  ? `https://www.google.com/maps?q=${c.latitude},${c.longitude}`
  : c.full_address ? `https://www.google.com/maps/search/${encodeURIComponent(`${c.full_address} ${c.pincode ?? ""}`)}` : "";
const photo = /^https:\/\/[a-z0-9]+\.supabase\.co\/storage\/v1\/object\/public\/csc-photos\//.test(c.photo_url ?? "") ? c.photo_url! : "";
const ja = nearbyJa(c);
const nearDistricts = isJa ? (ja?.near ?? []) : districtPage ? nearbyPages(districtPage, 6).map((p) => ({ href: p.href, name: p.name, count: p.d.count })) : [];
const since = sinceText(c.years_of_operation);
// Exact pin when the owner saved the location; otherwise an approximate map
// from the written address and PIN (marked as approximate on the page).
const addrQ = c.full_address ? [c.full_address, c.city, c.district, c.state, c.pincode].filter(Boolean).join(", ") : "";
const exact = !!(c.latitude && c.longitude);
const embed = exact ? `https://maps.google.com/maps?q=${c.latitude},${c.longitude}&z=16&output=embed`
  : addrQ ? `https://maps.google.com/maps?q=${encodeURIComponent(addrQ)}&z=15&output=embed` : "";
const pageUrl = `https://sarkarisewaindia.com/csc-centre/${listingSlug(c)}.html`;
const shareText = encodeURIComponent(`${name} (${c.city || c.district}): सेवाएं, समय और संपर्क\n${pageUrl}`);
const waText = encodeURIComponent("नमस्ते, मैंने आपका केंद्र SarkariSewa India (sarkarisewaindia.com) पर देखा। मुझे इस काम के लिए मदद चाहिए: ");
const typeHi: Record<string, string> = { "Jan Aushadhi Kendra": "प्रधानमंत्री भारतीय जन औषधि केंद्र", CSC: "CSC (कॉमन सर्विस सेंटर)", "Jan Seva Kendra": "जन सेवा केंद्र", "E-Mitra": "ई-मित्र", "Maha E Seva": "महा ई-सेवा केंद्र", "Vasudha Kendra": "वसुधा केंद्र", Other: "सेवा केंद्र" };
const type = typeHi[c.centre_type ?? ""] ?? c.centre_type ?? "सेवा केंद्र";
const area = uniq([c.locality, c.city || c.district]);
const top = all.filter((x) => !/फोटो|प्रिंट|स्कैन|लैमि|photo|print|scan|lamin/i.test(x)).slice(0, 2);
const title = `${name}, ${area}: ${T.short}${top.length ? ` (${top.join(", ")})` : ""} | SarkariSewa India`;
const description = `${name} (${where}): ${all.slice(0, 4).join(", ") || (isJa ? "सस्ती जेनेरिक दवाएं" : "सरकारी ऑनलाइन सेवाएं")}। पता, समय, फोन और WhatsApp। SarkariSewa पर सत्यापित केंद्र।`;
const crumbs = [
  { label: "होम", href: "/" },
  ...(isJa
    ? [{ label: "जन औषधि केंद्र", href: "/service/jan-aushadhi-store-locator.html" }, ...(ja ? [{ label: `${ja.name} जन औषधि`, href: ja.href }] : [])]
    : [{ label: "CSC सेंटर", href: "/tools/csc-locator.html" }, ...(districtPage ? [{ label: `${districtPage.name} CSC`, href: districtPage.href }] : [])]),
  { label: name },
];
const faq = [
  { q: `${name} कहां है?`, a: `${name} ${c.full_address ? `${c.full_address}, ` : ""}${where}${c.pincode ? ` (PIN ${c.pincode})` : ""} में है। ऊपर "रास्ता देखें" से Google Maps पर रास्ता देखें।` },
  ...(all.length ? [{ q: `${name} पर कौन सी सेवाएं मिलती हैं?`, a: `केंद्र के संचालक के अनुसार यहां ये सेवाएं मिलती हैं: ${all.join(", ")}। सेवा और फीस जाने से पहले फोन या WhatsApp पर पूछ लें।` }] : []),
  ...(hours ? [{ q: `${name} कितने बजे खुलता है?`, a: `संचालक के अनुसार समय: ${hours}। त्योहार या छुट्टी पर समय बदल सकता है।` }] : []),
  ...(remote.length ? [{ q: `क्या ${name} पर घर बैठे काम हो जाता है?`, a: isJa ? `हां, संचालक के अनुसार: ${remote.join(", ")}। दवा के लिए डॉक्टर की पर्ची की फोटो WhatsApp पर भेजें और उपलब्धता पूछ लें।` : `हां, संचालक के अनुसार ये सेवाएं WhatsApp या फोन पर कागज़ भेजकर घर बैठे हो जाती हैं: ${remote.join(", ")}। आधार जैसे बायोमेट्रिक काम के लिए केंद्र पर जाना ज़रूरी है।` }] : []),
  ...(ja && !isJa ? [{ q: `${name} के पास जन औषधि केंद्र कहां है?`, a: `${ja.name} ज़िले में ${ja.count} प्रधानमंत्री भारतीय जन औषधि केंद्र हैं, जहां दवाएं ब्रांडेड दवाओं से 50-80% तक सस्ती मिलती हैं। सबसे पास वाले केंद्र इस पेज पर नीचे दिए हैं।` }] : []),
  ...(isJa ? [
    { q: "जन औषधि केंद्र पर दवाएं सस्ती क्यों होती हैं?", a: "यहां ब्रांड के नाम की जगह उसी साल्ट (generic name) की दवाएं मिलती हैं, जो PMBI (Pharmaceuticals & Medical Devices Bureau of India) के अनुसार ब्रांडेड दवाओं से 50-80% तक सस्ती हैं। योजना में 2,100 से ज़्यादा दवाएं और 300 सर्जिकल सामान शामिल हैं। डॉक्टर की पर्ची साथ ले जाएं और दवा का साल्ट मिलाकर लें।" },
    { q: "जन औषधि की शिकायत या जानकारी कहां मिलेगी?", a: "PMBI का टोल-फ्री नंबर 1800-180-8080 है। दवा की कीमत और नज़दीकी केंद्र JanAushadhi Sugam ऐप पर भी देख सकते हैं।" },
  ] : [
  { q: "CSC पर सरकारी फीस से ज़्यादा पैसा मांगा जाए तो?", a: "सरकारी फीस के अलावा CSC अपना सेवा शुल्क लेता है। काम शुरू होने से पहले कुल राशि पूछें और रसीद लें। मनमानी वसूली की शिकायत CSC हेल्पलाइन 1800-121-3468 या helpdesk@csc.gov.in पर करें।" },
  ]),
];
const ld = {
  "@context": "https://schema.org",
  "@type": isJa ? "Pharmacy" : "LocalBusiness",
  name: name,
  description: `${type}${all.length ? `: ${all.join(", ")}` : ""}`,
  address: { "@type": "PostalAddress", streetAddress: c.full_address ?? undefined, addressLocality: c.city ?? undefined, addressRegion: c.state ?? undefined, postalCode: c.pincode ?? undefined, addressCountry: "IN" },
  ...(ph ? { telephone: `+91${ph}` } : {}),
  ...(c.latitude && c.longitude ? { geo: { "@type": "GeoCoordinates", latitude: c.latitude, longitude: c.longitude } } : {}),
  ...(map ? { hasMap: map } : {}),
  ...(photo ? { image: photo } : {}),
  url: pageUrl,
};
---
<Base title={title} description={description} breadcrumbs={crumbs} faq={faq} modified={(c.updated_at ?? c.approved_at ?? "").slice(0, 10) || undefined} schemaType="WebPage">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />
  <Breadcrumbs items={crumbs} />
  <div class="page has-aside">
    <article>
      <h1>{name}: {type}, {c.city || c.district}</h1>
      <div class="csc-badges" id="c-badges" data-hours={JSON.stringify(c.working_hours ?? null)}>
        <span class="b-ok">✓ SarkariSewa पर सत्यापित</span>
        {since && <span>🗓️ {since}</span>}
        {remote.length > 0 && <span>🏠 घर बैठे सेवा</span>}
        {c.home_visit && <span>🚶 घर पर आकर सेवा</span>}
        <span>📍 {where}</span>
      </div>

      <div id="c-live" data-app={c.application_id} data-updated={c.updated_at ?? ""} data-type={type}>
      <section class="answer" aria-labelledby="answer-title">
        <p class="answer-title" id="answer-title">केंद्र की जानकारी</p>
        {photo && <img class="csc-photo" src={photo} alt={name} width="1200" height="800" decoding="async" />}
        <p class="answer-lead">
          {name} {place || where} में एक {type} है{sinceText(c.years_of_operation) ? `, जो ${sinceText(c.years_of_operation)}` : ""}।
          {all.length > 0 && <> यहां {all.slice(0, 5).join(", ")}{all.length > 5 ? " और दूसरी" : ""} सेवाएं मिलती हैं।</>}
          {remote.length > 0 && ` ${remote.length} सेवाएं घर बैठे WhatsApp/फोन से भी हो जाती हैं।`}
          {c.home_visit && " केंद्र घर पर आकर भी सेवा देता है।"}
        </p>
        <dl class="facts">
          {c.full_address && <div><dt>पता</dt><dd>{c.full_address}{c.pincode && `, PIN ${c.pincode}`}</dd></div>}
          {hours && <div><dt>समय</dt><dd>{hours}</dd></div>}
          {ph && <div><dt>फोन</dt><dd><a href={`tel:+91${ph}`} data-act="call">{ph.slice(0, 5)} {ph.slice(5)}</a></dd></div>}
          {wa && <div><dt>WhatsApp</dt><dd><a href={`https://wa.me/91${wa}?text=${waText}`} data-act="whatsapp" target="_blank" rel="noopener nofollow">{wa.slice(0, 5)} {wa.slice(5)}</a></dd></div>}
        </dl>
        <div class="ja-actions" data-app={c.application_id} style="margin-top:12px">
          {ph && <a class="cta" href={`tel:+91${ph}`} data-act="call">📞 कॉल करें</a>}
          {wa && <a class="cta secondary" href={`https://wa.me/91${wa}?text=${waText}`} data-act="whatsapp" target="_blank" rel="noopener nofollow">💬 WhatsApp करें</a>}
          {map && <a href={map} data-act="map" target="_blank" rel="noopener nofollow">🗺️ रास्ता देखें ↗</a>}
        </div>
      </section>

      {c.about && (
        <section class="section" id="parichay">
          <h2>केंद्र के बारे में</h2>
          <p style="white-space:pre-line">{c.about}</p>
        </section>
      )}

      {all.length > 0 && (
        <section class="section" id="sevayen">
          <h2>{name} पर मिलने वाली {isJa ? "दवाएं और सुविधाएं" : "सेवाएं"}</h2>
          {remote.length > 0 && <><h3>{isJa ? "🏠 घर बैठे (WhatsApp / होम डिलीवरी)" : "🏠 घर बैठे (WhatsApp/फोन से कागज़ भेजकर)"}</h3><ul class="checklist">{remote.map((s) => <li>{s}</li>)}</ul></>}
          {online.length > 0 && <><h3>{isJa ? "💊 केंद्र पर मिलने वाली दवाएं और सामान" : "🏢 केंद्र पर आकर: सरकारी सेवाएं"}</h3><ul class="checklist">{online.map((s) => <li>{s}</li>)}</ul></>}
          {(offline.length > 0 || custom.length > 0) && <><h3>{isJa ? "🏪 दूसरी सुविधाएं" : "🏢 केंद्र पर: दूसरी सेवाएं"}</h3><ul class="checklist">{[...offline, ...custom].map((s) => <li>{s}</li>)}</ul></>}
          {remote.length > 0 && wa && <p><a class="cta secondary" href={`https://wa.me/91${wa}?text=${waText}`} data-act="whatsapp" target="_blank" rel="noopener nofollow">{isJa ? "💬 दवा के लिए WhatsApp करें" : "💬 घर बैठे काम के लिए WhatsApp करें"}</a></p>}
          <p class="cell-note">सेवाओं की जानकारी केंद्र के संचालक ने दी है। जाने से पहले फोन या WhatsApp पर पूछ लें।</p>
        </section>
      )}
      </div>

      {guides.length > 0 && (
        <section class="section" id="taiyari">
          <h2>केंद्र जाने से पहले: ज़रूरी कागज़ और सरकारी फीस</h2>
          <p>{name} पर मिलने वाली इन सेवाओं के लिए कौन से कागज़ लगते हैं और सरकारी फीस कितनी है, हमारी गाइड में देखें, ताकि एक ही बार में काम हो जाए:</p>
          <div class="card-grid">{guides.map((g) => <a class="card" href={g.href}><span class="emoji" aria-hidden="true">📄</span><strong>{g.label}</strong><small>कागज़, फीस और प्रक्रिया →</small></a>)}</div>
        </section>
      )}

      {isJa && (
        <section class="section" id="jan-aushadhi-info">
          <h2>जन औषधि केंद्र से दवा लेने से पहले</h2>
          <ul class="checklist">
            <li>यहां ब्रांड की जगह उसी साल्ट (generic name) की दवा मिलती है। PMBI के अनुसार ये ब्रांडेड दवाओं से <strong>50-80% तक सस्ती</strong> हैं।</li>
            <li>योजना में 2,100 से ज़्यादा दवाएं और 300 सर्जिकल सामान हैं। डॉक्टर की पर्ची साथ ले जाएं; दवा न हो तो पूछें कि कब तक मंगवा सकते हैं।</li>
            <li>दवा की कीमत और नज़दीकी केंद्र <a href="https://play.google.com/store/apps/details?id=in.gov.pmbjp" target="_blank" rel="noopener">JanAushadhi Sugam ऐप</a> पर भी देख सकते हैं।</li>
            <li>शिकायत या जानकारी: PMBI टोल-फ्री <a href="tel:18001808080">1800-180-8080</a>।</li>
          </ul>
        </section>
      )}

      {ja && (
        <section class="section" id="jan-aushadhi">
          <h2>{isJa ? "पास के दूसरे जन औषधि केंद्र" : "पास के जन औषधि केंद्र: 50-80% सस्ती दवा"}</h2>
          <p>{ja.name} ज़िले में {ja.count} प्रधानमंत्री भारतीय जन औषधि केंद्र हैं{ja.kendras[0]?.km != null ? `; ${name} से सबसे पास वाले` : "; इनमें से कुछ"}:</p>
          <ul class="csc-list">
            {ja.kendras.map((k) => (
              <li class="csc-card">
                <strong>जन औषधि केंद्र {k.code && <small>({k.code})</small>}</strong>
                <span>{k.addr}</span>
                <span class="pin">PIN {k.pin}{k.km != null && ` · लगभग ${k.km} km`}</span>
                <span class="ja-actions"><a href={k.map} target="_blank" rel="noopener nofollow">रास्ता ↗</a></span>
              </li>
            ))}
          </ul>
          <p><a href={ja.href}>{ja.name} के सभी {ja.count} जन औषधि केंद्र →</a></p>
        </section>
      )}

      <section class="section" id="v-others" hidden>
        <h2>{c.district} में और सत्यापित केंद्र</h2>
        <ul class="csc-list v-list"></ul>
      </section>

      {!isJa && <section class="section" id="dhyan">
        <h2>ध्यान रखें</h2>
        <ul class="checklist">
          <li>काम शुरू होने से पहले सरकारी फीस और केंद्र का सेवा शुल्क पूछ लें, और रसीद लें।</li>
          <li>अपना OTP, ATM PIN या पासवर्ड किसी को न बताएं; OTP सिर्फ अपने सामने, अपने काम के लिए डलवाएं।</li>
          <li>शिकायत: CSC हेल्पलाइन <a href="tel:18001213468">1800-121-3468</a> या helpdesk@csc.gov.in।</li>
        </ul>
      </section>}
      {isJa && ja && (
        <CardGrid title="आसपास और क्या है" id="related" cards={[
          { href: ja.href, emoji: "💊", title: { hi: `${ja.name} के सभी जन औषधि केंद्र`, en: `All Jan Aushadhi Kendras in ${ja.name}` }, text: { hi: `${ja.count} केंद्र, पता और नक्शा`, en: "Address, map" } },
          { href: "/tools/csc-locator.html", emoji: "🏢", title: { hi: "नज़दीकी CSC / जन सेवा केंद्र", en: "Nearest CSC" }, text: { hi: "आधार, PAN, प्रमाण पत्र", en: "Aadhaar, PAN, certificates" } },
        ]} />
      )}

      {districtPage && (
        <CardGrid title="आसपास और क्या है" id="related" cards={[
          { href: districtPage.href, emoji: "📍", title: { hi: `${districtPage.name} के सभी CSC सेंटर`, en: `All CSC centres in ${districtPage.name}` }, text: { hi: "पता, PIN और नक्शा", en: "Address, PIN, map" } },
          { href: "/service/jan-aushadhi-store-locator.html", emoji: "💊", title: { hi: "नज़दीकी जन औषधि केंद्र", en: "Jan Aushadhi Kendra" }, text: { hi: "50-80% सस्ती दवा", en: "Cheaper medicines" } },
        ]} />
      )}
      {nearDistricts.length > 0 && (
        <section class="section" id="aaspaas">
          <h2>{isJa ? "आसपास के ज़िलों के जन औषधि केंद्र" : "आसपास के ज़िलों के CSC सेंटर"}</h2>
          <ul class="chips">{nearDistricts.map((p) => <li><a href={p.href}>{p.name} <small>{p.count.toLocaleString("en-IN")}</small></a></li>)}</ul>
        </section>
      )}
      <CardGrid title="SarkariSewa पर लोकप्रिय सेवाएं" id="popular" cards={POPULAR_TASKS.slice(0, 6)} />
      <PaidTools />
      <Faq items={faq} />

      <p class="notice">SarkariSewa India एक निजी वेबसाइट है। केंद्र की जानकारी संचालक ने दी है; हम संचालक से बात करके इसे जांचते हैं, पर केंद्र की सेवा, फीस या व्यवहार की ज़िम्मेदारी हमारी नहीं है। अपना केंद्र जोड़ना है? <a href="/claim-your-csc.html">फ्री में जोड़ें</a></p>
      <p class="hint" style="text-align:right"><a href={`/csc-edit.html?id=${encodeURIComponent(c.application_id)}`} rel="nofollow">संचालक: जानकारी बदलें</a></p>
      <Explore />
    </article>

    <aside class="page-aside">
      <section class="section toc" data-app={c.application_id}>
        <h2 style="font-size:1rem">संपर्क करें</h2>
        {ph && <a class="cta" href={`tel:+91${ph}`} data-act="call">📞 कॉल करें</a>}
        {wa && <a class="cta secondary" href={`https://wa.me/91${wa}?text=${waText}`} data-act="whatsapp" target="_blank" rel="noopener nofollow">💬 WhatsApp</a>}
        {districtPage && <a class="cta secondary" href={districtPage.href}>{districtPage.name} के सभी CSC</a>}
        {isJa && ja && <a class="cta secondary" href={ja.href}>{ja.name} के सभी जन औषधि केंद्र</a>}
      </section>
      <section class="section toc" id="c-map" hidden={!embed}>
        <h2 style="font-size:1rem">नक्शे पर केंद्र</h2>
        <iframe class="csc-map" src={embed || undefined} data-src={embed} title={`${name} नक्शा`} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        {!exact && embed && <p class="hint">पते के हिसाब से अनुमानित जगह; सही रास्ते के लिए केंद्र को कॉल करें।</p>}
        {map && <a href={map} data-act="map" target="_blank" rel="noopener nofollow">🗺️ Google Maps में खोलें ↗</a>}
      </section>
      <section class="section toc">
        <h2 style="font-size:1rem">यह पेज शेयर करें</h2>
        <a class="cta secondary" href={`https://wa.me/?text=${shareText}`} target="_blank" rel="noopener nofollow">💬 WhatsApp पर शेयर</a>
        <button type="button" class="cta secondary" id="c-share" data-url={pageUrl} data-title={name}>🔗 दूसरे ऐप / लिंक कॉपी</button>
        <p class="hint"><a href={`/csc-edit.html?id=${encodeURIComponent(c.application_id)}`} rel="nofollow">✏️ संचालक: सेवाएं / फोटो अपडेट करें</a></p>
      </section>
    </aside>
  </div>
  <script is:inline src="/assets/js/csc-listing.js"></script>
  <script is:inline define:vars={{ app: c.application_id, district: c.district ?? "", state: c.state ?? "", kind: T.kind }}>
    // Owner edits show at once: if the live record is newer than this build,
    // redraw the info, services and contact parts from it.
    if (window.SSCsc) {
      var live = document.getElementById("c-live");
      SSCsc.one(app).then(function (row) {
        if (row && row.updated_at && row.updated_at !== live.dataset.updated) {
          live.innerHTML = SSCsc.full(row, live.dataset.type);
          var h1 = document.querySelector("h1"); if (h1) h1.textContent = SSCsc.nice(row.centre_name) + ": " + live.dataset.type + ", " + (row.city || row.district || "");
          var m = document.getElementById("c-map"), fr = m && m.querySelector("iframe");
          if (fr) {
            var aq = row.full_address ? [row.full_address, row.city, row.district, row.state, row.pincode].filter(Boolean).join(", ") : "";
            var src = row.latitude && row.longitude ? "https://maps.google.com/maps?q=" + row.latitude + "," + row.longitude + "&z=16&output=embed" : aq ? "https://maps.google.com/maps?q=" + encodeURIComponent(aq) + "&z=15&output=embed" : "";
            if (src !== fr.dataset.src) { fr.dataset.src = src; if (src) fr.src = src; m.hidden = !src; }
          }
        }
      }).catch(function () {});
      var bd = document.getElementById("c-badges");
      try {
        var on = SSCsc.openNow(JSON.parse(bd.dataset.hours || "null"));
        if (on) { var sp = document.createElement("span"); sp.className = on.open ? "b-open" : "b-closed"; sp.textContent = (on.open ? "🟢 " : "🔴 ") + on.label; bd.insertBefore(sp, bd.children[1] || null); }
      } catch (e) {}
      SSCsc.district(document.getElementById("v-others"), { names: [district], state: state, exclude: app, kind: kind });
      SSCsc.log(app, "profile");
      var sh = document.getElementById("c-share");
      if (sh) sh.addEventListener("click", function () {
        var u = sh.dataset.url;
        if (navigator.share) { navigator.share({ title: sh.dataset.title, url: u }).catch(function () {}); return; }
        (navigator.clipboard ? navigator.clipboard.writeText(u) : Promise.reject()).then(function () { sh.textContent = "✓ लिंक कॉपी हो गया"; }, function () { prompt("लिंक कॉपी करें:", u); });
      });
      document.addEventListener("click", function (e) {
        var a = e.target.closest && e.target.closest("a[data-act]");
        if (a) SSCsc.log(app, a.dataset.act);
      });
    }
  </script>
</Base>

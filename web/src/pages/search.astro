---
// Site search. Results come from /search-index.json ([url, title] of every
// indexable page), built at deploy time by scripts/assemble.mjs.
import Base from "../layouts/Base.astro";
import SearchBox from "../components/SearchBox.astro";
import TaskList from "../components/TaskList.astro";
import { POPULAR_TASKS } from "../data/site";
import { SUPABASE_URL, SUPABASE_ANON_KEY } from "../lib/supabase-public";
---
<Base
  title="खोजें: सरकारी सेवाएं, योजनाएं और टूल्स | SarkariSewa India"
  description="SarkariSewa India पर दस्तावेज़, योजनाएं, नौकरियां, CSC सेंटर और टूल्स खोजें।"
  schemaType="WebPage"
  noindex
>
  <section class="hero">
    <h1>खोजें</h1>
    <SearchBox />
    <p class="sr-status" id="search-status" role="status" aria-live="polite"></p>
    <span id="sq-cfg" hidden data-url={SUPABASE_URL} data-key={SUPABASE_ANON_KEY}></span>
  </section>

  <section class="block" id="results-block" hidden>
    <div class="results" id="results"></div>
    <button class="more-btn" id="more" type="button" hidden>और नतीजे दिखाएं</button>
  </section>

  <section class="block" id="empty-block">
    <div class="block-head"><h2>लोग सबसे ज़्यादा यह खोज रहे हैं</h2></div>
    <TaskList items={POPULAR_TASKS} />
  </section>

  <script is:inline>
  (function () {
    var input = document.getElementById("q");
    var statusEl = document.getElementById("search-status");
    var resultsEl = document.getElementById("results");
    var block = document.getElementById("results-block");
    var empty = document.getElementById("empty-block");
    var moreBtn = document.getElementById("more");
    var INDEX = null, shown = 0, matches = [];
    var PAGE = 20;

    // Common Hinglish / English words -> Hindi spelling used in titles (and back).
    var SYN = {
      ration: "राशन", labour: "लेबर", labor: "लेबर", pension: "पेंशन", tax: "टैक्स", card: "कार्ड",
      senior: "सीनियर", citizen: "सिटीजन", voter: "वोटर", birth: "जन्म", death: "मृत्यु", caste: "जाति",
      income: "आय", domicile: "निवास", certificate: "प्रमाण", yojana: "योजना", scheme: "योजना",
      naukri: "नौकरी", job: "नौकरी", jobs: "भर्ती", bharti: "भर्ती", scholarship: "छात्रवृत्ति",
      aadhaar: "आधार", aadhar: "आधार", pan: "पैन", kisan: "किसान", ayushman: "आयुष्मान",
      dawa: "दवा", medicine: "दवा", janaushadhi: "औषधि", aushadhi: "औषधि", exam: "परीक्षा",
      bijli: "बिजली", gas: "गैस", pm: "प्रधानमंत्री", status: "स्टेटस", apply: "आवेदन", list: "लिस्ट"
    };
    Object.keys(SYN).forEach(function (k) { SYN[SYN[k]] = SYN[SYN[k]] || k; });
    // State short forms people type.
    var ABBR = {
      mp: "madhya pradesh", up: "uttar pradesh", uk: "uttarakhand", hp: "himachal pradesh", wb: "west bengal",
      ap: "andhra pradesh", jk: "jammu", cg: "chhattisgarh", mh: "maharashtra", tn: "tamil nadu", ts: "telangana",
      rj: "rajasthan", br: "bihar", jh: "jharkhand", gj: "gujarat", pb: "punjab", hr: "haryana", ka: "karnataka", od: "odisha"
    };

    // "15,000" and "15000" match each other; ₹ and other signs are dropped.
    function norm(s) { return s.toLowerCase().replace(/(\d),(?=\d)/g, "$1").replace(/[^\p{L}\p{M}\p{N}\s]/gu, " ").replace(/\s+/g, " ").trim(); }
    // Filler words people type ("pf 15000 wali scheme", "ration card kaise banaye")
    // that are not in page titles; they must not make a search find nothing.
    var STOP = { wali: 1, wala: 1, wale: 1, ki: 1, ka: 1, ke: 1, ko: 1, se: 1, me: 1, mein: 1, hai: 1, kya: 1, kaise: 1, kare: 1, karen: 1, karein: 1, karna: 1, aur: 1, the: 1, of: 1, for: 1, how: 1, to: 1, "की": 1, "का": 1, "के": 1, "को": 1, "से": 1, "में": 1, "है": 1, "क्या": 1, "कैसे": 1, "वाली": 1, "वाला": 1, "और": 1 };
    function esc(s) { var d = document.createElement("div"); d.textContent = s; return d.innerHTML; }
    function section(url) {
      if (/\/csc-locator\//.test(url)) return "CSC सेंटर";
      if (/\/jan-aushadhi\//.test(url)) return "जन औषधि";
      if (/^\/states\//.test(url)) return "राज्य गाइड";
      if (/^\/(jobs|exams)\//.test(url)) return "नौकरी / Exam";
      if (/^\/tools\//.test(url) || /calculator/.test(url)) return "टूल";
      if (/^\/blog\//.test(url)) return "लेख";
      if (/^\/en\//.test(url)) return "English";
      return "गाइड";
    }

    function search(q) {
      var all = norm(q).split(" ").filter(Boolean);
      var words = all.filter(function (w) { return !STOP[w]; });
      if (!words.length) words = all;
      words = words.map(function (w) { return ABBR[w] || w; });
      if (!words.length) return [];
      var res = find(q, words, 0);
      // Nothing with every word: for 3+ words, allow one word to be missing
      // ("pf 15000 scheme" finds the Rs 15,000 first-job scheme).
      if (!res.length && words.length >= 3) res = find(q, words, 1);
      return res;
    }
    function find(q, words, allowMiss) {
      var res = [];
      for (var i = 0; i < INDEX.length; i++) {
        var url = INDEX[i][0], title = INDEX[i][1];
        var hay = norm(title + " " + url.replace(/[\/\-.]/g, " "));
        var score = 0, miss = 0;
        for (var j = 0; j < words.length; j++) {
          var w = words[j], alt = SYN[w];
          var hit = hay.indexOf(w) !== -1 || (alt && hay.indexOf(alt) !== -1);
          if (!hit) { if (++miss > allowMiss) break; continue; }
          var t = norm(title);
          if (t.indexOf(w) !== -1 || (alt && t.indexOf(alt) !== -1)) score += 3; else score += 1;
        }
        if (miss > allowMiss) continue;
        if (norm(title).indexOf(norm(q)) !== -1) score += 5;
        // Prefer guides over the many CSC / Jan Aushadhi listing pages.
        if (/\/(csc-locator|jan-aushadhi)\//.test(url) && !/csc|सीएससी|औषधि|aushadhi|kendra|केंद्र/i.test(q)) score -= 2;
        if (/^\/en\//.test(url)) score -= 1;
        score -= url.split("/").length * 0.1;
        res.push({ url: url, title: title, score: score });
      }
      return res.sort(function (a, b) { return b.score - a.score; });
    }

    function render(reset) {
      if (reset) { resultsEl.innerHTML = ""; shown = 0; }
      var next = matches.slice(shown, shown + PAGE);
      resultsEl.insertAdjacentHTML("beforeend", next.map(function (m) {
        return '<a class="result" href="' + esc(m.url) + '"><span class="result-tag">' + section(m.url) + '</span><strong>' + esc(m.title) + '</strong><small>sarkarisewaindia.com' + esc(m.url) + '</small></a>';
      }).join(""));
      shown += next.length;
      moreBtn.hidden = shown >= matches.length;
    }

    // Search log (supabase/search-queries.sql): which words people search and
    // whether anything was found, to know which problems still need a page.
    // Only the words: digit runs of 7+ (phone, Aadhaar, application numbers)
    // become "#", e-mails are dropped; amounts like 15000 stay.
    var CFG = document.getElementById("sq-cfg").dataset, pending = null, logged = {};
    function clean(q) { return q.replace(/\S+@\S+/g, " ").replace(/\d{7,}/g, "#").replace(/\s+/g, " ").trim().slice(0, 80); }
    function flush(clicked, minMs) {
      var p = pending;
      if (!p || Date.now() - p.at < (minMs || 0)) return;
      pending = null;
      var q = clean(p.q), key = norm(q) + "|" + (clicked || "");
      if (q.length < 2 || logged[key]) return;
      logged[key] = 1;
      try {
        fetch(CFG.url + "/rest/v1/search_queries", {
          method: "POST", keepalive: true,
          headers: { apikey: CFG.key, Authorization: "Bearer " + CFG.key, "Content-Type": "application/json", Prefer: "return=minimal" },
          body: JSON.stringify({ q: q, results: Math.min(p.n, 5000), clicked: clicked || null })
        }).catch(function () {});
      } catch (e) {}
    }
    function track(q, n) {
      if (pending && norm(pending.q) === norm(q)) { pending.n = n; return; }
      flush(null, 2500);
      pending = q ? { q: q, n: n, at: Date.now() } : null;
    }
    resultsEl.addEventListener("click", function (e) {
      var a = e.target.closest && e.target.closest("a.result");
      if (a) flush(a.getAttribute("href").slice(0, 200), 0);
    });
    addEventListener("pagehide", function () { flush(null, 1000); });
    document.addEventListener("visibilitychange", function () { if (document.visibilityState === "hidden") flush(null, 1000); });
    function run(q) {
      q = (q || "").trim();
      if (!q) { block.hidden = true; empty.hidden = false; statusEl.textContent = ""; return; }
      matches = search(q);
      block.hidden = false;
      empty.hidden = matches.length > 0;
      statusEl.textContent = matches.length
        ? "“" + q + "” के लिए " + matches.length + " नतीजे"
        : "“" + q + "” के लिए कुछ नहीं मिला। छोटा या दूसरा शब्द आज़माएं, जैसे “राशन” या “pension”।";
      render(true);
      track(q, matches.length);
    }

    var params = new URLSearchParams(location.search);
    var initial = params.get("q") || "";
    input.value = initial;
    statusEl.textContent = initial ? "खोज रहे हैं…" : "";

    fetch("/search-index.json").then(function (r) { return r.json(); }).then(function (data) {
      INDEX = data;
      run(initial);
    }).catch(function () { statusEl.textContent = "अभी खोज नहीं हो पा रही, थोड़ी देर बाद कोशिश करें।"; });

    input.form.addEventListener("submit", function (e) {
      e.preventDefault();
      var q = input.value.trim();
      history.replaceState(null, "", q ? "?q=" + encodeURIComponent(q) : location.pathname);
      if (INDEX) run(q);
    });
    var t;
    input.addEventListener("input", function () { clearTimeout(t); t = setTimeout(function () { if (INDEX) run(input.value); }, 200); });
    moreBtn.addEventListener("click", function () { render(false); });
  })();
  </script>
</Base>

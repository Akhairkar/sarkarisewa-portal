---
// Live page of an approved CSC claim: /csc-centre.html?id=<application id>.
// A centre with a built page (/csc-centre/<slug>.html) is sent there at once;
// a newly approved one is drawn here from the public view with the same
// sections, until the next site build gives it its own indexable page.
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import CardGrid from "../components/CardGrid.astro";
import Explore from "../components/Explore.astro";
import PaidTools from "../components/PaidTools.astro";
import { POPULAR_TASKS } from "../data/site";
import { listings, listingSlug } from "../lib/csc-listings";
// Centres that already have a static page: id -> page, so the redirect is instant.
const pages = Object.fromEntries((await listings()).map((c) => [c.application_id, `/csc-centre/${listingSlug(c)}.html`]));
const crumbs = [{ label: "होम", href: "/" }, { label: "CSC सेंटर", href: "/tools/csc-locator.html" }, { label: "केंद्र की जानकारी" }];
---
<Base title="CSC केंद्र की जानकारी | SarkariSewa India" description="SarkariSewa पर सत्यापित CSC / जन सेवा केंद्र: पता, सेवाएं, समय और संपर्क।" breadcrumbs={crumbs} noindex schemaType="WebPage">
  <Breadcrumbs items={crumbs} />
  <div class="page has-aside">
    <article>
      <h1 id="c-title">CSC केंद्र की जानकारी</h1>
      <div class="csc-badges" id="c-badges"></div>
      <p class="csc-status" id="c-status">जानकारी लोड हो रही है…</p>
      <div id="c-live"></div>

      <section class="section" id="taiyari" hidden>
        <h2>केंद्र जाने से पहले: ज़रूरी कागज़ और सरकारी फीस</h2>
        <p>इन सेवाओं के लिए कौन से कागज़ लगते हैं और सरकारी फीस कितनी है, हमारी गाइड में देखें, ताकि एक ही बार में काम हो जाए:</p>
        <div class="card-grid" id="c-guides"></div>
      </section>

      <section class="section" id="v-others" hidden>
        <h2 id="v-others-title">इस ज़िले में और सत्यापित केंद्र</h2>
        <ul class="csc-list v-list"></ul>
      </section>

      <section class="section" id="c-district" hidden>
        <h2>पूरे ज़िले के CSC सेंटर</h2>
        <p><a class="cta secondary" id="c-district-link" href="/tools/csc-locator.html"></a></p>
      </section>

      <section class="section" id="ja-info" hidden>
        <h2>जन औषधि केंद्र से दवा लेने से पहले</h2>
        <ul class="checklist">
          <li>यहां ब्रांड की जगह उसी साल्ट (generic name) की दवा मिलती है। PMBI के अनुसार ये ब्रांडेड दवाओं से <strong>50-80% तक सस्ती</strong> हैं।</li>
          <li>योजना में 2,100 से ज़्यादा दवाएं और 300 सर्जिकल सामान हैं। डॉक्टर की पर्ची साथ ले जाएं।</li>
          <li>शिकायत या जानकारी: PMBI टोल-फ्री <a href="tel:18001808080">1800-180-8080</a>।</li>
        </ul>
      </section>

      <section class="section" id="dhyan">
        <h2>ध्यान रखें</h2>
        <ul class="checklist">
          <li>काम शुरू होने से पहले सरकारी फीस और केंद्र का सेवा शुल्क पूछ लें, और रसीद लें।</li>
          <li>अपना OTP, ATM PIN या पासवर्ड किसी को न बताएं; OTP सिर्फ अपने सामने, अपने काम के लिए डलवाएं।</li>
          <li>शिकायत: CSC हेल्पलाइन <a href="tel:18001213468">1800-121-3468</a> या helpdesk@csc.gov.in।</li>
        </ul>
      </section>

      <CardGrid title="SarkariSewa पर लोकप्रिय सेवाएं" id="popular" cards={POPULAR_TASKS.slice(0, 6)} />
      <PaidTools />

      <div class="claim-cta">
        <p><strong>आप भी CSC / जन सेवा केंद्र चलाते हैं?</strong> अपना केंद्र SarkariSewa पर फ्री में जोड़ें।</p>
        <a class="cta" href="/claim-your-csc.html">फ्री में केंद्र जोड़ें</a>
      </div>
      <p class="notice">SarkariSewa India एक निजी वेबसाइट है। केंद्र की जानकारी संचालक ने खुद दी है; हम संचालक से बात करके इसे जांचते हैं, पर केंद्र की सेवा, फीस या व्यवहार की ज़िम्मेदारी हमारी नहीं है। सरकारी फीस से ज़्यादा पैसा मांगा जाए तो रसीद लें और शिकायत करें।</p>
      <Explore />
    </article>

    <aside class="page-aside" id="c-side" hidden>
      <section class="section toc" id="c-contact">
        <h2 style="font-size:1rem">संपर्क करें</h2>
      </section>
      <section class="section toc" id="c-map" hidden>
        <h2 style="font-size:1rem">नक्शे पर केंद्र</h2>
        <iframe class="csc-map" title="नक्शा" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </section>
      <section class="section toc">
        <h2 style="font-size:1rem">यह पेज शेयर करें</h2>
        <a class="cta secondary" id="c-wa-share" href="#" target="_blank" rel="noopener nofollow">💬 WhatsApp पर शेयर</a>
        <button type="button" class="cta secondary" id="c-share">🔗 दूसरे ऐप / लिंक कॉपी</button>
        <p class="hint"><a id="c-edit" href="/csc-edit.html" rel="nofollow">✏️ संचालक: सेवाएं / फोटो अपडेट करें</a></p>
      </section>
    </aside>
  </div>
  <script is:inline define:vars={{ pages }}>
    (function () { var id = new URLSearchParams(location.search).get("id"); if (id && pages[id]) location.replace(pages[id]); })();
  </script>
  <script is:inline src="/assets/js/csc-listing.js"></script>
  <script is:inline>
  (function () {
    var id = new URLSearchParams(location.search).get("id") || "";
    var status = document.getElementById("c-status");
    var $ = function (x) { return document.getElementById(x); };
    if (!/^[A-Za-z0-9-]{4,50}$/.test(id)) { status.textContent = "केंद्र नहीं मिला। CSC लोकेटर से खोजें।"; return; }
    var slug = function (t) { return String(t || "").toLowerCase().normalize("NFKD").replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "").slice(0, 60); };
    var norm = function (s) { return String(s || "").toLowerCase().replace(/district|जिला|ज़िला|[^a-zऀ-ॿ]/g, ""); };
    var TYPE = { "Jan Aushadhi Kendra": "प्रधानमंत्री भारतीय जन औषधि केंद्र", CSC: "CSC (कॉमन सर्विस सेंटर)", "Jan Seva Kendra": "जन सेवा केंद्र", "E-Mitra": "ई-मित्र", "Maha E Seva": "महा ई-सेवा केंद्र", "Vasudha Kendra": "वसुधा केंद्र", Other: "सेवा केंद्र" };
    SSCsc.one(id).then(function (c) {
      if (!c) { status.textContent = "यह केंद्र अभी सत्यापित नहीं है या हटाया जा चुका है।"; return; }
      var num = (id.match(/\d{4,}$/) || [slug(id)])[0];
      var page = "/csc-centre/" + [slug(c.centre_name), slug(c.district), num].filter(Boolean).join("-") + ".html";
      fetch(page, { method: "HEAD" }).then(function (r) { if (r.ok) location.replace(page); }).catch(function () {});

      var name = SSCsc.nice(c.centre_name), type = TYPE[c.centre_type] || c.centre_type || "सेवा केंद्र", esc = SSCsc.esc;
      var where = SSCsc.uniq([c.city, c.district]);
      $("c-title").textContent = name + ": " + type + (c.city || c.district ? ", " + (c.city || c.district) : "");
      document.title = name + ", " + where + " | SarkariSewa India";
      status.hidden = true;

      // Badges
      var b = ['<span class="b-ok">✓ SarkariSewa पर सत्यापित</span>'], on = SSCsc.openNow(c.working_hours), sn = SSCsc.since(c.years_of_operation);
      if (on) b.push('<span class="' + (on.open ? "b-open" : "b-closed") + '">' + (on.open ? "🟢 " : "🔴 ") + esc(on.label) + "</span>");
      if (sn) b.push("<span>🗓️ " + esc(sn) + "</span>");
      if ((c.remote_services || []).length) b.push("<span>🏠 घर बैठे सेवा</span>");
      if (c.home_visit) b.push("<span>🚶 घर पर आकर सेवा</span>");
      if (where) b.push("<span>📍 " + esc(where) + "</span>");
      $("c-badges").innerHTML = b.join("");

      var live = $("c-live");
      live.innerHTML = SSCsc.full(c, type);
      live.setAttribute("data-app", id);
      SSCsc.wire(live);

      var g = SSCsc.guides(SSCsc.allServices(c));
      if (g.length) {
        $("c-guides").innerHTML = g.map(function (x) { return '<a class="card" href="' + x.href + '"><span class="emoji" aria-hidden="true">📄</span><strong>' + esc(x.label) + "</strong><small>" + esc(x.text) + " →</small></a>"; }).join("");
        $("taiyari").hidden = false;
      }
      if (SSCsc.kindOf(c) === "ja") {
        $("dhyan").hidden = true;
        $("ja-info").hidden = false;
        var jl = $("c-district-link"); jl.href = "/service/jan-aushadhi-store-locator.html"; jl.textContent = "पास के दूसरे जन औषधि केंद्र खोजें →";
        $("c-district").querySelector("h2").textContent = "और जन औषधि केंद्र";
        $("c-district").hidden = false;
        if (c.district) { $("v-others-title").textContent = c.district + " में और सत्यापित केंद्र"; SSCsc.district($("v-others"), { names: [c.district], state: c.state, exclude: id, kind: "ja" }); }
      } else if (c.district) {
        $("v-others-title").textContent = c.district + " में और सत्यापित केंद्र";
        SSCsc.district($("v-others"), { names: [c.district], state: c.state, exclude: id, kind: SSCsc.kindOf(c) });
        fetch("/csc-centre/districts.json").then(function (r) { return r.json(); }).then(function (rows) {
          var d = norm(c.district), hit = rows.filter(function (r) { return r[0].indexOf(d) !== -1; })[0];
          var a = $("c-district-link");
          if (hit) { a.href = hit[1]; a.textContent = hit[2] + " के सभी CSC सेंटर देखें →"; }
          else a.textContent = "अपनी लोकेशन या PIN से नज़दीकी CSC खोजें →";
          $("c-district").hidden = false;
        }).catch(function () {});
      }

      // Sidebar: contact, map, share
      var ph = String(c.public_phone || "").replace(/\D/g, "").slice(-10), wa = String(c.public_whatsapp || "").replace(/\D/g, "").slice(-10);
      var waText = encodeURIComponent("नमस्ते, मैंने आपका केंद्र SarkariSewa India (sarkarisewaindia.com) पर देखा। मुझे इस काम के लिए मदद चाहिए: ");
      var side = $("c-contact");
      side.setAttribute("data-app", id);
      side.insertAdjacentHTML("beforeend", (ph ? '<a class="cta" href="tel:+91' + ph + '" data-act="call">📞 कॉल करें</a>' : "") + (wa ? '<a class="cta secondary" href="https://wa.me/91' + wa + "?text=" + waText + '" data-act="whatsapp" target="_blank" rel="noopener nofollow">💬 WhatsApp</a>' : ""));
      SSCsc.wire(side);
      var aq = c.full_address ? [c.full_address, c.city, c.district, c.state, c.pincode].filter(Boolean).join(", ") : "";
      var msrc = c.latitude && c.longitude ? "https://maps.google.com/maps?q=" + c.latitude + "," + c.longitude + "&z=16&output=embed" : aq ? "https://maps.google.com/maps?q=" + encodeURIComponent(aq) + "&z=15&output=embed" : "";
      if (msrc) { $("c-map").querySelector("iframe").src = msrc; $("c-map").hidden = false; if (!(c.latitude && c.longitude)) $("c-map").insertAdjacentHTML("beforeend", '<p class="hint">पते के हिसाब से अनुमानित जगह; सही रास्ते के लिए केंद्र को कॉल करें।</p>'); }
      var url = "https://sarkarisewaindia.com/csc-centre.html?id=" + encodeURIComponent(id);
      $("c-wa-share").href = "https://wa.me/?text=" + encodeURIComponent(name + " (" + where + "): सेवाएं, समय और संपर्क\n" + url);
      $("c-share").addEventListener("click", function () {
        if (navigator.share) { navigator.share({ title: name, url: url }).catch(function () {}); return; }
        (navigator.clipboard ? navigator.clipboard.writeText(url) : Promise.reject()).then(function () { $("c-share").textContent = "✓ लिंक कॉपी हो गया"; }, function () { prompt("लिंक कॉपी करें:", url); });
      });
      $("c-edit").href = "/csc-edit.html?id=" + encodeURIComponent(id);
      $("c-side").hidden = false;
      SSCsc.log(id, "profile");
    }).catch(function () { status.textContent = "जानकारी लोड नहीं हो सकी। थोड़ी देर बाद फिर कोशिश करें।"; });
  })();
  </script>
</Base>

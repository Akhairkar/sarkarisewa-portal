---
// Public profile of an approved CSC claim: /csc-centre.html?id=<application id>.
// Filled in the browser from the public view; noindex because each profile is
// one dynamic page. The owner can report customers they got through the site.
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
const crumbs = [{ label: "होम", href: "/" }, { label: "CSC सेंटर", href: "/tools/csc-locator.html" }, { label: "केंद्र की जानकारी" }];
---
<Base title="CSC केंद्र की जानकारी | SarkariSewa India" description="SarkariSewa पर सत्यापित CSC / जन सेवा केंद्र: पता, सेवाएं, समय और संपर्क।" breadcrumbs={crumbs} noindex schemaType="WebPage">
  <Breadcrumbs items={crumbs} />
  <article class="page">
    <div>
      <h1 id="c-title">CSC केंद्र की जानकारी</h1>
      <p class="csc-status" id="c-status">जानकारी लोड हो रही है…</p>
      <ul class="csc-list" id="c-card" style="grid-template-columns:minmax(0,1fr)"></ul>

      <section class="section" id="sevayen" hidden>
        <h2>मिलने वाली सेवाएं</h2>
        <ul class="checklist" id="c-services"></ul>
      </section>
      <p id="c-edit" hidden><a href="#">इस केंद्र के संचालक हैं? जानकारी बदलें →</a></p>

      <div class="claim-cta">
        <p><strong>आप भी CSC / जन सेवा केंद्र चलाते हैं?</strong> अपना केंद्र SarkariSewa पर फ्री में जोड़ें।</p>
        <a class="cta" href="/claim-your-csc.html">फ्री में केंद्र जोड़ें</a>
      </div>
      <p class="notice">SarkariSewa India एक निजी वेबसाइट है। केंद्र की जानकारी संचालक ने खुद दी है; हम संचालक से बात करके इसे जांचते हैं, पर केंद्र की सेवा, फीस या व्यवहार की ज़िम्मेदारी हमारी नहीं है। सरकारी फीस से ज़्यादा पैसा मांगा जाए तो रसीद लें और शिकायत करें।</p>
    </div>
  </article>
  <script is:inline src="/assets/js/csc-listing.js"></script>
  <script is:inline>
  (function () {
    var id = new URLSearchParams(location.search).get("id") || "";
    var status = document.getElementById("c-status");
    if (!/^[A-Za-z0-9-]{4,50}$/.test(id)) { status.textContent = "केंद्र नहीं मिला। CSC लोकेटर से खोजें।"; return; }
    var slug = function (t) { return String(t || "").toLowerCase().normalize("NFKD").replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "").slice(0, 60); };
    SSCsc.one(id).then(function (c) {
      if (c) {
        var num = (id.match(/\d{4,}$/) || [slug(id)])[0];
        var page = "/csc-centre/" + [slug(c.centre_name), slug(c.district), num].filter(Boolean).join("-") + ".html";
        fetch(page, { method: "HEAD" }).then(function (r) { if (r.ok) location.replace(page); }).catch(function () {});
      }
      if (!c) { status.textContent = "यह केंद्र अभी सत्यापित नहीं है या हटाया जा चुका है।"; return; }
      document.getElementById("c-title").textContent = c.centre_name + (c.district ? ", " + c.district : "");
      document.title = c.centre_name + " | SarkariSewa India";
      status.textContent = "";
      var ul = document.getElementById("c-card");
      ul.innerHTML = SSCsc.card(c, { profile: false });
      SSCsc.wire(ul);
      SSCsc.log(id, "profile");
      var sv = [].concat((c.remote_services || []).map(function (x) { return "🏠 घर बैठे: " + x; }), c.online_services || [], c.offline_services || [], c.custom_services || []).filter(Boolean);
      if (sv.length) {
        document.getElementById("c-services").innerHTML = sv.map(function (x) { return "<li>" + SSCsc.esc(x) + "</li>"; }).join("");
        document.getElementById("sevayen").hidden = false;
      }
      var ed = document.getElementById("c-edit"); ed.querySelector("a").href = "/csc-edit.html?id=" + encodeURIComponent(id); ed.hidden = false;
    }).catch(function () { status.textContent = "जानकारी लोड नहीं हो सकी। थोड़ी देर बाद फिर कोशिश करें।"; });

  })();
  </script>
</Base>

---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Faq from "../../components/Faq.astro";
import Explore from "../../components/Explore.astro";
import { STATES, DOCS } from "../../data/site";
import { exists } from "../../lib/repo";

const states = STATES.filter((s) => exists(`states/${s.slug}.html`)).map((s) => ({
  ...s,
  count: DOCS.filter((d) => exists(`states/${s.slug}-${d.slug}.html`)).length,
}));
const crumbs = [{ label: "होम", href: "/" }, { label: "राज्य" }];
const faq = [
  { q: "राज्य के पेज पर क्या मिलेगा?", a: "हर राज्य के पेज पर उस राज्य के प्रमाण पत्र (जन्म, जाति, आय, निवास), कार्ड (राशन, लेबर, सीनियर सिटीजन, वोटर ID), रोज़गार पंजीकरण, ड्राइविंग लाइसेंस और राज्य के official पोर्टल की गाइड है।" },
  { q: "मेरा राज्य का पोर्टल कौन सा है?", a: "ज़्यादातर राज्यों में प्रमाण पत्र e-District पोर्टल से बनते हैं, जिसका नाम हर राज्य में अलग है (जैसे JharSewa, RTPS, आपले सरकार)। अपने राज्य के पेज पर सही नाम और लिंक देखें।" },
];
---
<Base
  title="राज्य अनुसार सरकारी सेवाएं: सभी 36 राज्य और केंद्र शासित प्रदेश | SarkariSewa India"
  description="अपना राज्य चुनें: राशन कार्ड, लेबर कार्ड, सीनियर सिटीजन कार्ड, जन्म, जाति, आय और निवास प्रमाण पत्र, वोटर ID और रोज़गार पंजीकरण की राज्य अनुसार गाइड।"
  breadcrumbs={crumbs}
  faq={faq}
  schemaType="WebPage"
>
  <Breadcrumbs items={crumbs} />
  <section class="hero">
    <h1>अपना राज्य चुनें</h1>
    <p class="page-intro">प्रमाण पत्र और कार्ड राज्य सरकारें बनाती हैं, इसलिए हर राज्य का तरीका अलग है। अपने राज्य की सभी सेवाएं एक जगह देखें।</p>
  </section>
  <section class="block">
    <div class="state-grid">
      {states.map((s) => <a href={`/states/${s.slug}.html`}>{s.hi}<small>{s.name} · {s.count} गाइड</small></a>)}
    </div>
  </section>
  <section class="section">
    <h2>दस्तावेज़ के अनुसार देखें</h2>
    <ul class="chips">{DOCS.map((d) => <li><a href={`/documents/#${d.slug}`}>{d.emoji} {d.title}</a></li>)}</ul>
  </section>
  <Faq items={faq} />
  <Explore />
</Base>

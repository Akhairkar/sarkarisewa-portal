---
// Qualification-wise government jobs: one page for "10th / 12th / graduate /
// ITI pass sarkari naukri" searches. A small finder (qualification, age,
// gender) filters recurring national recruitments; every exam is also listed
// in plain HTML under its qualification heading. Age, qualification and pay
// come from each exam's latest official notice: src/data/job-finder.ts.
// Open notifications on our site (src/data/jobs.ts) are shown on top.
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Faq from "../../components/Faq.astro";
import Explore from "../../components/Explore.astro";
import { FINDER_JOBS, QUALS, FINDER_VERIFIED, type Qual } from "../../data/job-finder";
import { JOBS } from "../../data/jobs";
import { exists, pageTitle } from "../../lib/repo";

const crumbs = [{ label: "होम", href: "/" }, { label: "सरकारी नौकरी", href: "/jobs/index.html" }, { label: "योग्यता अनुसार" }];
const today = new Date().toISOString().slice(0, 10);
const open = JOBS.filter((j) => j.last >= today && exists(`jobs/${j.slug}.html`))
  .map((j) => ({ ...j, title: pageTitle(`jobs/${j.slug}.html`).split(/[:|]/)[0].trim() || j.slug }));
const order: Qual[] = ["8th", "10th", "12th", "iti", "diploma", "graduate", "engineering", "nursing", "pg"];
// Each exam is listed once, under the lowest qualification it accepts.
const lowest = (qs: Qual[]) => order.find((q) => qs.includes(q));
const sections = order.map((q) => ({ q, label: QUALS[q], list: FINDER_JOBS.filter((j) => lowest(j.quals) === q) })).filter((s) => s.list.length);
const pageOk = (p?: string) => !!p && exists(p.replace(/^\//, ""));
const faq = [
  { q: "10वीं पास के लिए कौन सी सरकारी नौकरियां हैं?", a: `${FINDER_JOBS.filter((j) => j.quals.includes("10th")).map((j) => j.name).slice(0, 8).join(", ")} जैसी भर्तियां 10वीं पास के लिए आती हैं। ऊपर के फॉर्म में "10वीं" चुनकर अपनी उम्र डालें।` },
  { q: "12वीं पास सरकारी नौकरी कौन सी हैं?", a: `${FINDER_JOBS.filter((j) => j.quals.includes("12th")).map((j) => j.name).slice(0, 8).join(", ")} आदि। 12वीं पास 10वीं वाली भर्तियों में भी आवेदन कर सकते हैं, जब तक नोटिफिकेशन में ऊपरी योग्यता पर रोक न हो।` },
  { q: "ग्रेजुएट के लिए सरकारी नौकरी?", a: `${FINDER_JOBS.filter((j) => j.quals.includes("graduate")).map((j) => j.name).slice(0, 8).join(", ")} जैसी भर्तियां ग्रेजुएट के लिए होती हैं।` },
  { q: "उम्र सीमा में छूट कितनी मिलती है?", a: "आम तौर पर केंद्र की भर्तियों में OBC को 3 साल, SC/ST को 5 साल की छूट होती है, पर हर भर्ती की छूट और कट-ऑफ तारीख उसके नोटिफिकेशन में लिखी होती है। हर कार्ड में नोटिफिकेशन के अनुसार छूट लिखी है।" },
  { q: "क्या यह जानकारी पक्की है?", a: `हर भर्ती की योग्यता और उम्र उसके पिछले आधिकारिक नोटिफिकेशन से ली गई है (${FINDER_VERIFIED} को जांचा)। नई भर्ती में नियम बदल सकते हैं, इसलिए आवेदन से पहले नया नोटिफिकेशन ज़रूर पढ़ें।` },
];
---
<Base title="10वीं, 12वीं, ग्रेजुएट पास सरकारी नौकरी 2026: योग्यता और उम्र से नौकरी खोजें" description={`10वीं पास, 12वीं पास, ITI, डिप्लोमा और ग्रेजुएट के लिए ${FINDER_JOBS.length} सरकारी भर्तियां: योग्यता, उम्र सीमा, वेतन और कब आती हैं। अपनी पढ़ाई और उम्र डालें, अपनी नौकरियां देखें।`} breadcrumbs={crumbs} faq={faq}>
  <Breadcrumbs items={crumbs} />
  <article class="page">
    <div>
      <h1>10वीं, 12वीं, ग्रेजुएट पास सरकारी नौकरी 2026: अपनी योग्यता से खोजें</h1>
      <div class="meta-row"><span class="verified">✓ नोटिफिकेशन से जांचा: {FINDER_VERIFIED}</span></div>
      <section class="answer" aria-labelledby="answer-title">
        <p class="answer-title" id="answer-title">सीधा जवाब</p>
        <p class="answer-lead">नीचे अपनी <strong>पढ़ाई</strong> और <strong>उम्र</strong> चुनें, तुरंत दिखेगा कि किन सरकारी भर्तियों के लिए आप योग्य हो सकते हैं। हर भर्ती की योग्यता, उम्र सीमा और वेतन उसके पिछले <strong>आधिकारिक नोटिफिकेशन</strong> से लिया गया है। अभी खुली भर्तियां सबसे ऊपर हैं।</p>
      </section>

      {open.length > 0 && (
        <section class="section" id="open">
          <h2>🔔 अभी खुली भर्तियां</h2>
          <ul class="jf-open">{open.map((j) => <li><a href={`/jobs/${j.slug}.html`}>{j.title}</a> <small>आखिरी तारीख: {j.lastNote ?? j.last.split("-").reverse().join("/")}</small></li>)}</ul>
        </section>
      )}

      <section class="section jf" id="finder" aria-labelledby="jf-title">
        <h2 id="jf-title">अपनी योग्यता से नौकरी खोजें</h2>
        <form class="jf-form">
          <label>आपकी पढ़ाई<select name="q"><option value="">सब दिखाएं</option>{order.map((q) => <option value={q}>{QUALS[q]}</option>)}</select></label>
          <label>आपकी उम्र (साल)<input name="age" type="number" min="14" max="60" inputmode="numeric" placeholder="जैसे: 21" /></label>
          <label>आप<select name="g"><option value="">कोई भी</option><option value="male">पुरुष</option><option value="female">महिला</option></select></label>
        </form>
        <p class="jf-count" role="status"></p>
        <p class="jf-note">उम्र सामान्य वर्ग की सीमा से जांची जाती है; OBC/SC/ST/पूर्व सैनिक आदि को छूट मिलती है (हर कार्ड में लिखी)। <a href="/exam-age-calculator.html">कट-ऑफ तारीख पर सही उम्र निकालें</a>।</p>
      </section>

      {sections.map((s) => (
        <section class="section jf-sec" id={`q-${s.q}`}>
          <h2>{s.label} सरकारी नौकरी</h2>
          {s.list.map((j) => (
            <div class="jf-card" data-quals={j.quals.join(" ")} data-min={j.age[0]} data-max={j.age[1]} data-g={j.gender ?? ""}>
              <h3>{j.name} <small>({j.body})</small></h3>
              <dl class="facts">
                <div><dt>योग्यता</dt><dd>{j.qualText}</dd></div>
                <div><dt>उम्र</dt><dd>{j.age[0]}–{j.age[1]} साल <small>({j.ageNote})</small></dd></div>
                {j.pay && <div><dt>वेतन</dt><dd>{j.pay}</dd></div>}
                <div><dt>कब आती है</dt><dd>{j.cycle}</dd></div>
                {j.gender && <div><dt>किसके लिए</dt><dd>{j.gender === "female" ? "सिर्फ महिलाएं" : "सिर्फ पुरुष"}</dd></div>}
              </dl>
              <div class="st-cta">
                {pageOk(j.page) && <a class="cta secondary" href={j.page}>पूरी जानकारी</a>}
                <a class="cta secondary" href={j.official} target="_blank" rel="noopener nofollow">आधिकारिक वेबसाइट ↗</a>
              </div>
              <small class="jf-src">स्रोत: {j.source}</small>
            </div>
          ))}
        </section>
      ))}

      <div class="callout info"><p>SarkariSewa India एक निजी वेबसाइट है, सरकारी नहीं। योग्यता और उम्र पिछले नोटिफिकेशन के अनुसार है; नई भर्ती में बदल सकती है। आवेदन से पहले आधिकारिक नोटिफिकेशन ज़रूर पढ़ें।</p></div>
      <Faq items={faq} />
      <Explore />
    </div>
  </article>
  <script is:inline>
    (function () {
      var f = document.querySelector(".jf-form"); if (!f) return;
      // Which minimum qualifications a reader's qualification satisfies.
      var OK = { "8th": ["8th"], "10th": ["8th", "10th"], "12th": ["8th", "10th", "12th"], iti: ["8th", "10th", "iti"], diploma: ["8th", "10th", "diploma"],
        graduate: ["8th", "10th", "12th", "graduate"], engineering: ["8th", "10th", "12th", "graduate", "engineering", "diploma"], nursing: ["8th", "10th", "12th", "nursing"], pg: ["8th", "10th", "12th", "graduate", "pg"] };
      var cards = document.querySelectorAll(".jf-card"), count = document.querySelector(".jf-count");
      function run() {
        var q = f.q.value, age = parseInt(f.age.value, 10), g = f.g.value, n = 0;
        cards.forEach(function (c) {
          var quals = c.dataset.quals.split(" ");
          var ok = (!q || quals.some(function (x) { return OK[q].indexOf(x) > -1; }))
            && (!age || (age >= +c.dataset.min && age <= +c.dataset.max))
            && (!g || !c.dataset.g || c.dataset.g === g);
          c.hidden = !ok;
          if (ok) n++;
        });
        document.querySelectorAll(".jf-sec").forEach(function (s) { s.hidden = !s.querySelector(".jf-card:not([hidden])"); });
        count.textContent = q || age || g ? "आपके लिए " + n + " भर्तियां मिलीं" + (age ? " (सामान्य वर्ग की उम्र सीमा से)" : "") + "।" : "";
        try { if (window.gtag && (q || age)) gtag("event", "job_finder", { qual: q, age: age || "" }); } catch (e) {}
      }
      f.addEventListener("change", run); f.addEventListener("input", run);
    })();
  </script>
  <style is:global>
    .jf-form { display: grid; gap: 10px; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); }
    .jf-form label { display: grid; gap: 4px; font-weight: 700; font-size: .92rem; }
    .jf-form select, .jf-form input { padding: 10px; border: 1px solid var(--c-line); border-radius: var(--radius-sm, 8px); font: inherit; background: var(--c-bg, #fff); color: inherit; }
    .jf-count { font-weight: 800; margin: 10px 0 0; min-height: 1.2em; }
    .jf-note { font-size: .88rem; color: var(--c-muted); }
    .jf-open li { margin: 4px 0; }
    .jf-card { border: 1px solid var(--c-line); border-radius: var(--radius, 12px); padding: 14px 16px; margin: 0 0 12px; }
    .jf-card h3 { margin: 0 0 6px; font-size: 1.05rem; }
    .jf-card h3 small { color: var(--c-muted); font-weight: 600; }
    .jf-src { display: block; margin-top: 6px; color: var(--c-muted); font-size: .78rem; }
    .st-cta { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
    .st-cta .cta { margin: 0; }
  </style>
</Base>

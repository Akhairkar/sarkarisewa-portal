---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import SearchBox from "../../components/SearchBox.astro";
import CardGrid from "../../components/CardGrid.astro";
import Faq from "../../components/Faq.astro";
import Explore from "../../components/Explore.astro";
import { services, exists, pageTitle } from "../../lib/repo";

const toCard = (emoji: string) => (s: { href: string; title: string; text: string }) => ({ href: s.href, emoji, title: s.title, text: s.text.slice(0, 90) });
const central = services(["government-schemes"]).map(toCard("🏛️"));
const health = services(["health"]).map(toCard("🏥"));
const mpbcdc = services(["mpbcdc-schemes"]).map(toCard("🏦"));

// State schemes: service/<state-prefix>-*.html pages
const STATE_SCHEMES: [string, string, string][] = [
  ["आंध्र प्रदेश", "ap-thalliki-vandanam", "👩‍👧"], ["अरुणाचल प्रदेश", "arunachal-cmaay-scheme", "🏥"], ["अरुणाचल प्रदेश", "arunachal-dulari-kanya-scheme", "👧"],
  ["अरुणाचल प्रदेश", "arunachal-deen-dayal-upadhyaya-bunkar-yojana", "🧵"], ["असम", "as-orunodoi-scheme", "👩"], ["बिहार", "br-kanya-utthan-yojana", "👧"],
  ["छत्तीसगढ़", "cg-mahtari-vandan-yojana", "👩"], ["गोवा", "goa-dayanand-social-security-scheme--dsss-", "👴"], ["गोवा", "goa-deen-dayal-swasthya-seva-yojana--ddssy-", "🏥"],
  ["गोवा", "goa-griha-aadhar-scheme", "🏠"], ["गुजरात", "gj-vahli-dikri-yojana", "👧"], ["हिमाचल प्रदेश", "hp-himcare-scheme", "🏥"],
  ["हिमाचल प्रदेश", "hp-mukhya-mantri-swawalamban-yojana", "💼"], ["हिमाचल प्रदेश", "hp-sahara-yojana", "🤝"], ["झारखंड", "jh-maiya-samman-yojana", "👩"],
  ["कर्नाटक", "ka-gruha-lakshmi-yojana", "👩"], ["केरल", "kl-social-security-pension", "👴"], ["मणिपुर", "manipur-chief-minister-widow-pension-scheme", "🤝"],
  ["मणिपुर", "manipur-cmht-scheme", "🏥"], ["मणिपुर", "manipur-lairik-yengminnasi-scheme", "📚"], ["मेघालय", "meghalaya-focus-scheme", "🌾"],
  ["मेघालय", "meghalaya-mhis-scheme", "🏥"], ["महाराष्ट्र", "mh-ladki-bahin-yojana", "👩"], ["महाराष्ट्र", "mh-bandhkam-kamgar-yojana", "👷"],
  ["मिज़ोरम", "mizoram-bpl-housing-scheme", "🏠"], ["मिज़ोरम", "mizoram-chief-minister-rural-housing-scheme", "🏠"], ["मध्य प्रदेश", "mp-ladli-laxmi-yojana", "👧"],
  ["नागालैंड", "nagaland-cmhis-scheme", "🏥"], ["ओडिशा", "od-subhadra-yojana", "👩"], ["पंजाब", "pb-ashirwad-scheme", "💍"],
  ["राजस्थान", "rj-chiranjeevi-yojana", "🏥"], ["सिक्किम", "sikkim-aama-yojana", "👩"], ["सिक्किम", "sikkim-sgay-yojana", "🏠"],
  ["सिक्किम", "sikkim-vatsalya-yojana", "👶"], ["तेलंगाना", "tg-mahalakshmi-scheme", "👩"], ["त्रिपुरा", "tripura-yuba-yogayog-yojana", "📱"],
  ["उत्तर प्रदेश", "up-kanya-sumangala-yojana", "👧"], ["पश्चिम बंगाल", "wb-lakshmir-bhandar", "👩"],
];
const stateSchemes = STATE_SCHEMES.filter(([, slug]) => exists(`service/${slug}.html`)).map(([state, slug, emoji]) => ({
  href: `/service/${slug}.html`, emoji, title: pageTitle(`service/${slug}.html`).split(/[:–|]/)[0].trim() || slug, text: state,
}));

const crumbs = [{ label: "होम", href: "/" }, { label: "सरकारी योजनाएं" }];
const faq = [
  { q: "मेरे लिए कौन सी सरकारी योजना है, कैसे पता करें?", a: "Eligibility Checker में अपनी उम्र, राज्य, आय और श्रेणी डालें, वह बताएगा कि आप किन योजनाओं के लिए पात्र हो सकते हैं। फिर हर योजना के पेज पर official link से आवेदन करें।" },
  { q: "योजना का पैसा खाते में नहीं आया तो क्या करें?", a: "सबसे पहले बैंक में जांचें कि खाता आधार से लिंक (DBT/NPCI mapping) है और KYC पूरी है। फिर योजना के official पोर्टल पर आवेदन का स्टेटस देखें।" },
  { q: "क्या योजना के लिए किसी को पैसे देने होते हैं?", a: "सरकारी योजनाओं में आवेदन आमतौर पर मुफ्त होता है। CSC पर ऑपरेटर तय सेवा शुल्क ले सकता है। योजना के नाम पर पैसे मांगने वालों से सावधान रहें।" },
];
---
<Base
  title="सरकारी योजनाएं 2026: केंद्र और राज्य की योजनाओं की लिस्ट | SarkariSewa India"
  description="PM Kisan, आयुष्मान, आवास, उज्ज्वला से लेकर लाडकी बहिन, मैया सम्मान जैसी राज्य योजनाएं: पात्रता, आवेदन और स्टेटस की गाइड official links के साथ।"
  breadcrumbs={crumbs}
  faq={faq}
  schemaType="WebPage"
>
  <Breadcrumbs items={crumbs} />
  <section class="hero">
    <h1>सरकारी योजनाएं</h1>
    <p class="page-intro">केंद्र और राज्य सरकार की योजनाएं: कौन पात्र है, कितना फायदा है, आवेदन कैसे करें और पैसा न आए तो क्या करें।</p>
    <SearchBox placeholder="जैसे: PM Kisan, लाडकी बहिन, आवास योजना…" />
    <p><a class="cta" style="display:inline-block" href="/tools/eligibility-checker.html">✅ मैं किन योजनाओं के लिए पात्र हूं?</a></p>
  </section>

  <CardGrid title="केंद्र सरकार की योजनाएं" cards={central} id="central" />
  <CardGrid title="राज्य सरकार की योजनाएं" cards={stateSchemes} id="state" />
  <CardGrid title="स्वास्थ्य योजनाएं और सेवाएं" cards={health} id="health" />
  {mpbcdc.length > 0 && <CardGrid title="महाराष्ट्र: MPBCDC लोन योजनाएं" cards={mpbcdc} id="mpbcdc" />}

  <Faq items={faq} />
  <Explore />
</Base>

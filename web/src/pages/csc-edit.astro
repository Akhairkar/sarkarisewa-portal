---
// Owner edit for a verified CSC listing. Login = application id + owner mobile
// + edit code (sent by SarkariSewa on WhatsApp). Reads/writes only through the
// csc_owner_get / csc_owner_update database functions, which check the code.
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { SUPABASE_URL, SUPABASE_ANON_KEY } from "../lib/supabase-public";

const ONLINE = ["Aadhaar सेवा", "PAN कार्ड", "आयुष्मान कार्ड", "प्रमाण पत्र (जाति/आय/निवास)", "राशन कार्ड", "पेंशन / योजना फॉर्म", "बिजली/पानी बिल", "बैंकिंग / पैसा भेजना", "बीमा", "नौकरी / परीक्षा फॉर्म", "ई-श्रम / लेबर कार्ड", "PM-Kisan", "पासपोर्ट / ड्राइविंग लाइसेंस आवेदन", "GST / ITR"];
const REMOTE = ONLINE.filter((s) => !s.startsWith("Aadhaar"));
const OFFLINE = ["फोटोकॉपी", "प्रिंटिंग", "स्कैनिंग", "लैमिनेशन", "पासपोर्ट फोटो", "टाइपिंग / डॉक्यूमेंट सहायता"];
const crumbs = [{ label: "होम", href: "/" }, { label: "CSC सेंटर", href: "/tools/csc-locator.html" }, { label: "केंद्र की जानकारी बदलें" }];
---
<Base title="अपने केंद्र की जानकारी बदलें | SarkariSewa India" description="SarkariSewa पर सत्यापित CSC / जन सेवा केंद्र के संचालक अपनी सेवाएं, समय और संपर्क खुद बदलें।" breadcrumbs={crumbs} noindex schemaType="WebPage">
  <Breadcrumbs items={crumbs} />
  <article class="page">
    <div>
      <h1>अपने केंद्र की जानकारी बदलें</h1>
      <p class="page-intro">यह पेज सिर्फ केंद्र के संचालक के लिए है। पासवर्ड आपको SarkariSewa India के WhatsApp पर भेजा गया है। इसे किसी से साझा न करें। नीचे बस बटन दबाकर अपनी सेवाएं चुनें और बॉक्स में जानकारी लिखें।</p>

      <form class="claim-form" id="login" novalidate>
        <fieldset>
          <legend>लॉगिन</legend>
          <div class="grid2">
            <div><label for="l-app">आवेदन नंबर</label><input type="text" id="l-app" placeholder="CSC-2026-123456" maxlength="50" /></div>
            <div><label for="l-mob">संचालक का मोबाइल (जो फॉर्म में दिया था)</label><input type="tel" id="l-mob" inputmode="numeric" maxlength="10" /></div>
          </div>
          <label for="l-code">पासवर्ड (WhatsApp पर मिला)</label><input type="text" id="l-code" maxlength="20" autocomplete="off" autocapitalize="characters" />
          <button type="submit" class="cta" style="margin-top:12px">खोलें</button>
          <p class="claim-msg" id="l-out" role="status"></p>
          <p class="hint">पासवर्ड नहीं है या भूल गए? SarkariSewa India के WhatsApp पर अपना आवेदन नंबर भेजें या sarkarisewaindia@gmail.com पर मेल करें।</p>
        </fieldset>
      </form>

      <p class="hint" id="who" hidden></p>
      <form class="claim-form" id="edit" hidden novalidate>
        <fieldset>
          <legend>केंद्र</legend>
          <div class="grid2">
            <div><label for="e-name">केंद्र का नाम</label><input type="text" id="e-name" name="centre_name" maxlength="200" /></div>
            <div><label for="e-years">कितने साल से चल रहा है</label><input type="number" id="e-years" name="years_of_operation" min="0" max="60" /></div>
          </div>
          <label for="e-about">केंद्र के बारे में (ग्राहकों के लिए 2-4 लाइन: क्या खास है, कौन से काम करते हैं)</label>
          <textarea id="e-about" name="about" maxlength="1000"></textarea>
        </fieldset>
        <fieldset>
          <legend>पता</legend>
          <p class="hint" id="e-where"></p>
          <label for="e-addr">पूरा पता</label><textarea id="e-addr" name="full_address" maxlength="600"></textarea>
          <div class="grid2">
            <div><label for="e-loc">मोहल्ला / इलाका</label><input type="text" id="e-loc" name="locality" maxlength="150" /></div>
            <div><label for="e-city">शहर / गांव</label><input type="text" id="e-city" name="city" maxlength="120" /></div>
            <div><label for="e-pin">PIN कोड</label><input type="text" id="e-pin" name="pincode" inputmode="numeric" maxlength="6" /></div>
          </div>
          <button type="button" class="more-btn" id="e-gps">📍 अभी केंद्र पर हूं: नक्शे की लोकेशन अपडेट करें</button>
          <p class="hint" id="e-gps-out"></p>
          <label class="inline"><input type="checkbox" name="show_address" /> पूरा पता और नक्शा दिखाएं</label>
        </fieldset>
        <fieldset>
          <legend>सेवाएं और समय</legend>
          <label>🏢 केंद्र पर आकर होने वाली सेवाएं</label>
          <div class="checks" id="e-online">{ONLINE.map((s) => <label><input type="checkbox" name="online_services" value={s} /> {s}</label>)}</div>
          <div class="checks" id="e-offline" style="margin-top:8px">{OFFLINE.map((s) => <label><input type="checkbox" name="offline_services" value={s} /> {s}</label>)}</div>
          <label>🏠 घर बैठे होने वाली सेवाएं <span class="hint">(WhatsApp/फोन पर कागज़ लेकर)</span></label>
          <div class="checks" id="e-remote">{REMOTE.map((s) => <label><input type="checkbox" name="remote_services" value={s} /> {s}</label>)}</div>
          <label for="e-custom">और सेवाएं (कॉमा से अलग)</label><input type="text" id="e-custom" name="custom" maxlength="300" />
          <div class="grid2">
            <div><label for="e-open">खुलने का समय</label><input type="text" id="e-open" name="open" maxlength="20" placeholder="9:00 AM" /></div>
            <div><label for="e-close">बंद होने का समय</label><input type="text" id="e-close" name="close" maxlength="20" placeholder="7:00 PM" /></div>
          </div>
          <label for="e-days">किन दिनों खुला</label><input type="text" id="e-days" name="days" maxlength="60" placeholder="सोमवार-शनिवार" />
          <label class="inline"><input type="checkbox" name="show_hours" /> समय दिखाएं</label>
          <label class="inline"><input type="checkbox" name="home_visit" /> घर पर जाकर सेवा देते हैं</label>
        </fieldset>
        <fieldset>
          <legend>ग्राहकों के लिए संपर्क</legend>
          <div class="grid2">
            <div><label for="e-ph">कॉल नंबर</label><input type="tel" id="e-ph" name="public_phone" inputmode="numeric" maxlength="10" /></div>
            <div><label for="e-wa">WhatsApp नंबर</label><input type="tel" id="e-wa" name="public_whatsapp" inputmode="numeric" maxlength="10" /></div>
          </div>
          <label for="e-mail">ईमेल (वैकल्पिक)</label><input type="email" id="e-mail" name="public_email" maxlength="254" />
        </fieldset>
        <button type="submit" class="cta">बदलाव सेव करें</button>
        <p class="claim-msg" id="e-out" role="status" aria-live="polite"></p>
        <p class="hint">सेव होते ही आपके केंद्र का पेज अपने आप खुलेगा और उस पर नई जानकारी दिखेगी।</p>
      </form>

      <form class="claim-form" id="photo" hidden novalidate>
        <fieldset>
          <legend>केंद्र की फोटो (वैकल्पिक)</legend>
          <p class="hint">केंद्र के बाहर से एक साफ फोटो लगाएं, जिसमें बोर्ड/नाम दिखे। फोटो लगते ही आपके पेज पर दिख जाएगी। गलत या किसी और की फोटो हटा दी जाएगी।</p>
          <img id="ph-img" class="csc-photo" alt="केंद्र की फोटो" hidden />
          <label class="more-btn" for="ph-file" style="display:inline-block;cursor:pointer">📷 फोटो चुनें / खींचें</label>
          <input type="file" id="ph-file" accept="image/*" hidden />
          <button type="button" class="more-btn" id="ph-del" hidden>🗑️ फोटो हटाएं</button>
          <p class="claim-msg" id="ph-out" role="status" aria-live="polite"></p>
        </fieldset>
      </form>

      <form class="claim-form" id="fb" hidden novalidate>
        <fieldset>
          <legend>SarkariSewa से ग्राहक मिले?</legend>
          <p>हमें बताएं कि हमारी साइट से कितने लोग आए। ग्राहक WhatsApp पर "SarkariSewa India पर देखा" लिखकर आते हैं।</p>
          <div class="grid2">
            <div><label for="fb-n">इस हफ्ते/महीने कितने ग्राहक आए</label><input type="number" id="fb-n" min="0" max="10000" /></div>
          </div>
          <label for="fb-msg">कुछ और कहना हो</label><textarea id="fb-msg" maxlength="1000"></textarea>
          <button type="submit" class="cta secondary" style="margin-top:12px">भेजें</button>
          <p class="claim-msg" id="fb-out" role="status"></p>
        </fieldset>
      </form>
    </div>
  </article>

  <script is:inline define:vars={{ url: SUPABASE_URL, key: SUPABASE_ANON_KEY }}>
  (function () {
    var H = { apikey: key, Authorization: "Bearer " + key, "Content-Type": "application/json" };
    var rpc = function (fn, body) { return fetch(url + "/rest/v1/rpc/" + fn, { method: "POST", headers: H, body: JSON.stringify(body) }).then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); }); };
    var mob = function (v) { var d = String(v || "").replace(/\D/g, ""); return d.length > 10 ? d.slice(-10) : d; };
    var login = document.getElementById("login"), edit = document.getElementById("edit"), fb = document.getElementById("fb");
    var cred = null, rec = null;
    var KEY = "ss_csc_owner";
    var q = new URLSearchParams(location.search);
    if (q.get("id")) login.querySelector("#l-app").value = q.get("id");
    if (q.get("code")) login.querySelector("#l-code").value = q.get("code");
    var slug = function (t) { return String(t || "").toLowerCase().normalize("NFKD").replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "").slice(0, 60); };
    // Login is remembered on this phone, so the owner types the password only once.
    var saved = null;
    try { saved = JSON.parse(localStorage.getItem(KEY) || "null"); } catch (e) {}

    function addBox(groupId, name, value) {
      var g = document.getElementById(groupId);
      var exists = [].some.call(g.querySelectorAll("input"), function (i) { return i.value === value; });
      if (exists || !value) return;
      var l = document.createElement("label"), i = document.createElement("input");
      i.type = "checkbox"; i.name = name; i.value = value; l.appendChild(i); l.appendChild(document.createTextNode(" " + value)); g.appendChild(l);
    }
    function fill(c) {
      var f = edit;
      f.centre_name.value = c.centre_name || ""; f.years_of_operation.value = c.years_of_operation == null ? "" : c.years_of_operation;
      f.about.value = c.about || ""; f.full_address.value = c.full_address || ""; f.locality.value = c.locality || "";
      f.city.value = c.city || ""; f.pincode.value = c.pincode || "";
      document.getElementById("e-where").textContent = "ज़िला: " + (c.district || "") + ", राज्य: " + (c.state || "") + " (ज़िला/राज्य बदलना हो तो हमें WhatsApp करें)";
      f.show_address.checked = c.show_address !== false; f.show_hours.checked = c.show_hours !== false; f.home_visit.checked = !!c.home_visit;
      (c.online_services || []).forEach(function (s) { addBox("e-online", "online_services", s); });
      (c.offline_services || []).forEach(function (s) { addBox("e-offline", "offline_services", s); });
      (c.remote_services || []).forEach(function (s) { addBox("e-remote", "remote_services", s); });
      [].forEach.call(f.querySelectorAll('input[name="remote_services"]'), function (i) { i.checked = (c.remote_services || []).indexOf(i.value) !== -1; });
      [].forEach.call(f.querySelectorAll('input[name="online_services"],input[name="offline_services"]'), function (i) {
        i.checked = (c.online_services || []).concat(c.offline_services || []).indexOf(i.value) !== -1;
      });
      f.custom.value = (c.custom_services || []).join(", ");
      var h = c.working_hours || {};
      f.open.value = h.open || ""; f.close.value = h.close || ""; f.days.value = h.days || "";
      f.public_phone.value = c.public_phone || ""; f.public_whatsapp.value = c.public_whatsapp || ""; f.public_email.value = c.public_email || "";
      f.dataset.lat = c.latitude || ""; f.dataset.lng = c.longitude || "";
    }

    function open(c0, remember) {
      var out = document.getElementById("l-out");
      out.textContent = "जांच हो रही है…";
      return rpc("csc_owner_get", c0).then(function (c) {
        if (!c) {
          try { localStorage.removeItem(KEY); } catch (e) {}
          login.hidden = false;
          out.textContent = "जानकारी मेल नहीं खाई। आवेदन नंबर, मोबाइल और पासवर्ड दोबारा जांचें।"; return;
        }
        cred = c0; rec = c;
        if (remember) { try { localStorage.setItem(KEY, JSON.stringify(c0)); } catch (e) {} }
        fill(c); login.hidden = true; edit.hidden = false; fb.hidden = false; photoForm.hidden = false; showPhoto(c.photo_url);
        var who = document.getElementById("who");
        who.innerHTML = "";
        who.appendChild(document.createTextNode("✓ लॉगिन: " + (c.centre_name || c0.p_app) + " (" + c0.p_app + ") · "));
        var a = document.createElement("a"); a.href = "#"; a.textContent = "दूसरे नंबर/पासवर्ड से लॉगिन करें";
        a.addEventListener("click", function (e) {
          e.preventDefault();
          try { localStorage.removeItem(KEY); } catch (er) {}
          cred = rec = null; edit.hidden = fb.hidden = who.hidden = photoForm.hidden = true; login.hidden = false;
          login.querySelector("#l-code").value = ""; out.textContent = "";
        });
        who.appendChild(a); who.hidden = false;
        out.textContent = "";
      }).catch(function () { login.hidden = false; out.textContent = "अभी जांच नहीं हो सकी। थोड़ी देर बाद कोशिश करें।"; });
    }

    login.addEventListener("submit", function (e) {
      e.preventDefault();
      var out = document.getElementById("l-out");
      var app = login.querySelector("#l-app").value.trim(), m = mob(login.querySelector("#l-mob").value), code = login.querySelector("#l-code").value.trim().toUpperCase();
      if (!app || !/^[6-9]\d{9}$/.test(m) || code.length < 4) { out.textContent = "आवेदन नंबर, 10 अंकों का मोबाइल और पासवर्ड भरें।"; return; }
      open({ p_app: app, p_mobile: m, p_code: code }, true);
    });

    if (saved && saved.p_app && saved.p_mobile && saved.p_code && (!q.get("id") || q.get("id") === saved.p_app)) {
      login.hidden = true;
      open(saved, false);
    }

    // Photo: resized in the browser to a small JPEG, sent with the login to
    // the csc-photo function, which checks the password and stores it.
    var photoForm = document.getElementById("photo"), phImg = document.getElementById("ph-img"), phOut = document.getElementById("ph-out"), phDel = document.getElementById("ph-del");
    function showPhoto(u) { phImg.hidden = !u; if (u) phImg.src = u; phDel.hidden = !u; }
    function sendPhoto(body) {
      return fetch(url + "/functions/v1/csc-photo", { method: "POST", headers: H, body: JSON.stringify(Object.assign({ app: cred.p_app, mobile: cred.p_mobile, code: cred.p_code }, body)) })
        .then(function (r) { return r.json().then(function (j) { if (!r.ok) throw new Error(j.error || r.status); return j; }); });
    }
    function shrink(file) {
      return new Promise(function (ok, bad) {
        var img = new Image(), u = URL.createObjectURL(file);
        img.onload = function () {
          URL.revokeObjectURL(u);
          var s = Math.min(1, 1200 / Math.max(img.width, img.height)), cv = document.createElement("canvas");
          cv.width = Math.round(img.width * s); cv.height = Math.round(img.height * s);
          cv.getContext("2d").drawImage(img, 0, 0, cv.width, cv.height);
          var q = 0.82, d = cv.toDataURL("image/jpeg", q);
          while (d.length > 700000 && q > 0.4) { q -= 0.12; d = cv.toDataURL("image/jpeg", q); }
          ok(d);
        };
        img.onerror = function () { URL.revokeObjectURL(u); bad(new Error("image")); };
        img.src = u;
      });
    }
    document.getElementById("ph-file").addEventListener("change", function (e) {
      var f = e.target.files && e.target.files[0];
      e.target.value = "";
      if (!f || !cred) return;
      if (!/^image\//.test(f.type)) { phOut.textContent = "सिर्फ फोटो चुनें।"; return; }
      phOut.textContent = "फोटो लग रही है…";
      shrink(f).then(function (d) { return sendPhoto({ image: d }); })
        .then(function (j) { showPhoto(j.photo_url); phOut.textContent = "✓ फोटो लग गई। आपके पेज पर दिख रही है।"; })
        .catch(function () { phOut.textContent = "फोटो नहीं लग सकी। दूसरी फोटो से या थोड़ी देर बाद कोशिश करें।"; });
    });
    phDel.addEventListener("click", function () {
      if (!cred || !confirm("फोटो हटा दें?")) return;
      phOut.textContent = "हटाई जा रही है…";
      sendPhoto({ remove: true }).then(function () { showPhoto(null); phOut.textContent = "✓ फोटो हटा दी गई।"; })
        .catch(function () { phOut.textContent = "अभी हटाई नहीं जा सकी।"; });
    });

    document.getElementById("e-gps").addEventListener("click", function () {
      var o = document.getElementById("e-gps-out");
      if (!navigator.geolocation) { o.textContent = "लोकेशन उपलब्ध नहीं।"; return; }
      o.textContent = "लोकेशन ली जा रही है…";
      navigator.geolocation.getCurrentPosition(function (p) {
        edit.dataset.lat = p.coords.latitude.toFixed(6); edit.dataset.lng = p.coords.longitude.toFixed(6);
        o.textContent = "✓ नई लोकेशन: " + edit.dataset.lat + ", " + edit.dataset.lng + " (सेव करना न भूलें)";
      }, function () { o.textContent = "लोकेशन नहीं मिली।"; }, { enableHighAccuracy: true, timeout: 15000 });
    });

    edit.addEventListener("submit", function (e) {
      e.preventDefault();
      var f = edit, out = document.getElementById("e-out");
      var pp = mob(f.public_phone.value), pw = mob(f.public_whatsapp.value);
      if ((pp && !/^[6-9]\d{9}$/.test(pp)) || (pw && !/^[6-9]\d{9}$/.test(pw))) { out.textContent = "फोन/WhatsApp 10 अंकों का सही नंबर हो।"; return; }
      if (!pp && !pw) { out.textContent = "कम से कम एक संपर्क नंबर रखें।"; return; }
      if (f.pincode.value && !/^[1-9]\d{5}$/.test(f.pincode.value.trim())) { out.textContent = "6 अंकों का सही PIN कोड भरें।"; return; }
      var all = function (n) { return [].map.call(f.querySelectorAll('input[name="' + n + '"]:checked'), function (x) { return x.value; }); };
      var data = {
        centre_name: f.centre_name.value, years_of_operation: f.years_of_operation.value, about: f.about.value,
        full_address: f.full_address.value, locality: f.locality.value, city: f.city.value, pincode: f.pincode.value.trim(),
        latitude: f.dataset.lat || "", longitude: f.dataset.lng || "",
        online_services: all("online_services"), offline_services: all("offline_services"), remote_services: all("remote_services"),
        custom_services: f.custom.value.split(",").map(function (s) { return s.trim(); }).filter(Boolean).slice(0, 15),
        working_hours: { open: f.open.value.trim(), close: f.close.value.trim(), days: f.days.value.trim() },
        home_visit: f.home_visit.checked, show_address: f.show_address.checked, show_hours: f.show_hours.checked,
        public_phone: pp, public_whatsapp: pw, public_email: f.public_email.value.trim(),
      };
      out.textContent = "सेव हो रहा है…";
      rpc("csc_owner_update", Object.assign({ p_data: data }, cred)).then(function (ok) {
        if (!ok) { out.textContent = "सेव नहीं हुआ। दोबारा लॉगिन करके कोशिश करें।"; return; }
        // Open the centre's page; it redraws itself from the live data.
        var num = (cred.p_app.match(/\d{4,}$/) || [slug(cred.p_app)])[0];
        var page = "/csc-centre/" + [slug(data.centre_name), slug(rec && rec.district), num].filter(Boolean).join("-") + ".html";
        var dyn = "/csc-centre.html?id=" + encodeURIComponent(cred.p_app);
        out.innerHTML = '✓ बदलाव सेव हो गए। आपका पेज खुल रहा है… <a href="' + dyn + '">पेज देखें</a>';
        var go = function (u) { setTimeout(function () { location.href = u + (u.indexOf("?") === -1 ? "?" : "&") + "t=" + Date.now(); }, 1200); };
        fetch(page, { method: "HEAD", cache: "no-store" }).then(function (r) { go(r.ok ? page : dyn); }).catch(function () { go(dyn); });
      }).catch(function () { out.textContent = "सेव नहीं हो सका। थोड़ी देर बाद कोशिश करें।"; });
    });

    fb.addEventListener("submit", function (e) {
      e.preventDefault();
      var out = document.getElementById("fb-out");
      var n = fb.querySelector("#fb-n").value;
      fetch(url + "/rest/v1/csc_feedback", {
        method: "POST", headers: Object.assign({ Prefer: "return=minimal" }, H),
        body: JSON.stringify({ application_id: cred.p_app, mobile: cred.p_mobile, customers: n === "" ? null : Math.max(0, Math.min(10000, parseInt(n, 10) || 0)), message: fb.querySelector("#fb-msg").value.slice(0, 1000) || null }),
      }).then(function (r) { if (!r.ok) throw 0; out.textContent = "धन्यवाद! जानकारी मिल गई।"; fb.reset(); })
        .catch(function () { out.textContent = "भेजा नहीं जा सका।"; });
    });
  })();
  </script>
</Base>

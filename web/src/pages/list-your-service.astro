    .sh-rules ol { padding-left: 22px; } .sh-rules li { margin: 5px 0; }
    .sh-note { border-left: 4px solid #f59e0b; background: #fffbeb; color: #1f2937; padding: 10px 12px; border-radius: 8px; }
    .sh-form h2 { margin-top: 0; }

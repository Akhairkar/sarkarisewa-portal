---
import fs from "node:fs";
import path from "node:path";
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import SearchBox from "../../components/SearchBox.astro";
import CardGrid from "../../components/CardGrid.astro";
import Faq from "../../components/Faq.astro";
import Explore from "../../components/Explore.astro";
import { DOCS, NATIONAL_DOCS, STATES } from "../../data/site";

const repoRoot = path.resolve(process.cwd(), "..");
const has = (rel: string) => fs.existsSync(path.join(repoRoot, rel));
const docs = DOCS.map((d) => ({
  ...d,
  states: STATES.filter((s) => has(`states/${s.slug}-${d.slug}.html`)),
}));

const crumbs = [{ label: "होम", href: "/" }, { label: "दस्तावेज़" }];
const faq = [
  { q: "सरकारी प्रमाण पत्र कहां बनते हैं?", a: "ज़्यादातर राज्यों में जन्म, जाति, आय और निवास प्रमाण पत्र राज्य के e-District पोर्टल या नज़दीकी CSC / जन सेवा केंद्र से बनते हैं। हर राज्य का सही पोर्टल उस राज्य के पेज पर दिया गया है।" },
  { q: "एक ही दस्तावेज़ अलग-अलग राज्यों में अलग क्यों बनता है?", a: "प्रमाण पत्र और कार्ड राज्य सरकारें जारी करती हैं, इसलिए पोर्टल, फीस, ज़रूरी कागज़ और समय राज्य के अनुसार बदलते हैं। इसीलिए हमने हर राज्य की अलग गाइड बनाई है।" },
  { q: "ऑनलाइन आवेदन नहीं कर पा रहे तो क्या करें?", a: "नज़दीकी CSC / जन सेवा केंद्र पर जाएं। वहां ऑपरेटर तय शुल्क लेकर आपका ऑनलाइन आवेदन कर देता है। अपने ज़िले का केंद्र CSC Locator से खोजें।" },
];
---
<Base
  title="सरकारी दस्तावेज़ और प्रमाण पत्र: राज्य अनुसार गाइड | SarkariSewa India"
  description="राशन कार्ड, लेबर कार्ड, सीनियर सिटीजन कार्ड, जन्म, जाति, आय और निवास प्रमाण पत्र: हर राज्य में आवेदन कैसे करें, ज़रूरी कागज़ और official पोर्टल।"
  breadcrumbs={crumbs}
  faq={faq}
  schemaType="WebPage"
>
  <Breadcrumbs items={crumbs} />
  <section class="hero">
    <h1>सरकारी दस्तावेज़ और प्रमाण पत्र</h1>
    <p class="page-intro">कौन सा कार्ड या प्रमाण पत्र चाहिए? उसे चुनें, फिर अपना राज्य। हर गाइड में आवेदन के स्टेप, ज़रूरी कागज़ और official link है।</p>
    <SearchBox placeholder="जैसे: लेबर कार्ड बिहार, जाति प्रमाण पत्र…" />
  </section>

  <section class="block" aria-labelledby="state-docs">
    <div class="block-head"><h2 id="state-docs">राज्य के अनुसार बनने वाले दस्तावेज़</h2></div>
    <p class="block-lead">दस्तावेज़ पर टैप करें और अपना राज्य चुनें।</p>
    <div class="doc-list">
      {docs.map((d, i) => (
        <details id={d.slug} open={i === 0}>
          <summary>
            <span class="emoji" aria-hidden="true">{d.emoji}</span>
            <span><strong>{d.title}</strong><small>{d.text} · {d.states.length} राज्य</small></span>
          </summary>
          <div class="doc-body">
            {d.national && <a href={d.national}>{d.title}: पूरी जानकारी ›</a>}
            <ul class="chips">
              {d.states.map((s) => <li><a href={`/states/${s.slug}-${d.slug}.html`}>{s.hi}</a></li>)}
            </ul>
          </div>
        </details>
      ))}
    </div>
  </section>

  <CardGrid title="पूरे भारत में एक जैसे दस्तावेज़" cards={NATIONAL_DOCS} id="national" />

  <Faq items={faq} />
  <Explore />
</Base>

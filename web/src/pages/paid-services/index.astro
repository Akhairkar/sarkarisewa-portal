---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Faq from "../../components/Faq.astro";
import Explore from "../../components/Explore.astro";
import { PAID_SERVICES } from "../../data/site";

const crumbs = [{ label: "होम", href: "/" }, { label: "Online Services" }];
const faq = [
  { q: "क्या यह सरकारी सेवा है?", a: "नहीं। SarkariSewa India एक स्वतंत्र निजी प्लेटफ़ॉर्म है। ये verification सेवाएं authorized provider से मिली जानकारी पर आधारित हैं। आधिकारिक पुष्टि के लिए संबंधित सरकारी पोर्टल देखें।" },
  { q: "शुल्क किस बात का है?", a: "यह शुल्क हमारी verification सेवा और रिपोर्ट का है, कोई सरकारी फीस नहीं। भुगतान से पहले राशि साफ दिखाई जाती है।" },
  { q: "भुगतान कैसे होता है?", a: "भुगतान Razorpay के ज़रिए UPI, कार्ड या नेट बैंकिंग से होता है। हम आपका UPI PIN, OTP या कार्ड PIN कभी नहीं मांगते।" },
  { q: "रिपोर्ट कब मिलती है?", a: "भुगतान सफल होते ही रिपोर्ट स्क्रीन पर दिखती है और आप उसे PDF में डाउनलोड कर सकते हैं।" },
];
---
<Base
  title="Online Verification Services: GSTIN, e-Challan | SarkariSewa India"
  description="GSTIN Verification ₹20 में: GST नंबर असली है या नहीं, चालू है या बंद, साफ PDF रिपोर्ट के साथ। RC e-Challan Report जल्द आ रही है।"
  breadcrumbs={crumbs}
  faq={faq}
  schemaType="WebPage"
>
  <Breadcrumbs items={crumbs} />
  <section class="hero">
    <span class="eyebrow">🔒 Razorpay से सुरक्षित भुगतान</span>
    <h1>Online Verification Services</h1>
    <p class="page-intro">GST नंबर, गाड़ी के challan जैसी जानकारी सेकंडों में, साफ रिपोर्ट के साथ। कीमत पहले से तय, कोई छिपा शुल्क नहीं।</p>
  </section>

  <section class="block" aria-label="सेवाएं">
    <div class="svc-grid">
      {PAID_SERVICES.map((s) => (
        <div class="svc">
          <div class="svc-top">
            <span class="emoji" aria-hidden="true">{s.emoji}</span>
            <div><span class={`status ${s.live ? "live" : "soon"}`}>{s.live ? "● Live" : "जल्द आ रहा है"}</span><h3>{s.title}</h3></div>
            <div class="price">{s.price}<small>{s.unit}</small></div>
          </div>
          <p>{s.text}</p>
          <ul>{s.points.map((p) => <li>{p}</li>)}</ul>
          {s.live
            ? <a class="cta" href={s.href}>अभी जांचें →</a>
            : <span class="cta disabled">जल्द शुरू होगा</span>}
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <h2>कैसे काम करता है</h2>
    <ol class="steps">
      <li><strong>नंबर डालें।</strong> GSTIN या गाड़ी का नंबर। फॉर्मेट पहले ही जांच लिया जाता है, ताकि गलत नंबर पर पैसे न कटें।</li>
      <li><strong>भुगतान करें।</strong> Razorpay पर UPI, कार्ड या नेट बैंकिंग से।</li>
      <li><strong>रिपोर्ट पाएं।</strong> स्क्रीन पर तुरंत, PDF डाउनलोड और शेयर के साथ।</li>
    </ol>
    <div class="callout warn"><p><strong>ध्यान दें:</strong> यह सरकारी वेबसाइट नहीं है और यहां कोई सरकारी प्रमाण पत्र जारी नहीं होता। अपना password, OTP या UPI PIN किसी से साझा न करें।</p></div>
  </section>

  <Faq items={faq} />
  <Explore exclude={["/services/gstin-verification/"]} />
</Base>

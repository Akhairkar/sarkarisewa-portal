---
// Terms of use. The old page had copied "eligibility/documents" boilerplate
// instead of terms; this is a clean rewrite for the site as it is today.
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Faq from "../components/Faq.astro";

const EMAIL = "sarkarisewaindia@gmail.com";
const crumbs = [{ label: "होम", href: "/" }, { label: "Terms & Conditions" }];
const faq = [
  { q: "क्या वेबसाइट इस्तेमाल करने की कोई शर्त है?", a: "हां। वेबसाइट इस्तेमाल करने का मतलब है कि आप इस पेज की शर्तें मानते हैं। सहमत न हों तो वेबसाइट इस्तेमाल न करें।" },
  { q: "क्या मैं यहां का कंटेंट कॉपी कर सकता हूं?", a: "निजी इस्तेमाल के लिए पढ़ना, प्रिंट करना और लिंक शेयर करना ठीक है। पूरा लेख कॉपी करके दूसरी वेबसाइट, ऐप या व्यापार में इस्तेमाल करने के लिए पहले लिखित अनुमति लें।" },
  { q: "शर्तें कब बदलती हैं?", a: "सेवाएं बदलने पर हम शर्तें अपडेट करते हैं और ऊपर तारीख बदल देते हैं। बदलाव के बाद वेबसाइट इस्तेमाल करना नई शर्तों को मानना है।" },
];
---
<Base
  title="Terms & Conditions | SarkariSewa India"
  description="SarkariSewa India इस्तेमाल करने की शर्तें: जानकारी का उद्देश्य, पेड रिपोर्ट, CSC लिस्टिंग, कंटेंट का इस्तेमाल, ज़िम्मेदारी की सीमा और संपर्क।"
  breadcrumbs={crumbs}
  faq={faq}
  schemaType="WebPage"
  modified="2026-10-16"
>
  <Breadcrumbs items={crumbs} />
  <article class="page">
    <div>
      <h1>नियम और शर्तें (Terms & Conditions)</h1>
      <p class="page-intro">sarkarisewaindia.com (SarkariSewa India) इस्तेमाल करने से आप इन शर्तों से सहमत होते हैं। सहमत न हों तो वेबसाइट इस्तेमाल न करें। अपडेट: 16 अक्टूबर 2026।</p>

      <section class="section" id="seva">
        <h2>1. यह वेबसाइट क्या है</h2>
        <ul class="checklist">
          <li>SarkariSewa India एक निजी जानकारी वेबसाइट है। यह भारत सरकार या किसी राज्य सरकार की वेबसाइट नहीं है और किसी विभाग से जुड़ी नहीं है।</li>
          <li>हम सरकारी आवेदन नहीं लेते, फॉर्म नहीं भरते और कोई प्रमाण पत्र, कार्ड या लाभ जारी या मंज़ूर नहीं करते। आवेदन हमेशा official पोर्टल या अधिकृत CSC पर होता है।</li>
          <li>गाइड, CSC लोकेटर और ज़्यादातर टूल फ्री हैं।</li>
        </ul>
      </section>

      <section class="section" id="jankari">
        <h2>2. जानकारी का इस्तेमाल</h2>
        <ul class="checklist">
          <li>यहां की जानकारी सामान्य मार्गदर्शन के लिए है, कानूनी, टैक्स या वित्तीय सलाह नहीं।</li>
          <li>सरकारी नियम, फीस, तारीख और पोर्टल बदल सकते हैं। आवेदन, भुगतान या कोई फैसला लेने से पहले official वेबसाइट या दफ्तर से पुष्टि करें।</li>
          <li>हम सही जानकारी देने की पूरी कोशिश करते हैं, पर पूरी तरह सही या ताज़ा होने की गारंटी नहीं देते। विस्तार: <a href="/disclaimer.html">Disclaimer</a>।</li>
        </ul>
      </section>

      <section class="section" id="paid">
        <h2>3. पेड रिपोर्ट</h2>
        <ul class="checklist">
          <li>GSTIN Verification और RC e-Challan रिपोर्ट पेड हैं। कीमत भुगतान से पहले दिखाई जाती है। यह हमारी सेवा का शुल्क है, कोई सरकारी फीस, टैक्स या चालान की राशि नहीं।</li>
          <li>रिपोर्ट सरकारी या अधिकृत स्रोत से उसी समय मिली जानकारी पर बनती है। यह सरकारी प्रमाण पत्र या कानूनी दस्तावेज़ नहीं है।</li>
          <li>भुगतान Razorpay से होता है। रिफंड के नियम <a href="/refund-policy.html">रिफंड नीति</a> में हैं।</li>
        </ul>
      </section>

      <section class="section" id="csc">
        <h2>4. CSC लोकेटर और CSC मदद</h2>
        <ul class="checklist">
          <li>CSC लोकेटर की जानकारी सार्वजनिक स्रोतों और केंद्र संचालकों से ली गई है। जाने से पहले केंद्र को फोन करके समय और सेवा पूछ लें।</li>
          <li>CSC संचालक स्वतंत्र व्यवसायी हैं, हमारे कर्मचारी नहीं। वे अपनी सेवा का शुल्क खुद तय करते और बताते हैं। उनके काम या शुल्क की ज़िम्मेदारी हमारी नहीं है; कोई शिकायत हो तो हमें ईमेल करें, हम लिस्टिंग की जांच करेंगे।</li>
          <li>जो संचालक <a href="/claim-your-csc.html">अपना CSC जोड़ें</a> फॉर्म भरते हैं, वे पुष्टि करते हैं कि जानकारी सही है और वे उस केंद्र के संचालक हैं। गलत या भ्रामक लिस्टिंग हटाई जा सकती है।</li>
        </ul>
      </section>

      <section class="section" id="upyog">
        <h2>5. वेबसाइट का सही इस्तेमाल</h2>
        <ul class="checklist">
          <li>वेबसाइट या उसके फॉर्म का गलत इस्तेमाल (स्पैम, नकली जानकारी, किसी और का नंबर डालना, हैकिंग की कोशिश, बहुत ज़्यादा ऑटोमेटिक रिक्वेस्ट) मना है।</li>
          <li>निजी इस्तेमाल के लिए पढ़ना, प्रिंट करना और लिंक शेयर करना ठीक है। कंटेंट को कॉपी करके कहीं और प्रकाशित करने के लिए लिखित अनुमति लें।</li>
          <li>सरकारी नाम, लोगो और योजनाओं के नाम उनके मालिकों के हैं; उनका ज़िक्र सिर्फ जानकारी देने के लिए है।</li>
        </ul>
      </section>

      <section class="section" id="seema">
        <h2>6. ज़िम्मेदारी की सीमा</h2>
        <p>कानून जितनी अनुमति देता है, उस हद तक SarkariSewa India इस वेबसाइट की जानकारी, बाहरी वेबसाइटों, CSC संचालकों या सरकारी पोर्टल की गड़बड़ी से हुए किसी नुकसान के लिए ज़िम्मेदार नहीं है। पेड रिपोर्ट के मामले में हमारी ज़िम्मेदारी उस रिपोर्ट के लिए दिए गए शुल्क तक सीमित है।</p>
      </section>

      <section class="section" id="anya">
        <h2>7. गोपनीयता, बदलाव और कानून</h2>
        <ul class="checklist">
          <li>आपकी जानकारी कैसे इस्तेमाल होती है: <a href="/privacy-policy.html">Privacy Policy</a>।</li>
          <li>हम ये शर्तें बदल सकते हैं; बदलाव इसी पेज पर दिखेगा।</li>
          <li>इन शर्तों पर भारत का कानून लागू होता है।</li>
          <li>संपर्क: <a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
        </ul>
      </section>

      <Faq items={faq} />
    </div>
  </article>
</Base>

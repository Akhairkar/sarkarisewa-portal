---
import fs from "node:fs";
import path from "node:path";
import Base from "../layouts/Base.astro";
import SearchBox from "../components/SearchBox.astro";
import TaskList from "../components/TaskList.astro";
import CardGrid from "../components/CardGrid.astro";
import Faq from "../components/Faq.astro";
import { SITE, POPULAR_TASKS, PAID_SERVICES, STATES } from "../data/site";

const repoRoot = path.resolve(process.cwd(), "..");
const states = STATES.filter((s) => fs.existsSync(path.join(repoRoot, "states", `${s.slug}.html`)));

const students = [
  { href: "/jobs/index.html", emoji: "🎯", title: "नई सरकारी नौकरियां", text: "भर्ती, योग्यता और आखिरी तारीख" },
  { href: "/exams/index.html", emoji: "📅", title: "Exam Calendar", text: "SSC, Railway, Bank, UPSC की तारीखें" },
  { href: "/tools/age-calculator.html", emoji: "⏳", title: "Exam Age Calculator", text: "Cut-off तारीख पर आपकी सही उम्र" },
  { href: "/tools/document-compressor.html", emoji: "🗜️", title: "फोटो / Signature Resizer", text: "फॉर्म के साइज़ में, फ्री" },
  { href: "/tools/eligibility-checker.html", emoji: "✅", title: "Eligibility Checker", text: "आप किन योजनाओं के लिए पात्र हैं" },
  { href: "/deadline-calendar.html", emoji: "⏰", title: "Deadline Calendar", text: "फॉर्म और योजना की आखिरी तारीखें" },
];

const tools = [
  { href: "/tools/income-tax-calculator.html", emoji: "🧮", title: "Income Tax Calculator", text: "नई vs पुरानी व्यवस्था" },
  { href: "/7th-pay-commission-calculator.html", emoji: "💵", title: "7th Pay Calculator", text: "सरकारी वेतन का हिसाब" },
  { href: "/tools/epf-calculator.html", emoji: "🏦", title: "EPF Calculator", text: "रिटायरमेंट पर PF कितना" },
  { href: "/tools/gratuity-calculator.html", emoji: "🎁", title: "Gratuity Calculator", text: "नौकरी छोड़ने पर ग्रेच्युटी" },
  { href: "/tools/document-checklist.html", emoji: "📋", title: "Document Checklist", text: "किस काम में कौन सा कागज़" },
  { href: "/tools/hra-calculator.html", emoji: "🏠", title: "HRA Calculator", text: "HRA टैक्स छूट" },
];

const faq = [
  { q: "SarkariSewa India क्या है?", a: "SarkariSewa India एक स्वतंत्र जानकारी पोर्टल है। यहां सरकारी दस्तावेज़, योजनाएं, नौकरियां और टूल्स की जानकारी आसान हिंदी में, official links के साथ मिलती है। हम कोई सरकारी वेबसाइट नहीं हैं।" },
  { q: "क्या यहां से सरकारी फॉर्म भरे जाते हैं?", a: "नहीं। हम बताते हैं कि आवेदन कहां और कैसे करें। आवेदन और सरकारी फीस का भुगतान हमेशा official सरकारी वेबसाइट पर ही करें।" },
  { q: "जानकारी कितनी सही है?", a: "हर गाइड पर official link और आखिरी जांच की तारीख दी जाती है। नियम बदलते रहते हैं, इसलिए आवेदन से पहले official वेबसाइट पर ज़रूर देख लें।" },
  { q: "Paid services क्या हैं?", a: "GSTIN Verification जैसी कुछ सेवाएं सशुल्क हैं। यह हमारी सेवा का शुल्क है, सरकारी फीस नहीं। भुगतान से पहले राशि और शर्तें साफ दिखाई जाती हैं।" },
];
---
<Base
  title="Government Services, Schemes, Jobs & Tools | SarkariSewa India"
  description="भारत सरकार और सभी राज्यों की सरकारी सेवाओं, योजनाओं, राशन कार्ड, वोटर ID, पेंशन व प्रमाण पत्रों की ऑनलाइन गाइड, पात्रता व आधिकारिक लिंक।"
  faq={faq}
  schemaType="WebPage"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE.name,
    url: SITE.url,
    inLanguage: "hi",
    potentialAction: {
      "@type": "SearchAction",
      target: `${SITE.url}/search.html?q={search_term_string}`,
      "query-input": "required name=search_term_string",
    },
  })} />

  <section class="hero">
    <span class="eyebrow">✓ हर जानकारी के साथ official link</span>
    <h1>सरकारी काम, <em>आसान भाषा में</em></h1>
    <p class="page-intro">दस्तावेज़ कैसे बनवाएं, कौन सी योजना आपके लिए है, नई सरकारी नौकरियां और काम के टूल्स, सब एक जगह।</p>
    <SearchBox />
    <div class="trust-row">
      <span>36 राज्यों की जानकारी</span>
      <span>आसान हिंदी</span>
      <span>फ्री गाइड और टूल्स</span>
    </div>
  </section>

  <section class="block" aria-labelledby="popular">
    <div class="block-head"><h2 id="popular">लोग सबसे ज़्यादा यह खोज रहे हैं</h2><a href="/documents/">सभी दस्तावेज़ ›</a></div>
    <TaskList items={POPULAR_TASKS} />
  </section>

  <section class="block" aria-labelledby="states">
    <div class="block-head"><h2 id="states">अपना राज्य चुनें</h2><a href="/states/index.html">सभी राज्य ›</a></div>
    <p class="block-lead">आपके राज्य के प्रमाण पत्र, कार्ड, पोर्टल और योजनाएं।</p>
    <div class="state-grid">
      {states.map((s) => <a href={`/states/${s.slug}.html`}>{s.hi}<small>{s.name}</small></a>)}
    </div>
  </section>

  <section class="block" aria-labelledby="students">
    <div class="block-head"><h2 id="students">Students के लिए 🎓</h2><a href="/jobs/index.html">सभी नौकरियां ›</a></div>
    <p class="block-lead">भर्ती, exam की तारीखें, उम्र और फॉर्म भरने के टूल्स।</p>
    <TaskList items={students} />
  </section>

  <section class="block" aria-labelledby="paid">
    <div class="block-head"><h2 id="paid">Online Services</h2><a href="/paid-services/">सभी सेवाएं ›</a></div>
    <div class="svc-grid">
      {PAID_SERVICES.map((s) => (
        <div class="svc">
          <div class="svc-top">
            <span class="emoji" aria-hidden="true">{s.emoji}</span>
            <div><span class={`status ${s.live ? "live" : "soon"}`}>{s.live ? "● Live" : "जल्द आ रहा है"}</span><h3>{s.title}</h3></div>
            <div class="price">{s.price}<small>{s.unit}</small></div>
          </div>
          <p>{s.text}</p>
          {s.live
            ? <a class="cta" href={s.href}>अभी जांचें →</a>
            : <span class="cta disabled">जल्द शुरू होगा</span>}
        </div>
      ))}
    </div>
  </section>

  <CardGrid title="काम के फ्री टूल्स 🛠️" cards={tools} id="tools" />

  <section class="block" aria-labelledby="near">
    <div class="block-head"><h2 id="near">आपके पास</h2></div>
    <div class="tasks">
      <a class="task" href="/tools/csc-locator.html"><span class="emoji" aria-hidden="true">📍</span><span><strong>नज़दीकी CSC / जन सेवा केंद्र</strong><small>ज़िले के अनुसार पता और फोन नंबर</small></span><span class="go" aria-hidden="true">›</span></a>
      <a class="task" href="/service/jan-aushadhi-store-locator.html"><span class="emoji" aria-hidden="true">💊</span><span><strong>जन औषधि केंद्र</strong><small>50-80% सस्ती दवा, ज़िले के अनुसार</small></span><span class="go" aria-hidden="true">›</span></a>
      <a class="task" href="/support/helpline-directory.html"><span class="emoji" aria-hidden="true">📞</span><span><strong>सरकारी हेल्पलाइन नंबर</strong><small>सभी विभागों के टोल-फ्री नंबर</small></span><span class="go" aria-hidden="true">›</span></a>
    </div>
  </section>

  <Faq items={faq} title="SarkariSewa के बारे में" />

  <p class="notice">SarkariSewa India एक स्वतंत्र जानकारी पोर्टल है और किसी सरकारी विभाग से जुड़ा नहीं है। आवेदन और सरकारी फीस का भुगतान सिर्फ official वेबसाइट पर करें।</p>
</Base>

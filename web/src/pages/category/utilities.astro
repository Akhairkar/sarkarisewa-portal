---
import Category from "../../views/Category.astro";

const faq = [
  { q: "बिजली का नया कनेक्शन कैसे लें?", a: "अपनी बिजली वितरण कंपनी (DISCOM) की वेबसाइट या ऑफिस में आवेदन करें। पहचान पत्र और घर के मालिकाना/किराए का कागज़ लगता है। हमारी बिजली कनेक्शन गाइड में तरीका है।" },
  { q: "गाड़ी का चालान कैसे देखें और भरें?", a: "echallan.parivahan.gov.in पर गाड़ी नंबर या चालान नंबर से देख और भर सकते हैं। हमारी चालान गाइड में तरीका है। सभी pending चालान की रिपोर्ट के लिए हमारी पेड RC e-Challan सेवा भी है।" },
  { q: "मोबाइल नंबर पर मेरे नाम से कितने सिम हैं, कैसे देखें?", a: "दूरसंचार विभाग के Sanchar Saathi पोर्टल पर देख सकते हैं और अनजान नंबर की शिकायत कर सकते हैं।" },
];
---
<Category
  slug="utilities"
  title="नागरिक उपयोगिताएं एवं नागरिक सेवाएं 2026 | SarkariSewa India"
  description="बिजली बिल और नया कनेक्शन, पानी, LPG और PNG गैस, प्रॉपर्टी टैक्स, FASTag, वाहन RC, मोबाइल और ई-चालान: रोज़मर्रा की नागरिक सेवाओं की आसान हिंदी गाइड।"
  h1="उपयोगिताएं: बिजली, पानी, गैस, वाहन और मोबाइल"
  intro="बिजली-पानी कनेक्शन, गैस बुकिंग और सब्सिडी, प्रॉपर्टी टैक्स, FASTag, वाहन RC और मोबाइल से जुड़ी सेवाएं। हर गाइड में तरीका और official लिंक है।"
  listTitle="नागरिक उपयोगिता सेवाएं"
  extra={[
    { title: "वाहन और चालान", cards: [
      { href: "/challan/", emoji: "🚦", title: "ई-चालान गाइड", text: "स्टेटस, भुगतान, लोक अदालत, गलत चालान" },
      { href: "/services/rc-challan/", emoji: "🚗", title: "RC e-Challan रिपोर्ट", text: "पेड सेवा: ₹20 प्रति गाड़ी" },
      { href: "/solar/", emoji: "☀️", title: "सोलर रूफटॉप", text: "PM सूर्य घर, सब्सिडी और खर्च" },
    ] },
  ]}
  tips={[
    "बिल और भुगतान की रसीद संभाल कर रखें।",
    "बिल भुगतान सिर्फ़ official ऐप, वेबसाइट या भरोसेमंद UPI/BBPS ऐप से करें।",
    "बिजली काटने की धमकी वाले SMS/कॉल फर्जी हो सकते हैं; DISCOM के नंबर पर पुष्टि करें।",
  ]}
  faq={faq}
/>

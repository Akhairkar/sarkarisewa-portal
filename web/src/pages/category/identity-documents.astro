---
import Category from "../../views/Category.astro";
import { DOCS } from "../../data/site";

const stateDocs = DOCS.map((d) => ({ href: `/documents/#${d.slug}`, emoji: d.emoji, title: typeof d.title === "string" ? d.title : d.title.hi, text: typeof d.text === "string" ? d.text : d.text.hi }));
const faq = [
  { q: "कौन सा दस्तावेज़ पहले बनवाएं?", a: "ज़्यादातर कामों के लिए पहले आधार और जन्म प्रमाण पत्र चाहिए। इनके बाद PAN, वोटर ID, राशन कार्ड और ज़रूरत के हिसाब से जाति, आय या निवास प्रमाण पत्र बनवाएं।" },
  { q: "जाति, आय और निवास प्रमाण पत्र कहां बनता है?", a: "ये राज्य सरकार बनाती है। अपने राज्य के e-District / सेवा पोर्टल पर ऑनलाइन, या नज़दीकी CSC और तहसील कार्यालय से आवेदन करें। अपने राज्य की गाइड दस्तावेज़ पेज पर देखें।" },
  { q: "क्या SarkariSewa India दस्तावेज़ बनाती है?", a: "नहीं। यह एक निजी जानकारी वेबसाइट है। हम सिर्फ़ बताते हैं कि दस्तावेज़ कहां और कैसे बनता है। आवेदन official पोर्टल, CSC या सरकारी कार्यालय में ही होता है।" },
  { q: "दस्तावेज़ बनवाने में कितना पैसा लगता है?", a: "कई दस्तावेज़ मुफ्त या कम सरकारी फीस में बनते हैं। CSC ऑपरेटर तय सेवा शुल्क ले सकता है। फीस हर गाइड में या official पोर्टल पर देखें और रसीद ज़रूर लें।" },
];
---
<Category
  slug="identity-documents"
  title="भारत में आधिकारिक पहचान दस्तावेज़ 2026 | SarkariSewa India"
  description="आधार, PAN, वोटर कार्ड, पासपोर्ट, ड्राइविंग लाइसेंस और जाति/आय/निवास प्रमाण पत्र: नया बनवाना, सुधार और डाउनलोड की आसान हिंदी गाइड, official लिंक के साथ।"
  h1="पहचान दस्तावेज़: बनवाना, सुधार और डाउनलोड"
  intro="आधार, PAN, वोटर ID, पासपोर्ट, ड्राइविंग लाइसेंस और प्रमाण पत्रों की गाइड। हर गाइड में ज़रूरी कागज़, फीस, आवेदन का तरीका और official लिंक है।"
  listTitle="पहचान पत्र और प्रमाण पत्र"
  extra={[
    { title: "राज्य के अनुसार बनने वाले दस्तावेज़", cards: stateDocs },
    { title: "मदद के लिए", cards: [
      { href: "/tools/csc-locator.html", emoji: "📍", title: "नज़दीकी CSC खोजें", text: "आवेदन में मदद के लिए अपने इलाके का CSC" },
      { href: "/service/digilocker.html", emoji: "🔐", title: "DigiLocker", text: "आधार, PAN, DL, मार्कशीट डिजिटल रूप में" },
      { href: "/affidavit/", emoji: "📝", title: "शपथ पत्र (Affidavit) फॉर्मेट", text: "नाम, जन्म तिथि, खोया दस्तावेज़" },
    ] },
  ]}
  tips={[
    "आवेदन से पहले आधार में नाम, जन्म तिथि और मोबाइल नंबर सही कर लें।",
    "सभी दस्तावेज़ों में नाम की स्पेलिंग एक जैसी रखें।",
    "फॉर्म भरने के बाद आवेदन नंबर और रसीद संभाल कर रखें।",
  ]}
  faq={faq}
/>

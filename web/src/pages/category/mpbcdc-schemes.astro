---
import Category from "../../views/Category.astro";

const faq = [
  { q: "MPBCDC क्या है?", a: "महात्मा फुले मागासवर्ग विकास महामंडळ (MPBCDC) महाराष्ट्र सरकार का महामंडळ है। यह अनुसूचित जाति और नव-बौद्ध समाज के आर्थिक रूप से कमज़ोर लोगों को स्वरोज़गार के लिए अनुदान, कर्ज और प्रशिक्षण देता है।" },
  { q: "MPBCDC योजना में आवेदन कहां करें?", a: "अपने ज़िले के MPBCDC कार्यालय में। हर योजना की गाइड में पात्रता, ज़रूरी कागज़ और आवेदन का तरीका दिया है।" },
  { q: "क्या यह योजना दूसरे राज्यों के लिए है?", a: "नहीं, MPBCDC की योजनाएं सिर्फ़ महाराष्ट्र के निवासियों के लिए हैं। दूसरे राज्यों की योजनाएं हमारी सरकारी योजनाएं श्रेणी में देखें।" },
];
---
<Category
  slug="mpbcdc-schemes"
  title="MPBCDC योजनाएं 2026 | SarkariSewa India"
  description="महात्मा फुले मागासवर्ग विकास महामंडळ (MPBCDC) की योजनाएं: थेट कर्ज (₹1 लाख तक, 4% ब्याज), 50% अनुदान योजना, पात्रता, कागज़ और ज़िला कार्यालय में आवेदन।"
  h1="MPBCDC योजनाएं: महाराष्ट्र स्वरोज़गार अनुदान और कर्ज"
  intro="महाराष्ट्र के अनुसूचित जाति और नव-बौद्ध समाज के लोगों के लिए महात्मा फुले महामंडळ की स्वरोज़गार योजनाएं। आवेदन ज़िला MPBCDC कार्यालय में होता है।"
  listTitle="MPBCDC की योजनाएं"
  extra={[
    { title: "और देखें", cards: [
      { href: "/category/government-schemes.html", emoji: "🏛️", title: "सभी सरकारी योजनाएं", text: "केंद्र और राज्य की योजनाएं" },
      { href: "/service/pm-mudra-yojana.html", emoji: "💼", title: "PM मुद्रा योजना", text: "छोटे व्यवसाय के लिए बैंक लोन" },
      { href: "/service/stand-up-india.html", emoji: "🚀", title: "Stand-Up India", text: "SC/ST और महिला उद्यमियों के लिए लोन" },
    ] },
  ]}
  tips={[
    "जाति प्रमाण पत्र, आय प्रमाण पत्र और महाराष्ट्र निवास का प्रमाण तैयार रखें।",
    "व्यवसाय का छोटा प्रोजेक्ट रिपोर्ट/कोटेशन साथ रखें।",
    "अनुदान या कर्ज दिलाने के नाम पर पैसे मांगने वाले दलालों से बचें।",
  ]}
  faq={faq}
/>

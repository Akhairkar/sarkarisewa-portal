---
import Category from "../../views/Category.astro";
import { STATES } from "../../data/site";
import { STATE_SCHEMES } from "../../data/schemes";

const stateHi = (slug: string) => STATES.find((s) => s.slug === slug)?.hi ?? slug;
const stateSchemes = STATE_SCHEMES.map(([st, slug, emoji, hi]) => ({ href: `/service/${slug}.html`, emoji, title: hi, text: stateHi(st) }));
const faq = [
  { q: "मेरे लिए कौन सी योजना है, कैसे पता करें?", a: "हर योजना की गाइड में पात्रता (उम्र, आय, श्रेणी, राज्य) लिखी है। पहले पात्रता पढ़ें, फिर official पोर्टल या नज़दीकी CSC से आवेदन करें।" },
  { q: "योजना का पैसा खाते में नहीं आया तो क्या करें?", a: "बैंक में जांचें कि खाता आधार से लिंक (NPCI mapping) है और KYC पूरी है। फिर योजना के official पोर्टल पर आवेदन का स्टेटस देखें।" },
  { q: "क्या योजना के लिए किसी को पैसे देने होते हैं?", a: "सरकारी योजनाओं में आवेदन आमतौर पर मुफ्त होता है। CSC ऑपरेटर तय सेवा शुल्क ले सकता है। योजना के नाम पर पैसे मांगने वालों से सावधान रहें।" },
  { q: "क्या यह सरकारी वेबसाइट है?", a: "नहीं। SarkariSewa India एक निजी जानकारी वेबसाइट है। हम योजनाओं की जानकारी आसान भाषा में देते हैं और official लिंक बताते हैं।" },
];
---
<Category
  slug="government-schemes"
  title="भारत की सभी सरकारी योजनाएं 2026 | SarkariSewa India"
  description="केंद्र और राज्य की प्रमुख सरकारी योजनाएं: पीएम किसान, पीएम सूर्य घर, विश्वकर्मा, आवास, उज्ज्वला, पेंशन और राज्य योजनाओं की पात्रता, आवेदन और स्टेटस गाइड।"
  h1="सरकारी योजनाएं: केंद्र और राज्य की योजनाओं की लिस्ट"
  intro="किसान, महिला, मज़दूर, बुज़ुर्ग, छात्र और छोटे व्यापारियों के लिए योजनाएं। हर गाइड में पात्रता, फायदा, ज़रूरी कागज़ और आवेदन का तरीका है।"
  listTitle="केंद्र सरकार की योजनाएं"
  extra={[
    { title: "राज्य सरकार की योजनाएं", cards: stateSchemes },
    { title: "और देखें", cards: [
      { href: "/yojana/", emoji: "🏛️", title: "योजना हब", text: "केंद्र, राज्य और स्वास्थ्य योजनाएं एक जगह" },
      { href: "/category/mpbcdc-schemes.html", emoji: "🏦", title: "MPBCDC योजनाएं", text: "महाराष्ट्र: स्वरोज़गार अनुदान और कर्ज" },
      { href: "/tools/csc-locator.html", emoji: "📍", title: "नज़दीकी CSC खोजें", text: "योजना के आवेदन में मदद" },
    ] },
  ]}
  tips={[
    "बैंक खाता आधार से लिंक और e-KYC पूरी होनी चाहिए, वरना पैसा अटक सकता है।",
    "आवेदन सिर्फ़ official पोर्टल या CSC से करें; अनजान लिंक या कॉल पर OTP न बताएं।",
    "आवेदन नंबर संभाल कर रखें, इसी से स्टेटस देखा जाता है।",
  ]}
  faq={faq}
/>

---
import Category from "../../views/Category.astro";

const faq = [
  { q: "सरकारी नौकरी का फॉर्म कहां भरें?", a: "हमेशा भर्ती करने वाली संस्था की official वेबसाइट पर, जैसे ssc.gov.in, upsc.gov.in या बैंक/IBPS की वेबसाइट। फीस किसी एजेंट को न दें।" },
  { q: "छात्रवृत्ति का आवेदन कहां होता है?", a: "केंद्र की ज़्यादातर छात्रवृत्तियां राष्ट्रीय छात्रवृत्ति पोर्टल (NSP) पर होती हैं, कई राज्यों का अपना पोर्टल भी है। हमारी NSP गाइड में तरीका और स्टेटस देखने का तरीका है।" },
  { q: "परीक्षा की तारीख कहां देखें?", a: "हमारे परीक्षा कैलेंडर पेज पर SSC, UPSC, रेलवे और बैंक परीक्षाओं की तारीखें हैं। अंतिम तारीख हमेशा official नोटिस से मिलाएं।" },
];
---
<Category
  slug="jobs-education"
  title="सरकारी नौकरी एवं शिक्षा पोर्टल 2026 | SarkariSewa India"
  description="सरकारी भर्ती और पढ़ाई से जुड़ी सेवाएं: SSC, UPSC, बैंक भर्ती, राष्ट्रीय छात्रवृत्ति पोर्टल (NSP), अप्रेंटिसशिप (NAPS), PM इंटर्नशिप और कौशल विकास योजनाएं।"
  h1="नौकरी और शिक्षा: भर्ती, छात्रवृत्ति और स्किल"
  intro="सरकारी भर्तियां, परीक्षा, छात्रवृत्ति, अप्रेंटिसशिप, इंटर्नशिप और मुफ्त ऑनलाइन कोर्स की गाइड। हर पेज पर official लिंक है।"
  listTitle="भर्ती, छात्रवृत्ति और शिक्षा सेवाएं"
  extra={[
    { title: "नौकरी और परीक्षा", cards: [
      { href: "/jobs/index.html", emoji: "🎯", title: "सरकारी नौकरी 2026", text: "किसमें आवेदन चालू है, आखिरी तारीख" },
      { href: "/exams/index.html", emoji: "📅", title: "परीक्षा कैलेंडर", text: "SSC, UPSC, रेलवे, बैंक की तारीखें" },
      { href: "/students/", emoji: "🎓", title: "Students हब", text: "फॉर्म, टूल और छात्रवृत्ति" },
      { href: "/tools/photo-resizer.html", emoji: "🖼️", title: "Photo / Signature Resizer", text: "फॉर्म के लिए सही साइज़" },
      { href: "/tools/typing-speed-test.html", emoji: "⌨️", title: "Typing Speed Test", text: "हिंदी/English टाइपिंग अभ्यास" },
    ] },
  ]}
  tips={[
    "फॉर्म भरने से पहले नोटिफिकेशन में उम्र, योग्यता और फीस ध्यान से पढ़ें।",
    "फोटो और सिग्नेचर तय साइज़ में ही अपलोड करें।",
    "नौकरी के नाम पर पैसे मांगने वालों से सावधान रहें।",
  ]}
  faq={faq}
/>

---
import Category from "../../views/Category.astro";

const faq = [
  { q: "आयुष्मान कार्ड से कितना इलाज मुफ्त है?", a: "आयुष्मान भारत PM-JAY में पात्र परिवार को सूचीबद्ध अस्पतालों में हर साल ₹5 लाख तक का मुफ्त इलाज मिलता है। 70 साल और उससे ज़्यादा उम्र के सभी बुज़ुर्ग आय की सीमा के बिना आयुष्मान वय वंदना कार्ड बनवा सकते हैं।" },
  { q: "ABHA कार्ड क्या है?", a: "ABHA (आयुष्मान भारत हेल्थ अकाउंट) 14 अंकों का डिजिटल हेल्थ ID है, जिससे आपकी मेडिकल रिपोर्ट डिजिटल रूप में जुड़ सकती हैं। यह मुफ्त बनता है।" },
  { q: "सस्ती दवा कहां मिलेगी?", a: "प्रधानमंत्री भारतीय जनऔषधि केंद्र पर जेनेरिक दवाएं ब्रांडेड दवाओं से काफी कम कीमत पर मिलती हैं। हमारी Near Me पेज और जन औषधि गाइड से नज़दीकी केंद्र खोजें।" },
  { q: "इमरजेंसी में क्या करें?", a: "गंभीर हालत में ऑनलाइन जानकारी पर निर्भर न रहें। तुरंत 108 या 112 पर कॉल करें या नज़दीकी अस्पताल जाएं।" },
];
---
<Category
  slug="health"
  title="राष्ट्रीय स्वास्थ्य सेवाएं 2026 | SarkariSewa India"
  description="आयुष्मान भारत ₹5 लाख मुफ्त इलाज, 70+ वय वंदना कार्ड, ABHA हेल्थ ID, जन औषधि सस्ती दवाएं, ई-रक्तकोष ब्लड बैंक, CGHS और ESIC: स्वास्थ्य सेवाओं की आसान गाइड।"
  h1="स्वास्थ्य सेवाएं: आयुष्मान, ABHA, CGHS और सस्ती दवा"
  intro="मुफ्त इलाज, डिजिटल हेल्थ ID, सस्ती दवाएं, ब्लड बैंक, टेलीमेडिसिन और मां-बच्चे की स्वास्थ्य योजनाएं। हर गाइड में पात्रता और official लिंक है।"
  listTitle="स्वास्थ्य योजनाएं और सेवाएं"
  extra={[
    { title: "मदद के लिए", cards: [
      { href: "/near-me/", emoji: "📍", title: "Near Me", text: "नज़दीकी CSC और जन औषधि केंद्र" },
      { href: "/tools/medicine-price-checker.html", emoji: "💊", title: "दवा की कीमत जांचें", text: "दवा का दाम और सस्ता विकल्प" },
      { href: "/service/senior-citizen-card.html", emoji: "👴", title: "सीनियर सिटीजन कार्ड", text: "पेंशन और 70+ आयुष्मान" },
    ] },
  ]}
  tips={[
    "इलाज से पहले अस्पताल से पूछें कि वह योजना में सूचीबद्ध (empanelled) है या नहीं।",
    "आयुष्मान कार्ड के लिए आधार और राशन कार्ड/परिवार पहचान साथ रखें।",
    "इमरजेंसी में 108 या 112 पर कॉल करें।",
  ]}
  faq={faq}
/>

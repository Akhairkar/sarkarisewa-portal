---
// Site FAQ: what the site is and is not, free vs paid, accuracy, reporting
// mistakes. Answers must be plain text (they feed FAQPage schema).
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Faq from "../components/Faq.astro";

const crumbs = [{ label: "होम", href: "/" }, { label: "FAQ" }];
const general = [
  { q: "क्या SarkariSewa India सरकारी वेबसाइट है?", a: "नहीं। यह एक निजी, स्वतंत्र जानकारी वेबसाइट है। हम भारत सरकार या किसी राज्य सरकार से जुड़े नहीं हैं और कोई सरकारी प्रमाण पत्र जारी नहीं करते।" },
  { q: "क्या यह वेबसाइट फ्री है?", a: "हां। सभी गाइड, CSC लोकेटर और ज़्यादातर टूल फ्री हैं। दो रिपोर्ट सेवाएं पेड हैं: GSTIN Verification और RC e-Challan रिपोर्ट, दोनों ₹20। कीमत भुगतान से पहले दिखती है और यह सरकारी फीस नहीं है।" },
  { q: "क्या मैं यहां सरकारी आवेदन कर सकता हूं?", a: "नहीं। हम आवेदन या दस्तावेज़ नहीं लेते। हर गाइड में official वेबसाइट का लिंक है जहां आवेदन होता है। खुद न कर सकें तो नज़दीकी CSC (जन सेवा केंद्र) पर जाएं।" },
  { q: "अपने पास का CSC कैसे खोजें?", a: "हर गाइड में नीचे अपने राज्य और ज़िले के CSC की सूची का लिंक है, या टूल सेक्शन में CSC लोकेटर खोलकर PIN कोड से खोजें। CSC अपनी सेवा का शुल्क खुद बताता है; सरकारी फीस अलग होती है।" },
  { q: "यहां की जानकारी कितनी सही है?", a: "हम official वेबसाइट और सरकारी आदेशों से जानकारी लेते हैं और नई गाइड पर जांच की तारीख लिखते हैं। फीस, फॉर्म और पोर्टल बदल सकते हैं, इसलिए आवेदन से पहले official वेबसाइट पर एक बार पुष्टि करें।" },
];
const help = [
  { q: "मेरी ज़रूरत की सेवा नहीं मिली, क्या करूं?", a: "वेबसाइट के सर्च पेज से खोजें या राज्य अनुसार पेज देखें। फिर भी न मिले तो sarkarisewaindia@gmail.com पर लिखें, हम उस विषय की गाइड जोड़ने की कोशिश करेंगे।" },
  { q: "गलत जानकारी या टूटा लिंक कैसे बताएं?", a: "पेज का लिंक और क्या गलत है, यह sarkarisewaindia@gmail.com पर भेजें। हम जांच करके ठीक करते हैं।" },
  { q: "कुछ सेवाओं के लिए राज्य का पोर्टल क्यों बताया जाता है?", a: "जन्म-मृत्यु, जाति, आय, निवास प्रमाण पत्र और राशन कार्ड जैसे काम राज्य सरकार या नगर निकाय करते हैं, इसलिए हर राज्य का पोर्टल अलग होता है। अपने राज्य का पेज राज्य अनुसार सेवाएं वाले पेज पर देखें।" },
  { q: "पेड रिपोर्ट का पैसा कटा पर रिपोर्ट नहीं मिली तो?", a: "RC e-Challan रिपोर्ट न बने तो पैसा अपने आप लौटता है। GSTIN रिपोर्ट के लिए भुगतान ID के साथ 7 दिन के अंदर ईमेल करें। पूरी जानकारी रिफंड नीति पेज पर है।" },
  { q: "क्या कोई मोबाइल ऐप है?", a: "अभी कोई ऐप नहीं है। वेबसाइट फोन के ब्राउज़र में अच्छी तरह चलती है। चाहें तो ब्राउज़र मेनू से इसे होम स्क्रीन पर जोड़ सकते हैं।" },
  { q: "नई भर्ती और योजना की खबर कैसे मिले?", a: "हमारे Telegram चैनल (t.me/sarkarisewaindia) या WhatsApp चैनल से जुड़ें। लिंक हर पेज के नीचे दिए हैं।" },
];
const all = [...general, ...help];
---
<Base
  title="Frequently Asked Questions | SarkariSewa India"
  description="SarkariSewa India के बारे में आम सवाल: क्या यह सरकारी वेबसाइट है, क्या फ्री है, आवेदन कहां होता है, CSC मदद, पेड रिपोर्ट और गलती कैसे बताएं।"
  breadcrumbs={crumbs}
  faq={all}
  schemaType="WebPage"
  modified="2026-10-25"
>
  <Breadcrumbs items={crumbs} />
  <article class="page">
    <div>
      <h1>अक्सर पूछे जाने वाले सवाल (FAQ)</h1>
      <p class="page-intro">SarkariSewa India के बारे में सबसे ज़्यादा पूछे जाने वाले सवालों के छोटे जवाब। किसी खास दस्तावेज़ या योजना के सवाल उसकी गाइड में नीचे दिए हैं।</p>
      <Faq items={general} title="वेबसाइट के बारे में" id="website" />
      <Faq items={help} title="मदद और सुधार" id="madad" />
      <section class="section">
        <h2>और सवाल?</h2>
        <p><a href="/contact.html">संपर्क पेज</a> देखें या <a href="mailto:sarkarisewaindia@gmail.com">sarkarisewaindia@gmail.com</a> पर लिखें। ये पेज भी काम के हैं: <a href="/about.html">हमारे बारे में</a> · <a href="/support/index.html">Support</a> · <a href="/refund-policy.html">रिफंड नीति</a> · <a href="/disclaimer.html">Disclaimer</a></p>
      </section>
    </div>
  </article>
</Base>

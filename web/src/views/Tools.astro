---
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import CardGrid from "../components/CardGrid.astro";
import Faq from "../components/Faq.astro";
import Explore from "../components/Explore.astro";
import { langOf, t, localize, UI } from "../i18n";
import { exists } from "../lib/repo";

const lang = langOf(Astro.url);
const L = (hi: string, en: string) => (lang === "en" ? en : hi);
const T = (href: string, emoji: string, title: string, hi: string, en: string) => ({ href, emoji, title, text: L(hi, en) });
const groups = [
  { id: "forms", title: L("फॉर्म भरने के टूल्स", "Form-filling tools"), cards: [
    T("/tools/photo-resizer.html", "🖼️", "Photo Resizer", "फोटो को फॉर्म के KB/size में", "Photo in the form's KB/size"),
    T("/tools/signature-resizer.html", "✍️", "Signature Resizer", "सिग्नेचर सही साइज़ में", "Signature in the right size"),
    T("/tools/document-compressor.html", "🗜️", "Document Compressor", "PDF/फोटो छोटा करें", "Compress PDF/photo"),
    T("/tools/self-declaration-builder.html", "📝", "Self Declaration Builder", "स्व-घोषणा पत्र तैयार करें", "Create a self-declaration"),
    T("/tools/document-checklist.html", "📋", "Document Checklist", "किस काम में कौन सा कागज़", "Which papers for which task"),
    T("/tools/typing-speed-test.html", "⌨️", "Typing Speed Test", "हिंदी/English टाइपिंग टेस्ट", "Hindi/English typing test"),
    T("/poster/", "🖼️", "WhatsApp Status पोस्टर", "रोज़ के सरकारी अपडेट, अपने नाम के साथ", "Daily govt update posters"),
    T("/embed/", "🔗", L("अपनी वेबसाइट पर टूल लगाएं", "Tools for your website"), "ब्लॉग/कोचिंग साइट पर फ्री embed", "Free embeds for blogs and coaching sites"),
  ]},
  { id: "eligibility", title: L("पात्रता और उम्र", "Eligibility and age"), cards: [
    T("/tools/age-calculator.html", "⏳", "Age Calculator", "किसी भी तारीख पर सही उम्र", "Exact age on any date"),
    T("/tools/eligibility-checker.html", "✅", "Scheme Eligibility Checker", "आप किन योजनाओं के पात्र हैं", "Schemes you may qualify for"),
    T("/tools/govt-card-clarifier.html", "💳", L("कौन सा सरकारी कार्ड?", "Which government card?"), "ABHA, आयुष्मान, e-Shram में फर्क", "ABHA vs Ayushman vs e-Shram"),
    T("/tools/status-troubleshooter.html", "🔍", "Status Troubleshooter", "आवेदन अटका है? कारण और हल", "Application stuck? Causes and fixes"),
    T("/tools/pan-aadhaar-conflict-resolver.html", "🔗", "PAN-Aadhaar Resolver", "नाम/जन्मतिथि mismatch का हल", "Fix name/DOB mismatch"),
    T("/deadline-calendar.html", "📅", "Deadline Calendar", "फॉर्म और टैक्स की आखिरी तारीखें", "Form and tax deadlines"),
  ]},
  { id: "money", title: L("पैसे और टैक्स के कैलकुलेटर", "Money and tax calculators"), cards: [
    T("/tools/income-tax-calculator.html", "🧮", "Income Tax Calculator", "नई vs पुरानी व्यवस्था", "New vs old regime"),
    T("/tools/hra-calculator.html", "🏠", "HRA Calculator", "HRA टैक्स छूट", "HRA tax exemption"),
    T("/tools/itr-penalty-calculator.html", "⚠️", "ITR Late Penalty", "देर से ITR पर जुर्माना", "Penalty for late ITR"),
    T("/tools/epf-calculator.html", "🏦", "EPF Calculator", "रिटायरमेंट पर PF", "Your PF at retirement"),
    T("/tools/gratuity-calculator.html", "🎁", "Gratuity Calculator", "ग्रेच्युटी कितनी मिलेगी", "How much gratuity you get"),
    T("/tools/savings-comparator.html", "📊", "Savings Scheme Comparator", "PPF, SSY, SCSS, FD की तुलना", "Compare PPF, SSY, SCSS, FD"),
    T("/7th-pay-commission-calculator.html", "💵", "7th Pay Calculator", "सरकारी वेतन", "Government salary"),
    T("/8th-pay-calculator.html", "🚀", "8th Pay Projection", "8वें वेतन आयोग का अनुमान", "8th Pay Commission estimate"),
    T("/nps-pension-calculator.html", "👴", "NPS Pension Calculator", "NPS से पेंशन कितनी", "Your NPS pension"),
    T("/tools/hidden-tax-calculator.html", "🧾", "Hidden Tax Calculator", "आप कितना अप्रत्यक्ष टैक्स देते हैं", "How much indirect tax you pay"),
  ]},
  { id: "health", title: L("स्वास्थ्य और आस-पास", "Health and nearby"), cards: [
    T("/tools/medicine-price-checker.html", "💊", "Medicine Price Checker", "ब्रांडेड vs जन औषधि दाम", "Branded vs Jan Aushadhi price"),
    T("/tools/csc-locator.html", "📍", "CSC Locator", "नज़दीकी जन सेवा केंद्र", "Nearest Jan Seva Kendra"),
  ]},
].map((g) => ({ ...g, cards: g.cards.filter((c) => c.href === "/poster/" || c.href === "/embed/" || exists(c.href)) }));
const total = groups.reduce((n, g) => n + g.cards.length, 0);

const crumbs = [{ label: t(UI.home, lang), href: localize("/", lang) }, { label: "Tools" }];
const faq = lang === "en" ? [
  { q: "Are these tools free?", a: "Yes, all tools are completely free and need no login." },
  { q: "Is it safe to use my photo or document?", a: "Photo Resizer, Signature Resizer and Document Compressor change your file inside your own browser. The file is not uploaded to our server." },
  { q: "How accurate are the calculators?", a: "Calculators give estimates based on current rules. Confirm with the official portal or an expert before big tax or pension decisions." },
] : [
  { q: "क्या ये टूल्स फ्री हैं?", a: "हां, सभी टूल्स पूरी तरह फ्री हैं और इनके लिए लॉगिन की ज़रूरत नहीं है।" },
  { q: "फोटो या दस्तावेज़ अपलोड करना सुरक्षित है?", a: "Photo Resizer, Signature Resizer और Document Compressor आपकी फाइल को आपके फोन/कंप्यूटर के ब्राउज़र में ही बदलते हैं। फाइल हमारे सर्वर पर अपलोड नहीं होती।" },
  { q: "कैलकुलेटर का जवाब कितना सही है?", a: "कैलकुलेटर मौजूदा नियमों पर आधारित अनुमान देते हैं। टैक्स या पेंशन जैसे बड़े फैसलों से पहले official पोर्टल या विशेषज्ञ से पुष्टि करें।" },
];
---
<Base
  title={L("फ्री सरकारी काम के Tools: Photo Resizer, Age, Tax Calculator | SarkariSewa India", "Free Tools: Photo Resizer, Age & Tax Calculators | SarkariSewa India")}
  description={L(
    "फॉर्म के लिए Photo/Signature Resizer, PDF Compressor, Age Calculator, Income Tax, EPF, Gratuity, 7th Pay Calculator और Scheme Eligibility Checker, सब फ्री।",
    "Photo/Signature Resizer and PDF Compressor for forms, Age Calculator, Income Tax, EPF, Gratuity and 7th Pay calculators, and a Scheme Eligibility Checker. All free."
  )}
  breadcrumbs={crumbs}
  faq={faq}
  schemaType="WebPage"
>
  <Breadcrumbs items={crumbs} />
  <section class="hero">
    <h1>{L(`फ्री Tools 🛠️ (${total})`, `Free tools 🛠️ (${total})`)}</h1>
    <p class="page-intro">{L("सरकारी फॉर्म भरने, उम्र और पात्रता जांचने, और टैक्स-पेंशन का हिसाब लगाने के फ्री टूल्स। कोई लॉगिन नहीं।", "Free tools to fill government forms, check age and eligibility, and work out tax and pension. No login.")}</p>
    <ul class="chips">{groups.map((g) => <li><a href={`#${g.id}`}>{g.title} ({g.cards.length})</a></li>)}</ul>
  </section>
  {groups.map((g) => <CardGrid title={g.title} cards={g.cards} id={g.id} />)}
  <Faq items={faq} />
  <Explore />
</Base>

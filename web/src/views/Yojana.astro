---
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import SearchBox from "../components/SearchBox.astro";
import CardGrid from "../components/CardGrid.astro";
import Faq from "../components/Faq.astro";
import Explore from "../components/Explore.astro";
import { STATES } from "../data/site";
import { STATE_SCHEMES } from "../data/schemes";
import { langOf, t, localize, UI } from "../i18n";
import { services, exists } from "../lib/repo";

const lang = langOf(Astro.url);
const L = (hi: string, en: string) => (lang === "en" ? en : hi);
const short = (s: string) => (s.length > 90 ? s.slice(0, 88) + "…" : s);
const toCard = (emoji: string) => (s: ReturnType<typeof services>[number]) => ({ href: s.href, emoji, title: t(s.title, lang), text: short(t(s.text, lang)) });
const central = services(["government-schemes"]).map(toCard("🏛️"));
const health = services(["health"]).map(toCard("🏥"));
const mpbcdc = services(["mpbcdc-schemes"]).map(toCard("🏦"));


const stateName = (slug: string) => { const s = STATES.find((x) => x.slug === slug); return s ? (lang === "en" ? s.name : s.hi) : slug; };
const stateSchemes = STATE_SCHEMES.filter(([, slug]) => exists(`service/${slug}.html`)).map(([st, slug, emoji, hi, en]) => ({
  href: `/service/${slug}.html`, emoji, title: L(hi, en), text: stateName(st),
}));

const crumbs = [{ label: t(UI.home, lang), href: localize("/", lang) }, { label: L("सरकारी योजनाएं", "Government schemes") }];
const faq = lang === "en" ? [
  { q: "How do I find which government scheme is for me?", a: "Enter your age, state, income and category in the Eligibility Checker to see the schemes you may qualify for. Then apply through the official link on each scheme's page." },
  { q: "What if the scheme money has not reached my account?", a: "First check with your bank that the account is linked to Aadhaar (DBT/NPCI mapping) and KYC is complete. Then check the application status on the scheme's official portal." },
  { q: "Do I have to pay anyone to get a scheme?", a: "Applying for government schemes is usually free. A CSC operator may charge a fixed service fee. Beware of people asking for money in the name of a scheme." },
] : [
  { q: "मेरे लिए कौन सी सरकारी योजना है, कैसे पता करें?", a: "Eligibility Checker में अपनी उम्र, राज्य, आय और श्रेणी डालें, वह बताएगा कि आप किन योजनाओं के लिए पात्र हो सकते हैं। फिर हर योजना के पेज पर official link से आवेदन करें।" },
  { q: "योजना का पैसा खाते में नहीं आया तो क्या करें?", a: "सबसे पहले बैंक में जांचें कि खाता आधार से लिंक (DBT/NPCI mapping) है और KYC पूरी है। फिर योजना के official पोर्टल पर आवेदन का स्टेटस देखें।" },
  { q: "क्या योजना के लिए किसी को पैसे देने होते हैं?", a: "सरकारी योजनाओं में आवेदन आमतौर पर मुफ्त होता है। CSC पर ऑपरेटर तय सेवा शुल्क ले सकता है। योजना के नाम पर पैसे मांगने वालों से सावधान रहें।" },
];
---
<Base
  title={L("सरकारी योजनाएं 2026: केंद्र और राज्य की योजनाओं की लिस्ट | SarkariSewa India", "Government Schemes 2026: Central & State Scheme List | SarkariSewa India")}
  description={L(
    "PM Kisan, आयुष्मान, आवास, उज्ज्वला से लेकर लाडकी बहिन, मैया सम्मान जैसी राज्य योजनाएं: पात्रता, आवेदन और स्टेटस की गाइड official links के साथ।",
    "From PM Kisan, Ayushman, Awas and Ujjwala to state schemes like Ladki Bahin and Maiya Samman: eligibility, how to apply and status, with official links."
  )}
  breadcrumbs={crumbs}
  faq={faq}
  schemaType="WebPage"
>
  <Breadcrumbs items={crumbs} />
  <section class="hero">
    <h1>{L("सरकारी योजनाएं", "Government schemes")}</h1>
    <p class="page-intro">{L("केंद्र और राज्य सरकार की योजनाएं: कौन पात्र है, कितना फायदा है, आवेदन कैसे करें और पैसा न आए तो क्या करें।", "Central and state schemes: who qualifies, how much you get, how to apply and what to do if money doesn't arrive.")}</p>
    <SearchBox placeholder={L("जैसे: PM Kisan, लाडकी बहिन, आवास योजना…", "e.g. PM Kisan, Ladki Bahin, housing scheme…")} />
    <p><a class="cta" style="display:inline-block" href="/tools/eligibility-checker.html">✅ {L("मैं किन योजनाओं के लिए पात्र हूं?", "Which schemes am I eligible for?")}</a></p>
  </section>
  <CardGrid title={L("केंद्र सरकार की योजनाएं", "Central government schemes")} cards={central} id="central" />
  <CardGrid title={L("राज्य सरकार की योजनाएं", "State government schemes")} cards={stateSchemes} id="state" />
  <CardGrid title={L("स्वास्थ्य योजनाएं और सेवाएं", "Health schemes and services")} cards={health} id="health" />
  {mpbcdc.length > 0 && <CardGrid title={L("महाराष्ट्र: MPBCDC लोन योजनाएं", "Maharashtra: MPBCDC loan schemes")} cards={mpbcdc} id="mpbcdc" />}
  <Faq items={faq} />
  <Explore />
</Base>

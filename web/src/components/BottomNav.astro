---
import Icon from "./Icon.astro";
import { NAV } from "../data/site";
import { langOf, t, localize, UI } from "../i18n";
const lang = langOf(Astro.url);
const path = Astro.url.pathname;
---
<nav class="bottom-nav" aria-label={t(UI.mobileMenu, lang)}>
  {NAV.map((l) => { const href = localize(l.href, lang); return (
    <a href={href} aria-current={path === href ? "page" : undefined}><Icon name={l.icon} />{t(l.label, lang)}</a>
  ); })}
</nav>

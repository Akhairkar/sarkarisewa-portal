---
// Small "go to a CSC" strip under the quick answer on guides: links to the
// state's CSC list and the location-based locator. (The phone-number request
// form that used to be here was removed in Oct 2026: it took a lot of space
// and the requests could not be served.)
interface Props { state?: { slug: string; hi: string }; doc?: string; href?: string }
const { state, doc, href } = Astro.props;
const list = href || (state ? `/service/csc-locator/${state.slug}.html` : "/tools/csc-locator.html");
---
<p class="csc-strip">
  🏪 {doc ? `${doc} ` : ""}फॉर्म खुद न भर पाएं तो नज़दीकी CSC (जन सेवा केंद्र) पर भरवाएं:
  <a href={list} data-csc-help="list">{state ? `${state.hi} के CSC सेंटर` : "CSC सेंटर देखें"}</a>
  {state && <> · <a href="/tools/csc-locator.html" data-csc-help="near">अपने पास का CSC</a></>}
</p>
<script is:inline>
  document.querySelectorAll("[data-csc-help]").forEach(function (a) {
    a.addEventListener("click", function () {
      try { if (window.gtag) gtag("event", "csc_help_click", { kind: a.dataset.cscHelp, page: location.pathname }); } catch (e) {}
    });
  });
</script>
<style is:global>
  .csc-strip { margin: 0 0 16px; padding: 10px 12px; border: 1px solid var(--c-line); border-radius: var(--radius-sm, 8px); font-size: .92rem; line-height: 1.5; }
  .csc-strip a { font-weight: 700; }
</style>

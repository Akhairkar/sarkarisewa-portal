---
// "Can't apply online yourself? Get it done at a CSC" box, shown right under
// the quick answer on state guides. Most readers of the senior citizen,
// labour and ration card pages are elderly people, workers and families who
// often cannot fill the online form themselves; this points them to the
// state's CSC list and the location-based locator.
import { SUPABASE_URL, SUPABASE_ANON_KEY } from "../lib/supabase-public";
interface Props { state?: { slug: string; hi: string }; doc?: string; href?: string }
const { state, doc, href } = Astro.props;
const list = href || (state ? `/service/csc-locator/${state.slug}.html` : "/tools/csc-locator.html");
// Version of the consent notice shown next to the send button; stored with
// each request (v2: pressing the button is the consent, no checkbox).
const CONSENT_V = "v2-2026-10";
---
<section class="csc-help" aria-labelledby="csc-help-title">
  <p class="csc-help-title" id="csc-help-title">🏪 खुद ऑनलाइन फॉर्म नहीं भर पा रहे?</p>
  <p>{doc ? `${doc} का` : "यह"} फॉर्म नज़दीकी <strong>CSC (जन सेवा केंद्र)</strong> पर भरवा सकते हैं। ऑपरेटर ऑनलाइन आवेदन करके रसीद दे देता है।</p>
  <ul>
    <li>आधार कार्ड, आधार से जुड़ा मोबाइल (OTP के लिए) और इस पेज पर बताए कागज़ साथ ले जाएं।</li>
    <li>पहले पूछें: सरकारी फीस कितनी है और CSC का सेवा शुल्क कितना। हर भुगतान की रसीद लें।</li>
  </ul>
  <div class="csc-help-cta">
    <a class="cta" href={list} data-csc-help="list">📍 {state ? `${state.hi} के` : "नज़दीकी"} CSC सेंटर देखें</a>
    {state && <a class="cta secondary" href="/tools/csc-locator.html" data-csc-help="near">अपने पास का CSC खोजें</a>}
  </div>

  <div class="svc-ask" data-url={SUPABASE_URL} data-key={SUPABASE_ANON_KEY} data-state={state?.hi ?? ""} data-service={doc ?? ""} data-consent={CONSENT_V}>
    <p class="svc-q"><strong>क्या आप यह काम घर बैठे किसी सत्यापित CSC संचालक से करवाना चाहेंगे?</strong> <small>(उनका सेवा शुल्क लगेगा, सरकारी फीस अलग)</small></p>
    <div class="svc-choice">
      <button type="button" class="cta" data-choice="yes">हाँ, मुझे चाहिए</button>
      <button type="button" class="svc-no" data-choice="no">नहीं, खुद कर लूंगा</button>
    </div>
    <form class="svc-form" hidden>
      <label>आपका मोबाइल नंबर <small>(WhatsApp हो तो बेहतर)</small><input name="phone" type="tel" required inputmode="numeric" pattern="[6-9][0-9]{9}" maxlength="10" placeholder="10 अंक का नंबर" autocomplete="tel-national" /></label>
      <details class="svc-more">
        <summary>नाम, ज़िला और काम भी लिखें <small>(वैकल्पिक)</small></summary>
        <label>आपका नाम<input name="name" maxlength="60" autocomplete="name" /></label>
        <label>आपका ज़िला<input name="district" maxlength="60" /></label>
        <label>कौन सा काम करवाना है?<textarea name="details" rows="2" maxlength="400" placeholder={doc ? `जैसे: ${doc} नया बनवाना है, या स्टेटस देखना है` : "जैसे: नया आवेदन, सुधार, स्टेटस"}></textarea></label>
      </details>
      <button type="submit" class="cta">📞 मुझे कॉल/WhatsApp करें</button>
      <p class="svc-note">बटन दबाकर आप सहमत हैं कि हम यह नंबर सिर्फ इस काम के लिए एक सत्यापित CSC संचालक को दे सकते हैं और आपसे संपर्क कर सकते हैं। 6 महीने बाद नंबर हटा दिया जाता है। <a href="/privacy-policy.html" target="_blank">गोपनीयता नीति</a>. SarkariSewa India निजी सेवा है, सरकारी नहीं। किसी को OTP न बताएं।</p>
    </form>
    <p class="svc-msg" role="status"></p>
  </div>
</section>
<script is:inline>
  (function () {
    var box = document.querySelector(".svc-ask");
    if (!box) return;
    var U = box.dataset.url, K = box.dataset.key, form = box.querySelector(".svc-form"), msg = box.querySelector(".svc-msg");
    function rpc(fn, body) {
      return fetch(U + "/rest/v1/rpc/" + fn, { method: "POST", keepalive: true, headers: { apikey: K, Authorization: "Bearer " + K, "Content-Type": "application/json" }, body: JSON.stringify(body) });
    }
    var key = "ss_svc_" + location.pathname;
    function seen() { try { return localStorage.getItem(key); } catch (e) { return null; } }
    function mark(v) { try { localStorage.setItem(key, v); } catch (e) {} }
    if (seen() === "sent") { box.querySelector(".svc-choice").hidden = true; msg.textContent = "✅ आपका अनुरोध हमें मिल चुका है।"; }
    box.querySelectorAll("[data-choice]").forEach(function (b) {
      b.addEventListener("click", function () {
        var c = b.dataset.choice;
        if (!seen()) { rpc("service_interest_log", { p_page: location.pathname, p_state: box.dataset.state || null, p_service: box.dataset.service || null, p_choice: c }).catch(function () {}); mark(c); }
        try { if (window.gtag) gtag("event", "csc_service_interest", { choice: c, page: location.pathname }); } catch (e) {}
        box.querySelector(".svc-choice").hidden = true;
        if (c === "yes") { form.hidden = false; form.elements.phone.focus(); }
        else msg.textContent = "ठीक है। इस पेज पर दी गई जानकारी से आप खुद आवेदन कर सकते हैं।";
      });
    });
    form.addEventListener("submit", function (e) {
      e.preventDefault();
      var f = form.elements, btn = form.querySelector("[type=submit]");
      var phone = f.phone.value.replace(/\D/g, "").slice(-10);
      if (!/^[6-9]\d{9}$/.test(phone)) { msg.textContent = "कृपया सही 10 अंकों का मोबाइल नंबर लिखें।"; f.phone.focus(); return; }
      btn.disabled = true; msg.textContent = "भेज रहे हैं…";
      rpc("service_request_submit", { p_page: location.pathname, p_state: box.dataset.state || null, p_district: f.district.value, p_service: box.dataset.service || null, p_details: f.details.value, p_name: f.name.value, p_phone: phone, p_consent: true, p_consent_version: box.dataset.consent })
        .then(function (r) { return r.ok ? r.json() : "error"; })
        .then(function (res) {
          if (res === "ok" || res === "dup") {
            form.hidden = true; mark("sent");
            msg.textContent = "✅ धन्यवाद! आपका अनुरोध मिल गया। आपके इलाके में सत्यापित CSC मिलने पर हम फोन/WhatsApp करेंगे।";
            try { if (window.gtag) gtag("event", "csc_service_request", { page: location.pathname }); } catch (e) {}
          } else {
            btn.disabled = false;
            msg.textContent = res === "limit" ? "इस नंबर से आज काफी अनुरोध आ चुके हैं। कल फिर कोशिश करें।" : res === "invalid" ? "कृपया सही 10 अंकों का मोबाइल नंबर लिखें।" : "अभी अनुरोध नहीं भेजा जा सका। थोड़ी देर बाद फिर कोशिश करें।";
          }
        })
        .catch(function () { btn.disabled = false; msg.textContent = "नेटवर्क की दिक्कत है। थोड़ी देर बाद फिर कोशिश करें।"; });
    });
  })();
</script>
<script is:inline>
  document.querySelectorAll("[data-csc-help]").forEach(function (a) {
    a.addEventListener("click", function () {
      try { if (window.gtag) gtag("event", "csc_help_click", { kind: a.dataset.cscHelp, page: location.pathname }); } catch (e) {}
    });
  });
</script>

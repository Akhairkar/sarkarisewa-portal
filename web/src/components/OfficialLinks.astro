---
import Icon from "./Icon.astro";
interface Props { links: { href: string; title: string; note?: string }[]; verified: string; id?: string }
const { links, verified, id = "official-links" } = Astro.props;
---
<section class="section" id={id}>
  <h2>Official links</h2>
  <p style="color:var(--c-muted);font-size:.92rem">ये सरकारी वेबसाइट/नंबर हैं। आवेदन और भुगतान सिर्फ इन्हीं पर करें। <span style="color:var(--c-green);font-weight:700">आखिरी जांच: {verified}</span></p>
  <ul class="official">
    {links.map((l) => (
      <li>
        <a href={l.href} target="_blank" rel="noopener nofollow">
          <span class="ico"><Icon name={l.href.startsWith("tel:") ? "phone" : "shield"} size={20} /></span>
          <span><strong>{l.title}</strong><small>{l.note ?? l.href.replace(/^https?:\/\//, "").replace(/^tel:/, "")}</small></span>
          <span class="ext"><Icon name="link" size={18} /></span>
        </a>
      </li>
    ))}
  </ul>
</section>

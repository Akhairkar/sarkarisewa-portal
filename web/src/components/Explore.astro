---
// "Ye bhi dekhein": attention cards shown on every page so visitors explore the
// site, even when the cards are unrelated to the current topic.
import CardGrid from "./CardGrid.astro";
import { EXPLORE } from "../data/site";
interface Props { exclude?: string[]; count?: number }
const { exclude = [], count = 6 } = Astro.props;
const here = Astro.url.pathname;
const cards = EXPLORE.filter((c) => c.href !== here && !exclude.includes(c.href)).slice(0, count);
---
<CardGrid title="ये भी देखें 👀" lead="लोग इन्हें सबसे ज़्यादा इस्तेमाल कर रहे हैं" cards={cards} variant="explore" id="explore" />

---
// "नई सरकारी भर्तियां" on the homepage: the 8 newest job pages on our site
// whose application is still open (src/data/jobs.ts + jobs-daily/), newest
// first by the guide's `published` date. NEW = added in the last 7 days;
// a red tag when 3 days or fewer are left. Rebuilt with the site (every
// 2 hours), so finished jobs drop off on their own.
import { OPEN_JOBS } from "../lib/open-jobs";

const fmt = (d: string) => new Date(d + "T00:00:00").toLocaleDateString("hi-IN", { day: "numeric", month: "short" });
const jobs = OPEN_JOBS.slice(0, 8);
---
{jobs.length > 0 && (
  <section class="block nj" aria-labelledby="new-jobs">
    <div class="block-head"><h2 id="new-jobs">🔔 नई सरकारी भर्तियां</h2><a href="/jobs/index.html">सभी नौकरियां ›</a></div>
    <ul class="nj-grid">
      {jobs.map((j) => (
        <li>
          <a class="nj-card" href={j.href}>
            <span class="nj-tags">
              {j.isNew && <span class="nj-new">NEW</span>}
              {j.left <= 3 && <span class="nj-hot">⏳ {j.left === 0 ? "आज आखिरी दिन" : `${j.left} दिन बाकी`}</span>}
            </span>
            <strong>{j.name}</strong>
            {j.sub && <small>{j.sub}</small>}
            <span class="nj-last">आखिरी तारीख: {fmt(j.last)}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="nj-more"><a href="/jobs/qualification-wise-govt-jobs.html">🎓 10वीं / 12वीं / ग्रेजुएट: अपनी योग्यता से नौकरी खोजें ›</a></p>
  </section>
)}

<style is:global>
  .nj-grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 900px) { .nj-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .nj-card { display: flex; flex-direction: column; gap: 4px; height: 100%; box-sizing: border-box; padding: 10px 12px; border: 1px solid var(--c-line); border-radius: var(--radius-sm, 10px); background: var(--c-surface); color: inherit; text-decoration: none; }
  .nj-card:hover { border-color: var(--c-primary, #1d4ed8); }
  .nj-card strong { font-size: .95rem; line-height: 1.3; }
  .nj-card small { color: var(--c-muted); font-size: .8rem; line-height: 1.3; }
  .nj-last { margin-top: auto; font-size: .8rem; font-weight: 700; color: var(--c-green, #15803d); }
  .nj-tags { display: flex; flex-wrap: wrap; gap: 4px; min-height: 0; }
  .nj-tags:empty { display: none; }
  .nj-new, .nj-hot { font-size: .68rem; font-weight: 800; padding: 2px 7px; border-radius: 999px; letter-spacing: .02em; }
  .nj-new { background: #f59e0b; color: #111; }
  .nj-hot { background: #dc2626; color: #fff; }
  .nj-more { margin: 10px 0 0; font-size: .92rem; }
</style>

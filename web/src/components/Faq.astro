---
// FAQ list. The same items feed FAQPage schema in the layout, so answers here
// must be plain text (no HTML).
import { langOf, t, UI } from "../i18n";
interface Props { items: { q: string; a: string }[]; title?: string; id?: string }
const lang = langOf(Astro.url);
const { items, title = t(UI.faq, lang), id = "faq" } = Astro.props;
---
<section class="section faq" id={id}>
  <h2>{title}</h2>
  {items.map((f, i) => (
    <details open={i === 0}>
      <summary>{f.q}</summary>
      <div><p>{f.a}</p></div>
    </details>
  ))}
</section>

---
import { FOOTER, WHATSAPP_CHANNEL, TELEGRAM_CHANNEL } from "../data/site";
import { langOf, t, localize, UI } from "../i18n";
const lang = langOf(Astro.url);
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-about">
        <a class="brand" href={lang === "en" ? "/en/" : "/"}>
          <img src="/assets/img/sarkarisewa-mark.svg" alt="" width="34" height="34" />
          <span class="brand-name">Sarkari<b>Sewa</b> India</span>
        </a>
        <p style="margin-top:10px;color:var(--c-muted)">{t(UI.footerAbout, lang)}</p>
        <p class="footer-join-title">{lang === "en" ? "Free updates:" : "फ्री अपडेट पाएं:"}</p>
        <div class="footer-join">
          <a class="fj-wa" href={WHATSAPP_CHANNEL} target="_blank" rel="noopener" data-join="whatsapp">WhatsApp {lang === "en" ? "channel" : "चैनल"}</a>
          <a class="fj-tg" href={TELEGRAM_CHANNEL} target="_blank" rel="noopener" data-join="telegram">Telegram {lang === "en" ? "channel" : "चैनल"}</a>
        </div>
      </div>
      {FOOTER.map((col) => (
        <div>
          <h3>{t(col.title, lang)}</h3>
          <ul>{col.links.map((l) => <li><a href={localize(l.href, lang)}>{t(l.label, lang)}</a></li>)}</ul>
        </div>
      ))}
    </div>
    <p class="footer-note">{t(UI.footerNote, lang)} © {year} SarkariSewa India</p>
  </div>
</footer>

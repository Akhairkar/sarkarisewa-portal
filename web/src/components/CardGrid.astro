---
import type { Card } from "../data/site";
import { langOf, t, localize } from "../i18n";
interface Props { title: string; lead?: string; cards: Card[]; variant?: "plain" | "explore"; id?: string; more?: { href: string; label: string } }
const { title, lead, cards, variant = "plain", id, more } = Astro.props;
const lang = langOf(Astro.url);
---
<section class={`section ${variant === "explore" ? "explore" : ""}`} id={id}>
  {more
    ? <div class="block-head"><h2>{title}</h2><a href={localize(more.href, lang)}>{more.label}</a></div>
    : <h2>{title}</h2>}
  {lead && <p class="lead">{lead}</p>}
  <div class="card-grid">
    {cards.map((c) => (
      <a class="card" href={localize(c.href, lang)}>
        {c.badge && <span class="badge">{c.badge}</span>}
        <span class="emoji" aria-hidden="true">{c.emoji}</span>
        <strong>{t(c.title, lang)}</strong>
        <small>{t(c.text, lang)}</small>
      </a>
    ))}
  </div>
</section>

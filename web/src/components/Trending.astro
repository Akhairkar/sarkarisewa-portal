---
// Bright tiles of what people search most, right under the hero.
import { TRENDING } from "../data/site";
import { langOf, t, localize } from "../i18n";
import { exists } from "../lib/repo";
const lang = langOf(Astro.url);
const items = TRENDING.filter((i) => i.href.includes("#") || i.href.endsWith("/") || exists(i.href));
---
<section class="trending" aria-label={lang === "en" ? "Trending" : "ट्रेंडिंग"}>
  <p class="trending-title">🔥 {lang === "en" ? "Trending now" : "अभी ट्रेंडिंग"}</p>
  <div class="trend-grid">
    {items.map((i) => <a class={`trend ${i.tone}`} href={localize(i.href, lang)}>{t(i.label, lang)}</a>)}
  </div>
</section>

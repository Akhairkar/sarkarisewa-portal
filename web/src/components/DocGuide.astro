---
// One template for state guides made of sections (employment exchange,
// ration card, certificates, new state services).
import Base from "../layouts/Base.astro";
import Breadcrumbs from "./Breadcrumbs.astro";
import OfficialLinks from "./OfficialLinks.astro";
import Faq from "./Faq.astro";
import CardGrid from "./CardGrid.astro";
import StateGrid from "./StateGrid.astro";
import Explore from "./Explore.astro";
import PromoBox from "./PromoBox.astro";
import PaidTools from "./PaidTools.astro";
import CscHelp from "./CscHelp.astro";
import { TELEGRAM_CHANNEL, WHATSAPP_CHANNEL } from "../data/site";
import DemandBox from "./DemandBox.astro";
import JobStrip from "./JobStrip.astro";
import type { DocGuide } from "../guides/doc/types";
import { promo as challanPromo } from "../guides/challan/common";
import { langOf } from "../i18n";

interface Props { g: DocGuide; canonical?: string }
const { g, canonical } = Astro.props;
const en = langOf(Astro.url) === "en";
const L = (hi: string, e: string) => (en ? e : hi);
const crumbs = g.crumbs ?? [
  { label: "होम", href: "/" },
  { label: "राज्य सेवाएं", href: "/states/" },
  { label: g.state!.hi, href: `/states/${g.state!.slug}.html` },
  { label: g.docHi },
];
// Driving licence readers are vehicle owners: show the RC e-challan report
// box unless the guide sets its own.
const promo = g.promo ?? (g.doc === "driving-licence" ? challanPromo : undefined);
---
<Base title={g.title} description={g.description} breadcrumbs={crumbs} faq={g.faq} published={g.published} modified={g.modified} canonical={canonical}>
  <Breadcrumbs items={crumbs} />
  <div class="page has-aside">
    <article>
      <h1>{g.h1}</h1>
      <div class="meta-row"><span class="verified">✓ {L("जानकारी जांची गई", "Information checked")}: {g.verified}</span></div>

      <section class="answer" aria-labelledby="answer-title">
        <p class="answer-title" id="answer-title">{L("सीधा जवाब", "Quick answer")}</p>
        <p class="answer-lead" set:html={g.lead} />
        <dl class="facts">{g.facts.map(([k, v]) => <div><dt>{k}</dt><dd set:html={v} /></div>)}</dl>
      </section>
      {Astro.url.pathname.startsWith("/jobs/") ? (
        <p class="tg-join">🔔 <strong>नई भर्तियां और आखिरी तारीख की याद</strong> सबसे पहले पाएं: <a href={TELEGRAM_CHANNEL} target="_blank" rel="noopener" data-act="tg-join">Telegram चैनल जॉइन करें</a> · <a href={WHATSAPP_CHANNEL} target="_blank" rel="noopener" data-act="wa-join">WhatsApp चैनल</a></p>
      ) : g.demand ? <DemandBox {...g.demand} state={g.state?.hi} /> : <CscHelp state={g.state} doc={g.docHi} href={g.cscHref} />}

      {g.notice && <div class="callout warn"><p set:html={g.notice} /></div>}
      {promo && <PromoBox p={promo} />}

      {g.sections.map((s, i) => (
        <>
          <section class="section" id={s.id}>
            <h2>{s.title}</h2>
            {s.intro && <p set:html={s.intro} />}
            {s.steps && <ol class="steps">{s.steps.map((x) => <li set:html={x} />)}</ol>}
            {s.list && <ul class="checklist">{s.list.map((x) => <li set:html={x} />)}</ul>}
            {s.table && (
              <div class="table-wrap">
                <table>
                  <thead><tr>{s.table.head.map((h) => <th>{h}</th>)}</tr></thead>
                  <tbody>{s.table.rows.map((r) => <tr>{r.map((c) => <td set:html={c} />)}</tr>)}</tbody>
                </table>
              </div>
            )}
            {s.callout && <div class={`callout ${s.callout.kind}`}><p set:html={s.callout.html} /></div>}
            {s.html && <Fragment set:html={s.html} />}
          </section>
          {i === 2 && <div class="ad-slot" aria-hidden="true"></div>}
        </>
      ))}

      <OfficialLinks verified={g.verified} links={g.official} />
      <PaidTools exclude={promo ? [promo.href] : []} />
      {promo && <PromoBox p={promo} compact />}
      {!en && !Astro.url.pathname.startsWith("/jobs/") && <JobStrip state={g.state?.slug} />}
      <Faq items={g.faq} />
      <CardGrid title={L("इनसे जुड़ी जानकारी", "Related guides")} cards={g.related} id="related" />
      {g.doc && <StateGrid doc={g.doc} current={g.state?.slug} title={g.otherStatesTitle ?? `दूसरे राज्यों में ${g.docHi}`} />}
      <Explore />
    </article>

    <aside class="page-aside">
      <section class="section toc">
        <h2 style="font-size:1rem">{L("इस पेज पर", "On this page")}</h2>
        <ol>
          {g.sections.map((s) => <li><a href={`#${s.id}`}>{s.title}</a></li>)}
          <li><a href="#faq">{L("सवाल-जवाब", "FAQ")}</a></li>
        </ol>
        {g.aside.map((a, i) => <a class={`cta${i ? " secondary" : ""}`} href={a.href}>{a.label}</a>)}
      </section>
    </aside>
  </div>
</Base>

<style is:global>
  .tg-join { margin: 0 0 16px; padding: 10px 12px; border: 1px solid #93c5fd; background: rgba(37, 99, 235, .06); border-radius: var(--radius-sm, 8px); font-size: .93rem; line-height: 1.5; }
  .tg-join a { font-weight: 700; }
</style>
